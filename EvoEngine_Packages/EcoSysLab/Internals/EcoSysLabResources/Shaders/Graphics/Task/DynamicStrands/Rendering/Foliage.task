#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable

#define DYNAMIC_STRANDS_SET 1
#include "DynamicStrands.glsl"
#include "DynamicStrandsFoliageRenderingConstants.glsl"
#include "Math.glsl"

const uint WORKGROUP_SIZE = EXT_TASK_SUBGROUP_COUNT * SUBGROUP_SIZE;

const uint ITERATIONS_PER_TASK = ((EXT_TASK_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

uint baseID = gl_WorkGroupID.x * EXT_TASK_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

layout(local_size_x = WORKGROUP_SIZE) in;

struct Task {
  uint baseID;
  uint8_t deltaIDs[EXT_TASK_WORK_GROUP_INVOCATIONS];
};

taskPayloadSharedEXT Task ts_out;

#if EXT_TASK_SUBGROUP_COUNT > 1
shared uint s_out_foliage_count;
#endif

#define BARRIER()        \
  memoryBarrierShared(); \
  barrier();

void main() {
#if EXT_TASK_SUBGROUP_COUNT > 1
  if (laneID == 0) {
    s_out_foliage_count = 0;
  }
  BARRIER();
#endif
  uint out_foliage_count = 0;
  for (uint i = 0; i < ITERATIONS_PER_TASK; i++) {
    uint leaf_index_local = laneID + i * WORKGROUP_SIZE;
    uint leaf_index_global = baseID + leaf_index_local;

    bool render = !(leaf_index_global > foliage_size - 1);

    uvec4 vote_foliage = subgroupBallot(render);
    uint num_foliage = subgroupBallotBitCount(vote_foliage);

#if EXT_TASK_SUBGROUP_COUNT > 1
    if (gl_SubgroupInvocationID == 0) {
      out_foliage_count = atomicAdd(s_out_foliage_count, num_foliage);
    }
    out_foliage_count = subgroupBroadcastFirst(out_foliage_count);
#endif
    uint idx_offset = subgroupBallotExclusiveBitCount(vote_foliage) + out_foliage_count;
    if (render) {
      ts_out.deltaIDs[idx_offset] = uint8_t(leaf_index_local);
    }
#if EXT_TASK_SUBGROUP_COUNT == 1
    out_foliage_count += num_foliage;
#endif
  }

#if EXT_TASK_SUBGROUP_COUNT > 1
  BARRIER();
  out_foliage_count = s_out_foliage_count;
#endif
  if (laneID == 0) {
    ts_out.baseID = baseID;
  }
  EmitMeshTasksEXT(out_foliage_count, 1, 1);
}