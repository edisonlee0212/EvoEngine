#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable

#define DYNAMIC_STRANDS_SET 1
#include "DynamicStrands.glsl"
#include "Math.glsl"

const uint WORKGROUP_SIZE = EXT_TASK_SUBGROUP_COUNT * SUBGROUP_SIZE;

const uint ITERATIONS_PER_TASK = ((EXT_TASK_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

uint baseID = gl_WorkGroupID.x * EXT_TASK_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

layout(local_size_x = WORKGROUP_SIZE) in;

struct Task {
  uint baseID;
  uint8_t deltaIDs[EXT_TASK_WORK_GROUP_INVOCATIONS];
};

taskPayloadSharedEXT Task ts_out;

#if EXT_TASK_SUBGROUP_COUNT > 1
shared uint s_out_segments_count;
#endif

#define BARRIER()        \
  memoryBarrierShared(); \
  barrier();

layout(push_constant) uniform STRANDS_RENDER_CONSTANTS {
  vec4 min_color;
  vec4 max_color;

  uint camera_index;
  uint segments_size;
  uint color_mode;
  float multiplier;
  float boundary_layer_radius;
};

void main() {
#if EXT_TASK_SUBGROUP_COUNT > 1
  if (laneID == 0) {
    s_out_segments_count = 0;
  }
  BARRIER();
#endif
  uint out_segments_count = 0;
  for (uint i = 0; i < ITERATIONS_PER_TASK; i++) {
    uint segment_index_local = laneID + i * WORKGROUP_SIZE;
    uint segment_index_global = baseID + segment_index_local;

    bool render = !(segment_index_global > segments_size - 1);

    uvec4 vote_segments = subgroupBallot(render);
    uint num_segments = subgroupBallotBitCount(vote_segments);

#if EXT_TASK_SUBGROUP_COUNT > 1
    if (gl_SubgroupInvocationID == 0) {
      out_segments_count = atomicAdd(s_out_segments_count, num_segments);
    }
    out_segments_count = subgroupBroadcastFirst(out_segments_count);
#endif
    uint idx_offset = subgroupBallotExclusiveBitCount(vote_segments) + out_segments_count;
    if (render) {
      ts_out.deltaIDs[idx_offset] = uint8_t(segment_index_local);
    }
#if EXT_TASK_SUBGROUP_COUNT == 1
    out_segments_count += num_segments;
#endif
  }

#if EXT_TASK_SUBGROUP_COUNT > 1
  BARRIER();
  out_segments_count = s_out_segments_count;
#endif
  if (laneID == 0) {
    ts_out.baseID = baseID;
  }
  EmitMeshTasksEXT(out_segments_count, 1, 1);
}