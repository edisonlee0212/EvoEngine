#define INFINITY uintBitsToFloat(0x7F800000)

layout(std430, set = 0, binding = 0) buffer MIN_DISTANCE_BLOCK {
  int global_min_distance;  // needs to be int for atomicMin
  uint global_index_of_min;
  int padding0;
  int padding1;
};

void main() {
  global_min_distance = floatBitsToInt(INFINITY);
  global_index_of_min = 0xFFFFFFFF;
}