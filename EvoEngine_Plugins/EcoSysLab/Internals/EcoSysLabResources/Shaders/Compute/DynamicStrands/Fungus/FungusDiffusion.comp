#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_control_flow_attributes : require
#extension GL_EXT_shader_atomic_float : require

#define DYNAMIC_STRANDS_SET 0
#include "DynamicStrands.glsl"

const uint WORKGROUP_SIZE = COMPUTE_SUBGROUP_COUNT * SUBGROUP_SIZE;
const uint ITERATIONS_PER_TASK = ((COMPUTE_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#define BARRIER() \
memoryBarrierShared(); \
barrier();

// Push constant for simulation parameters
layout(push_constant) uniform SimulationParams {
    float dt;
    float aw;
    float ab;
    float bw;
    float bb;
    float ycw;
    float ycb;
    float ylw;
    float pc;
    float pl;
    float k;
    float delta;
    float ll;
    float lc;
    uint segment_count;
    uint segment_pair_count;
    mat3 matrixAw;
    mat3 matrixAb;
    mat3 matrixAc;
} params;

uint baseID = gl_WorkGroupID.x * COMPUTE_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

void computeDiffusionWeights(vec3 source_pos, vec3 target_pos, float source_distance, float target_distance, 
                           out float dc_weight, out float dw_weight, out float db_weight) 
{
    vec3 edge_dir = source_pos - target_pos;
    float d = length(edge_dir);
    
    if (d < 0.000001) {
        dc_weight = 0.0;
        dw_weight = 0.0;
        db_weight = 0.0;
        return;
    }
    
    edge_dir /= d;

    mat3 matrixAw = params.matrixAw;
    mat3 matrixAb = params.matrixAb;
    mat3 matrixAc = params.matrixAc;
    
    // Calculate quadratic forms using matrix multiplication
    float kw = max(dot(edge_dir * matrixAw, edge_dir), 0.0);
    float kb = max(dot(edge_dir * matrixAb, edge_dir), 0.0);
    float kc = max(dot(edge_dir * matrixAc, edge_dir), 0.0);
    
    float coef = min(source_distance, target_distance);
    coef = coef * coef * coef * 64.0;
    
    dw_weight = kw / d * coef;
    db_weight = kb / d * coef;
    dc_weight = kc / d;
}

void main() {    
    // PHASE 1: Calculate diffusion contributions from segment pairs
    for (uint pair_index = int(gl_GlobalInvocationID.x); pair_index < params.segment_pair_count; pair_index += gl_NumWorkGroups.x * gl_WorkGroupSize.x) {
        SegmentPair segment_pair = segment_pairs[pair_index];
        
        // Get segment handles from the pair
        uint segment0_handle = segment_pair.segment0_handle;
        uint segment1_handle = segment_pair.segment1_handle;
        
        // Skip invalid handles
        if (segment0_handle < 0 || segment1_handle < 0) continue;
        if (segment0_handle >= int(params.segment_count) || segment1_handle >= int(params.segment_count)) continue;
        
        // Get segment positions and boundary distances
        vec3 segment0_pos = (segments[segment0_handle].particle0.x + segments[segment0_handle].particle1.x) / 2;
        vec3 segment1_pos = (segments[segment1_handle].particle0.x + segments[segment1_handle].particle1.x) / 2;
        float segment0_distance = segments[segment0_handle].boundary_distance;
        float segment1_distance = segments[segment1_handle].boundary_distance;
        
        // Calculate diffusion weights
        float dc_weight, dw_weight, db_weight;
        computeDiffusionWeights(segment0_pos, segment1_pos, segment0_distance, segment1_distance, 
                              dc_weight, dw_weight, db_weight);
        
        // Accumulate diffusion contribution from neighbors
        atomicAdd(segments[segment0_handle].diffusion_c, dc_weight * segments[segment1_handle].C_pre);
        atomicAdd(segments[segment0_handle].diffusion_w, dw_weight * segments[segment1_handle].RW_pre);
        atomicAdd(segments[segment0_handle].diffusion_b, db_weight * segments[segment1_handle].RB_pre);
        
        // Add reverse direction contributions (undirected graph)
        atomicAdd(segments[segment1_handle].diffusion_c, dc_weight * segments[segment0_handle].C_pre);
        atomicAdd(segments[segment1_handle].diffusion_w, dw_weight * segments[segment0_handle].RW_pre);
        atomicAdd(segments[segment1_handle].diffusion_b, db_weight * segments[segment0_handle].RB_pre);
        
        // Add diagonal terms (self-interactions with negative values for conservation)
        atomicAdd(segments[segment0_handle].diffusion_c, -dc_weight * segments[segment0_handle].C_pre);
        atomicAdd(segments[segment0_handle].diffusion_w, -dw_weight * segments[segment0_handle].RW_pre);
        atomicAdd(segments[segment0_handle].diffusion_b, -db_weight * segments[segment0_handle].RB_pre);
        
        atomicAdd(segments[segment1_handle].diffusion_c, -dc_weight * segments[segment1_handle].C_pre);
        atomicAdd(segments[segment1_handle].diffusion_w, -dw_weight * segments[segment1_handle].RW_pre);
        atomicAdd(segments[segment1_handle].diffusion_b, -db_weight * segments[segment1_handle].RB_pre);
    }
    
    // Ensure all diffusion calculations are complete
    BARRIER();
    
    // PHASE 2: Update fungus state for each segment
    [[unroll]]
    for (uint i = 0; i < ITERATIONS_PER_TASK; i++) {
        uint segment_index = baseID + laneID + i * WORKGROUP_SIZE;
        if (segment_index >= params.segment_count) return;
        
        // Calculate K based on boundary distance
        segments[segment_index].K = 1.0 / (8.0 * segments[segment_index].boundary_distance + 0.25);
        
        // Get diffusion values from the segment
        float diffusion_c = segments[segment_index].diffusion_c;
        float diffusion_w = segments[segment_index].diffusion_w;
        float diffusion_b = segments[segment_index].diffusion_b;
        
        // Update chemical protection (C)
        segments[segment_index].C = segments[segment_index].C_pre + 
                         params.dt * (0.001 * diffusion_c + 
                                    segments[segment_index].K * (1.0 - segments[segment_index].C_pre) * 
                                    (segments[segment_index].RW_pre + segments[segment_index].RB_pre) * 
                                    segments[segment_index].HC_pre - 
                                    params.delta * segments[segment_index].C_pre);
                                
        // Clamp to valid range
        segments[segment_index].C = clamp(segments[segment_index].C, 0.0, 1.0);
        
        // Update health of carbon (HC)
        segments[segment_index].HC = segments[segment_index].HC_pre + 
                          params.dt * ((-params.ycw * segments[segment_index].RW_pre - 
                                       params.ycb * segments[segment_index].RB_pre) * 
                                      segments[segment_index].HC_pre + 
                                      params.pc * segments[segment_index].C_pre * 
                                      (1.0 - segments[segment_index].HC_pre));
                                  
        segments[segment_index].HC = clamp(segments[segment_index].HC, 0.0, 1.0);
        
        // Update health of lignin (HL)
        segments[segment_index].HL = segments[segment_index].HL_pre + 
                          params.dt * ((-params.ylw * segments[segment_index].RW_pre) * 
                                      segments[segment_index].HL_pre + 
                                      params.pl * segments[segment_index].C_pre * 
                                      (1.0 - segments[segment_index].HL_pre));
                                  
        segments[segment_index].HL = clamp(segments[segment_index].HL, 0.0, 1.0);
        
        // Update white rot (RW)
        segments[segment_index].RW = segments[segment_index].RW_pre + 
                          params.dt * (params.aw * segments[segment_index].RW_pre * 
                                      (1.0 - segments[segment_index].RW_pre) * 
                                      (params.ll * segments[segment_index].HL_pre + 
                                       params.lc * segments[segment_index].HC_pre) - 
                                      params.bw * segments[segment_index].C_pre * 
                                      segments[segment_index].RW_pre + 
                                      0.1 * diffusion_w);
                                  
        segments[segment_index].RW = clamp(segments[segment_index].RW, 0.0, 1.0);
        
        // Update brown rot (RB)
        segments[segment_index].RB = segments[segment_index].RB_pre + 
                          params.dt * (params.ab * segments[segment_index].RB_pre * 
                                      (1.0 - segments[segment_index].RB_pre) * 
                                      segments[segment_index].HC_pre - 
                                      params.bb * segments[segment_index].C_pre * 
                                      segments[segment_index].RB_pre + 
                                      0.1 * diffusion_b);
                                  
        segments[segment_index].RB = clamp(segments[segment_index].RB, 0.0, 1.0);
        
        // Update previous values for next iteration
        segments[segment_index].C_pre = segments[segment_index].C;
        segments[segment_index].HC_pre = segments[segment_index].HC;
        segments[segment_index].HL_pre = segments[segment_index].HL;
        segments[segment_index].RW_pre = segments[segment_index].RW;
        segments[segment_index].RB_pre = segments[segment_index].RB;
        segments[segment_index].diffusion_c = 0.0;
        segments[segment_index].diffusion_w = 0.0;
        segments[segment_index].diffusion_b = 0.0;
        
    }
}
