#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_control_flow_attributes : require

#define DYNAMIC_STRANDS_SET 0
#define EPSILON 1e-3
#include "DynamicStrands.glsl"
#include "KineticVoronoiMeshing.glsl"

#include "Math.glsl"

const uint WORKGROUP_SIZE = COMPUTE_SUBGROUP_COUNT * SUBGROUP_SIZE;

const uint ITERATIONS_PER_TASK = ((COMPUTE_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

uint baseID = gl_WorkGroupID.x * COMPUTE_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#define BARRIER()        \
  memoryBarrierShared(); \
  barrier();

layout(push_constant) uniform PUSH_CONSTANTS {
  uint triangle_count;
  int padding0;
  int padding1;
  int padding2;
};

vec3 boneApply(vec3 pos0,  // vertex at t = 0
               vec3 P0_0,  // bone start at t = 0
               vec3 P0_t,  // bone start at time t
               vec4 q0,    // initial rotation
               vec4 qt     // rotation at time t
) {
  // Move to bone-local space
  vec3 v = pos0 - P0_0;

  // Undo initial orientation
  vec4 q0_inv = vec4(-q0.xyz, q0.w);
  v = rotate_vec3(q0_inv, v);

  // Apply current orientation
  v = rotate_vec3(qt, v);

  // Move to world space
  return v + P0_t;
}

mat4 boneTransform(vec3 P0_0,  // bone start at t = 0
                   vec3 P0_t,  // bone start at time t
                   vec4 q0,    // initial rotation at t = 0
                   vec4 qt     // rotation at time t
) {
  mat4 R0_inv = mat4_cast(conjugate(q0));
  mat4 Rt = mat4_cast(qt);

  mat4 T_negP0_0 = mat4(1, 0, 0, -P0_0.x, 0, 1, 0, -P0_0.y, 0, 0, 1, -P0_0.z, 0, 0, 0, 1);

  mat4 T_P0_t = mat4(1, 0, 0, P0_t.x, 0, 1, 0, P0_t.y, 0, 0, 1, P0_t.z, 0, 0, 0, 1);

  return T_P0_t * Rt * R0_inv * T_negP0_0;
}

void main() {
  [[unroll]]
  for (uint i = 0; i < ITERATIONS_PER_TASK; ++i) {
    uint local_index = laneID + i * WORKGROUP_SIZE;
    uint triangle_index = baseID + local_index;

    if (triangle_index >= triangle_count)
      break;

    SegmentMeshletTriangle tri = segment_meshlet_triangles[triangle_index];

    [[unroll]]
    for (int j = 0; j < 3; j++) {
      uint vertex_index = tri.vertex_indices[j];
      SegmentMeshletVertex vertex = segment_meshlet_vertices[vertex_index];

      Segment segment = segments[vertex.segment_index];

      // Undo initial orientation
      vec4 q0_inv = vec4(-segment.q0.xyz, segment.q0.w);
      vec3 normal_tmp = rotate_vec3(q0_inv, tri.normal0[j].xyz);

      // Apply current orientation
      tri.normal[j] = vec4(rotate_vec3(segment.q, normal_tmp), 0.0);

      // If the neighbor is on the same strand, set a shift for the vertex
      if (tri.neighbor_segment_index >= 0) {
        Segment neighbor_segment = segments[tri.neighbor_segment_index];
        if (neighbor_segment.next_handle == vertex.segment_index ||
          segment.next_handle == tri.neighbor_segment_index) {
          SegmentPair segment_pair = segment_pairs[tri.segment_pair_index];
          if (segment_pair.connectivity_integrity == 0.0f && segment_pair.bend_twist_bundle_integrity == 0.0f) {
            segment_meshlet_vertices[vertex_index].shift = vec3(-tri.normal[j].x, tri.normal[j].y, tri.normal[j].z);
          }
        }
      }
    }

    segment_meshlet_triangles[triangle_index] = tri;
  }
}