#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_control_flow_attributes : require

#define DYNAMIC_STRANDS_SET 0
#include "DynamicStrandsPhysics.glsl"

const uint WORKGROUP_SIZE = COMPUTE_SUBGROUP_COUNT * SUBGROUP_SIZE;

const uint ITERATIONS_PER_TASK = ((COMPUTE_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

uint baseID = gl_WorkGroupID.x * COMPUTE_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#define BARRIER() \
memoryBarrierShared(); \
barrier();

layout(push_constant) uniform PUSH_CONSTANTS {
	uint connection_size;
	uint allow_breaking;
};


void main(){
	[[unroll]]
	for (uint i = 0; i < ITERATIONS_PER_TASK; i++)
	{
		uint local_index  = laneID + i * WORKGROUP_SIZE;
		uint connection_index = baseID + local_index;

		if(connection_index >= connection_size) break;

		Connection connection = connections[connection_index];
		bool bend_twist_valid = connection.bend_twist_strain_valid.w != 0.0f;
		bool connectivity_valid = connection.bend_twist_strain_limit_connectivity_valid.w != 0.0f;
		
		Segment segment0 = segments[connection.segment0_handle];
		Segment segment1 = segments[connection.segment1_handle];

		//Update bend_twist_strain_limit here.
		connections[connection_index].moisture_content = (segment0.moisture_content + segment0.moisture_content) * .5f;
		vec3 bend_twist_strain_limit = connection.max_bend_twist_strain.xyz;

		vec3 bend_twist_strain = bend_twist_strain(segment0.q, segment1.q, connection.rest_darboux_vector);
		if(allow_breaking == 1){
			connectivity_valid = connectivity_valid && segment0.shear_stretch_strain.x < segment0.shear_stretch_strain_limit.x
						&& segment0.shear_stretch_strain.y < segment0.shear_stretch_strain_limit.y
						&& segment0.shear_stretch_strain.z < segment0.shear_stretch_strain_limit.z

						&& segment1.shear_stretch_strain.x < segment1.shear_stretch_strain_limit.x
						&& segment1.shear_stretch_strain.y < segment1.shear_stretch_strain_limit.y
						&& segment1.shear_stretch_strain.z < segment1.shear_stretch_strain_limit.z;
		}

		bend_twist_valid = connectivity_valid && bend_twist_strain.x < bend_twist_strain_limit.x
						&& bend_twist_strain.y < bend_twist_strain_limit.y
						&& bend_twist_strain.z < bend_twist_strain_limit.z;

		connectivity_valid = connectivity_valid && bend_twist_valid;

		connections[connection_index].bend_twist_strain_valid = vec4(bend_twist_valid ? bend_twist_strain : vec3(0, 0, 0), bend_twist_valid ? 1.0f : 0.0f);
		connections[connection_index].bend_twist_strain_limit_connectivity_valid = vec4(bend_twist_strain_limit.xyz, connectivity_valid ? 1.0f : 0.0f);
	}
}