#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_control_flow_attributes : require

#define DYNAMIC_STRANDS_SET 0
#include "DynamicStrands.glsl"
#include "Math.glsl"

const uint WORKGROUP_SIZE = COMPUTE_SUBGROUP_COUNT * SUBGROUP_SIZE;

const uint ITERATIONS_PER_TASK = ((COMPUTE_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

uint baseID = gl_WorkGroupID.x * COMPUTE_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

#define BARRIER() \
memoryBarrierShared(); \
barrier();

layout(push_constant) uniform PUSH_CONSTANTS {
	uint uniform_particle_size;
	float snow_factor;
	float snow_deduction;
};

void main(){
	[[unroll]]
	for (uint i = 0; i < ITERATIONS_PER_TASK; i++)
	{
		uint local_index  = laneID + i * WORKGROUP_SIZE;
		uint uniform_particle_index = baseID + local_index;

		if(uniform_particle_index >= uniform_particle_size) break;
		UniformParticle uniform_particle = uniform_particles[uniform_particle_index];

		vec3 p0 = segments[uniform_particle.segment_handle].particle0.x;
		vec3 p1 = segments[uniform_particle.segment_handle].particle1.x;

		vec3 normal = normalize(uniform_particle.normal_deg.xyz);
		float local_extrusion_distance = uniform_particle.local_extrusion_distance;
		float snow_property = segments[uniform_particle.segment_handle].property1;

		if(segments[uniform_particle.segment_handle].group_index == 0){
			local_extrusion_distance = normal.y > max(1e-6f, 1.f - snow_property * snow_factor) ? snow_property : 0.f;
			uniform_particles[uniform_particle_index].local_extrusion_distance = local_extrusion_distance;
		}else{
			local_extrusion_distance -= snow_deduction;
		}
		uniform_particles[uniform_particle_index].override_color = local_extrusion_distance > 1e-6f ? vec4(1, 0, 0, 0) : vec4(0, 0, 0, 0);
		uniform_particles[uniform_particle_index].position_t.xyz = 
			mix(p0, p1, uniform_particle.position_t.w);
		uniform_particles[uniform_particle_index].tangent.xyz = normalize(p1 - p0);
	}
}