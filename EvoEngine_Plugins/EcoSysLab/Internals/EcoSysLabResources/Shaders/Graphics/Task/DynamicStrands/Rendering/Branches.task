#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_shader_atomic_float : require

#define DYNAMIC_STRANDS_SET 1
#include "DynamicStrands.glsl"

const uint WORKGROUP_SIZE = EXT_TASK_SUBGROUP_COUNT * SUBGROUP_SIZE;

const uint ITERATIONS_PER_TASK = ((EXT_TASK_WORK_GROUP_INVOCATIONS + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

uint baseID = gl_WorkGroupID.x * EXT_TASK_WORK_GROUP_INVOCATIONS;
uint laneID = gl_LocalInvocationID.x;

layout(local_size_x = WORKGROUP_SIZE) in;

struct Task{
	uint	baseID;
	uint8_t	deltaIDs[EXT_TASK_WORK_GROUP_INVOCATIONS];
};

taskPayloadSharedEXT Task ts_out;

#if EXT_TASK_SUBGROUP_COUNT > 1
	shared uint s_out_tetrahedron_count;
#endif

#define BARRIER() \
	memoryBarrierShared(); \
	barrier();

#include "DynamicStrandsRenderingConstants.glsl"
#include "AlphaShape.glsl"

void main(){
	
#if EXT_TASK_SUBGROUP_COUNT > 1
	if (laneID == 0) {
		s_out_tetrahedron_count = 0;
	}
	BARRIER();
#endif
	uint out_tetrahedron_count = 0;
	for (uint i = 0; i < ITERATIONS_PER_TASK; i++)
	{
		uint tetrahedron_index_local = laneID + i * WORKGROUP_SIZE;
		uint tetrahedron_index_global = baseID + tetrahedron_index_local;

		if (tetrahedron_index_global >= tetrahedrons_size) break;
		bool render = true;

		delaunay_tetrahedrons[tetrahedron_index_global].mesh_looked_at = 0;
		delaunay_tetrahedrons[tetrahedron_index_global].task_looked_at = 0;
		delaunay_tetrahedrons[tetrahedron_index_global].triangles_accepted = 0;

		atomicAdd(delaunay_tetrahedrons[tetrahedron_index_global].task_looked_at, 1);
		DelaunayTetrahedron delaunay_tetrahedron = delaunay_tetrahedrons[tetrahedron_index_global];

		if(delaunay_tetrahedrons[tetrahedron_index_global].inside == 0)
		{
			render = false;				
		}
		else
		{
			// flag uniform particle as part of mesh, the remaining ones must be single particles
			[[unroll]]
			for (uint j = 0; j < 4; ++j)
			{
				uniform_particles[delaunay_tetrahedron.indices[j]].is_single_strand_particle = 0;
			}
			// determine which triangles need to be rendered
			[[unroll]]
			for (uint triangle_index = 0; triangle_index < 4; ++triangle_index)
			{
				if(delaunay_tetrahedrons[tetrahedron_index_global].render_neighbor[triangle_index] == 1){
					atomicAdd(delaunay_tetrahedrons[tetrahedron_index_global].triangles_accepted, 1);
				}
			}
		}	

		uvec4 vote_tetrahedrons = subgroupBallot(render);
		uint num_tetrahedrons  = subgroupBallotBitCount(vote_tetrahedrons);

#if EXT_TASK_SUBGROUP_COUNT > 1
		if (gl_SubgroupInvocationID == 0) {
			out_tetrahedron_count = atomicAdd(s_out_tetrahedron_count, num_tetrahedrons);
		}
		out_tetrahedron_count = subgroupBroadcastFirst(out_tetrahedron_count);
#endif
		uint idx_offset  = subgroupBallotExclusiveBitCount(vote_tetrahedrons) + out_tetrahedron_count;
		if (render) 
		{
			ts_out.deltaIDs[idx_offset] = uint8_t(tetrahedron_index_local);
		}
#if EXT_TASK_SUBGROUP_COUNT == 1
		out_tetrahedron_count += num_tetrahedrons;
#endif
	}

#if EXT_TASK_SUBGROUP_COUNT > 1
	BARRIER();
	out_tetrahedron_count = s_out_tetrahedron_count;
#endif
	if (laneID == 0) {
		ts_out.baseID = baseID;
	}
	EmitMeshTasksEXT(out_tetrahedron_count, 1, 1);
}