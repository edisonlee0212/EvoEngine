#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_control_flow_attributes : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

#include "PerFrame.glsl"

#define DYNAMIC_STRANDS_SET 1
#include "DynamicStrands.glsl"
#include "Math.glsl"

const uint WORKGROUP_SIZE = EXT_MESH_SUBGROUP_COUNT * EXT_MESH_SUBGROUP_SIZE;

layout(local_size_x = WORKGROUP_SIZE) in;
layout(triangles) out;

#define CONNECTION_VERTICES_SIZE 8
#define CONNECTION_TRIANGLE_SIZE 12

layout(max_vertices = CONNECTION_VERTICES_SIZE, max_primitives = CONNECTION_TRIANGLE_SIZE) out;

const uint CONNECTION_VERTEX_ITERATIONS    = ((CONNECTION_VERTICES_SIZE	+ WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);
const uint CONNECTION_PRIMITIVE_ITERATIONS = ((CONNECTION_TRIANGLE_SIZE	+ WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

layout(location = 0) out MS_V_OUT {
	vec3 frag_pos;
	vec3 normal;
	vec3 tangent;
	vec4 color;
} ms_v_out[];

struct Task{
	uint	baseID;
	uint8_t	deltaIDs[EXT_INVOCATIONS_PER_TASK];
};

vec3 positions[] = {
    vec3(-0.5, -0.5, -0.5),
    vec3(0.5, 0.5, -0.5),
	vec3(0.5, -0.5, -0.5),
	vec3(-0.5, 0.5, -0.5),

	vec3(-0.5, -0.5, 0.5),
	vec3(0.5, -0.5, 0.5),
	vec3(0.5, 0.5, 0.5),
	vec3(-0.5, 0.5, 0.5)
};

uvec3 triangles[] = {
	uvec3(0, 1, 2),
	uvec3(1, 0, 3),
	uvec3(4, 5, 6),

	uvec3(6, 7, 4),
	uvec3(7, 3, 0),
	uvec3(0, 4, 7),

	uvec3(6, 2, 1),
	uvec3(2, 6, 5),
	uvec3(0, 2, 5),

	uvec3(5, 4, 0),
	uvec3(3, 6, 1),
	uvec3(6, 3, 7)
};

layout(push_constant) uniform STRANDS_RENDER_CONSTANTS {
	vec4 color0;
	vec4 color1;

	uint camera_index;
	uint connections_size;
	uint color_mode;
	uint multiplier;
};

taskPayloadSharedEXT Task ts_in;

// gl_WorkGroupID.x runs from [0 .. parentTask.groupCountX - 1]
uint connection_id = ts_in.baseID + ts_in.deltaIDs[gl_WorkGroupID.x];
uint laneID = gl_LocalInvocationID.x;


void main(){
	if(connection_id >= connections_size) return;

	SetMeshOutputsEXT(CONNECTION_VERTICES_SIZE, CONNECTION_TRIANGLE_SIZE);
	
	Connection connection = connections[connection_id];
	Segment segment0 = segments[connection.segment0_handle];
	Segment segment1 = segments[connection.segment1_handle];

	vec3 start_position = (particles[floatBitsToInt(segment0.inertia_tensor_particle_0_handle.w)].x_node_handle.xyz + particles[floatBitsToInt(segment0.inv_inertia_tensor_particle_1_handle.w)].x_node_handle.xyz) * 0.5;
	vec3 end_position = (particles[floatBitsToInt(segment1.inertia_tensor_particle_0_handle.w)].x_node_handle.xyz + particles[floatBitsToInt(segment1.inv_inertia_tensor_particle_1_handle.w)].x_node_handle.xyz) * 0.5;

	vec3 center_position = (start_position + end_position) * 0.5;
	float center_thickness = (segment0.radius + segment1.radius) * 0.5;
	
	vec3 front = normalize(end_position - start_position);
	vec4 rotation = quatLookAt(front, vec3(front.y, front.z, front.x));
	mat4 instance_matrix = translate(center_position) * mat4_cast(rotation) * scale(vec3(center_thickness, center_thickness, distance(start_position, end_position)));
	mat4 transform = EE_CAMERAS[camera_index].projection_view * instance_matrix;

	vec4 color;
	if(color_mode == 0){
		color = color0;
	}else if(color_mode == 1){
		color = mix(color0, color1, clamp(length(connection.bend_twist_strain_valid.xyz) * uintBitsToFloat(multiplier), 0.0, 1.0));
	}
	
	Particle particle0 = particles[connection.segment0_particle_handle];
	Particle particle1 = particles[connection.segment1_particle_handle];

	if(particle0.highlighted == 1 || particle1.highlighted == 1){
		color = mix(color, vec4(0, 1, 0, 1), 0.8f);
	}else if(particle0.highlighted == 2 || particle1.highlighted == 2){
		color = mix(color, vec4(1, 0, 0, 1), 0.8f);
	}else if(particle0.selected == 1 || particle1.selected == 1){
		color = mix(color, vec4(1, 1, 1, 1), 0.8f);
	}

	[[unroll]]
	for (uint i = 0; i < uint(CONNECTION_VERTEX_ITERATIONS); ++i)
	{
		uint vertex_index = laneID + i * WORKGROUP_SIZE;
		if (vertex_index > CONNECTION_VERTICES_SIZE) break;
		vec3 vertex_position = positions[vertex_index];

		ms_v_out[vertex_index].frag_pos = vec4(instance_matrix * vec4(vertex_position, 1.0)).xyz;
		ms_v_out[vertex_index].normal = vec3(0, 1, 0);
		ms_v_out[vertex_index].tangent = vec3(0, 0, 1);
		ms_v_out[vertex_index].color = color;
		gl_MeshVerticesEXT[vertex_index].gl_Position = transform * vec4(vertex_position, 1.0);
	}

	[[unroll]]
	for (uint i = 0; i < uint(CONNECTION_PRIMITIVE_ITERATIONS); ++i)
	{
		uint triangle_index = laneID + i * WORKGROUP_SIZE;
		if(triangle_index <= CONNECTION_TRIANGLE_SIZE){
			gl_PrimitiveTriangleIndicesEXT[triangle_index] = triangles[triangle_index];
		}
	}
}