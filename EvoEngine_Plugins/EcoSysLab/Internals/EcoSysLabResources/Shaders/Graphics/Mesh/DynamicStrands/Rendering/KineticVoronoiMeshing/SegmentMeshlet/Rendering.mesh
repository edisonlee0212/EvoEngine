#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_control_flow_attributes : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_atomic_float : require

#include "PerFrame.glsl"

#define DYNAMIC_STRANDS_SET 1
#include "DynamicStrands.glsl"

#include "KineticVoronoiMeshing.glsl"
#include "Math.glsl"
#include "VolumeMeasure.glsl"
#include "KineticVoronoiVolumeMeasure.glsl"
const uint WORKGROUP_SIZE = EXT_MESH_SUBGROUP_COUNT * SUBGROUP_SIZE;

const float PI = 3.1415926535897932384626433832795;

layout(local_size_x = WORKGROUP_SIZE) in;
layout(triangles) out;

#define MAX_VERTEX_COUNT 3  // individual vertices for each triangle
#define MAX_PRIMITIVE_COUNT 1

layout(max_vertices = MAX_VERTEX_COUNT, max_primitives = MAX_PRIMITIVE_COUNT) out;

const uint VERTEX_ITERATIONS = ((MAX_VERTEX_COUNT + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);
const uint PRIMITIVE_ITERATIONS = ((MAX_PRIMITIVE_COUNT + WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

layout(location = 0) out MS_V_OUT {
  vec3 FragPos;
  vec3 Normal;
  vec3 Tangent;
  vec2 TexCoord;
  vec4 Color;
}
ms_v_out[];

layout(location = 5) perprimitiveEXT out MS_PRIM_OUT {
  int MaterialIndex;
}
ms_prim[];

struct Task {
  uint baseID;
  uint8_t deltaIDs[EXT_TASK_WORK_GROUP_INVOCATIONS];
};

#define BARRIER()        \
  memoryBarrierShared(); \
  barrier();

taskPayloadSharedEXT Task ts_in;

// gl_WorkGroupID.x runs from [0 .. parentTask.groupCountX - 1]
uint tri_id = ts_in.baseID + ts_in.deltaIDs[gl_WorkGroupID.x];
uint laneID = gl_LocalInvocationID.x;

#include "KineticVoronoiRenderingConstants.glsl"

// Soft selection/highlight tint (rgb = tint, a = mix ratio). Matches strand visualization overlay style.
vec4 SelectionOverlayColor(int segment_index) {
  if (segment_index < 0) {
    return vec4(0.0);
  }
  Particle particle0 = segments[segment_index].particle0;
  Particle particle1 = segments[segment_index].particle1;

  float highlight1_ratio = 0.0;
  float highlight2_ratio = 0.0;
  float selected_ratio = 0.0;

  if (particle0.highlighted == 1) {
    highlight1_ratio += 0.4;
  }
  if (particle0.highlighted == 2) {
    highlight2_ratio += 0.4;
  }
  if (particle0.selected == 1) {
    selected_ratio += 0.4;
  }
  if (particle1.highlighted == 1) {
    highlight1_ratio += 0.4;
  }
  if (particle1.highlighted == 2) {
    highlight2_ratio += 0.4;
  }
  if (particle1.selected == 1) {
    selected_ratio += 0.4;
  }

  if (highlight2_ratio != 0.0) {
    return vec4(1.0, 0.0, 1.0, highlight2_ratio);
  }
  if (selected_ratio != 0.0) {
    return vec4(1.0, 0.0, 0.0, selected_ratio);
  }
  if (highlight1_ratio != 0.0) {
    return vec4(0.0, 0.0, 1.0, highlight1_ratio);
  }
  return vec4(0.0);
}

// neighbor_segment_index: -2 = bark, -1/-3 = grey (never had / removed neighbor), >= 0 = lateral neighbor.
vec4 NeighborConnectivityColor(SegmentMeshletTriangle tri) {
  if (tri.neighbor_segment_index == -2) {
    return vec4(0.45, 0.28, 0.12, 1.0);
  }
  if (tri.neighbor_segment_index == -1 || tri.neighbor_segment_index == -3) {
    return vec4(0.55, 0.55, 0.55, 1.0);
  }
  if (tri.segment_pair_index < 0) {
    return vec4(1.0, 0.0, 0.0, 1.0);
  }
  SegmentPair pair = segment_pairs[tri.segment_pair_index];
  if (pair.connectivity_integrity <= 0.0 && pair.bend_twist_bundle_integrity <= 0.0) {
    return vec4(1.0, 0.0, 0.0, 1.0);
  }
  return vec4(0.0, 1.0, 0.0, 1.0);
}

// Raw neighbor-tag visualization: -2 bark, -1 open/interior, >=0 lateral, <-2 out-of-range.
vec4 NeighborTagColor(SegmentMeshletTriangle tri) {
  if (tri.neighbor_segment_index == -2) {
    return vec4(0.45, 0.28, 0.12, 1.0);  // brown = bark
  }
  if (tri.neighbor_segment_index == -1) {
    return vec4(0.15, 0.55, 1.0, 1.0);  // bright blue = interior / no neighbor
  }
  if (tri.neighbor_segment_index >= 0) {
    return vec4(0.15, 0.75, 0.25, 1.0);  // green = lateral neighbor
  }
  return vec4(0.95, 0.15, 0.85, 1.0);  // magenta = out of range (<-2, e.g. -3)
}

vec3 SetUpTriangleVertex(uint vertex_index, in vec3 vertex_normal, in SegmentMeshletVertex segment_meshlet_vertex,
                         in vec2 uv_coords, in bool is_bark, in vec4 debug_color) {
  mat4 transform = EE_CAMERAS[EE_CAMERA_INDEX].projection_view;

  vec3 pos = segment_meshlet_vertex.x - fracture_distance * segment_meshlet_vertex.shift;
  ms_v_out[vertex_index].FragPos = pos;
  // Geometric normal from GPU (PerTriangleCorner). A previous X flip matched an outdated OBJ convention;
  // keep shading aligned with stored / exported normals.
  ms_v_out[vertex_index].Normal = vertex_normal;
  ms_v_out[vertex_index].Tangent = vec3(0.0, 1.0, 0.0);  // TODO

  if (is_bark) {
    uv_coords.x *= uv_circum_factor;
    uv_coords.y *= uv_height_factor;
  }

  ms_v_out[vertex_index].TexCoord = uv_coords;

  // rgb=tint, a=mix ratio for COLOR_STANDARD overlay; debug modes keep a=1 solid color.
  vec4 selection_overlay = SelectionOverlayColor(segment_meshlet_vertex.segment_index);

  switch (color_mode) {
    case COLOR_STANDARD:
      ms_v_out[vertex_index].Color = selection_overlay;
      break;
    case COLOR_NORMALS: {
      vec4 color = vec4(vertex_normal, 1.0);
      if (selection_overlay.a > 0.0) {
        color.rgb = mix(color.rgb, selection_overlay.rgb, selection_overlay.a);
      }
      ms_v_out[vertex_index].Color = color;
      break;
    }
    case COLOR_UVS: {
      vec4 color = vec4(uv_coords, 0.0, 1.0);
      if (selection_overlay.a > 0.0) {
        color.rgb = mix(color.rgb, selection_overlay.rgb, selection_overlay.a);
      }
      ms_v_out[vertex_index].Color = color;
      break;
    }
    case COLOR_VOLUME_CHANGE_HEATMAP: {
      vec4 color = vec4(KineticSegmentVolumeChangeHeatmapColor(segment_meshlet_vertex.segment_index), 1.0);
      if (selection_overlay.a > 0.0) {
        color.rgb = mix(color.rgb, selection_overlay.rgb, selection_overlay.a);
      }
      ms_v_out[vertex_index].Color = color;
      break;
    }
    case COLOR_NEIGHBORS:
    case COLOR_NEIGHBOR_CONNECTIVITY:
    case COLOR_NEIGHBOR_TAGS: {
      vec4 color = debug_color;
      if (selection_overlay.a > 0.0) {
        color.rgb = mix(color.rgb, selection_overlay.rgb, selection_overlay.a);
      }
      ms_v_out[vertex_index].Color = color;
      break;
    }
  }

  gl_MeshVerticesEXT[vertex_index].gl_Position = transform * vec4(pos, 1.0);

  return segment_meshlet_vertex.x;
}

void main() {
  // TODO: the loop structure here does not make sense
  SegmentMeshletTriangle tri = segment_meshlet_triangles[tri_id];
  // report amount of accepted triangles
  SetMeshOutputsEXT(MAX_VERTEX_COUNT, 1);

  // assign all accepted triangles
  [[unroll]]
  for (uint i = 0; i < uint(PRIMITIVE_ITERATIONS); ++i) {
    uint triangle_index = laneID + i * WORKGROUP_SIZE;  // should always be 0 in our setup
    if (triangle_index < MAX_PRIMITIVE_COUNT) {
      int material_index = inner_wood_material_index;
      if (tri.neighbor_segment_index == -2) {
        material_index = bark_material_index;
      }

      vec4 debug_color = vec4(0.0);
      if (color_mode == COLOR_NEIGHBOR_CONNECTIVITY) {
        debug_color = NeighborConnectivityColor(tri);
      } else if (color_mode == COLOR_NEIGHBOR_TAGS) {
        debug_color = NeighborTagColor(tri);
      } else if (color_mode == COLOR_NEIGHBORS) {
        debug_color = tri.segment_pair_index != -1 ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
      }

      [[unroll]]
      for (int j = 0; j < 3; j++) {
        uint global_vertex_index = tri.vertex_indices[j];
        SegmentMeshletVertex segment_meshlet_vertex = segment_meshlet_vertices[global_vertex_index];
        SetUpTriangleVertex(j, tri.normal[j].xyz, segment_meshlet_vertex, tri.uv[j].xy,
                            tri.neighbor_segment_index == -2, debug_color);
      }

      ms_prim[0].MaterialIndex = material_index;
      gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    }
  }
}