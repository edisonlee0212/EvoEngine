#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_shader_draw_parameters : enable
#extension GL_EXT_control_flow_attributes : require
#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

#include "PerFrame.glsl"

#define DYNAMIC_STRANDS_SET 1
#include "DynamicStrands.glsl"
#include "Math.glsl"
#include "DynamicStrandsSmallSegmentsRenderingConstants.glsl"
const uint WORKGROUP_SIZE = EXT_MESH_SUBGROUP_COUNT * SUBGROUP_SIZE;

layout(local_size_x = WORKGROUP_SIZE) in;
layout(triangles) out;

layout(max_vertices = SMALL_SEGMENT_VERTICES_SIZE, max_primitives = SMALL_SEGMENT_TRIANGLE_SIZE) out;

const uint SMALL_SEGMENT_VERTEX_ITERATIONS    = ((SMALL_SEGMENT_VERTICES_SIZE	+ WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);
const uint SMALL_SEGMENT_PRIMITIVE_ITERATIONS = ((SMALL_SEGMENT_TRIANGLE_SIZE	+ WORKGROUP_SIZE - 1) / WORKGROUP_SIZE);

struct Task{
	uint	baseID;
	uint8_t	deltaIDs[EXT_TASK_WORK_GROUP_INVOCATIONS];
};

taskPayloadSharedEXT Task ts_in;

// gl_WorkGroupID.x runs from [0 .. parentTask.groupCountX - 1]
uint uniform_particle_id = ts_in.baseID + ts_in.deltaIDs[gl_WorkGroupID.x];
uint laneID = gl_LocalInvocationID.x;


void main(){
	if(uniform_particle_id >= uniform_particles_size) return;

	SetMeshOutputsEXT(SMALL_SEGMENT_VERTICES_SIZE, SMALL_SEGMENT_TRIANGLE_SIZE);
	
	UniformParticle uniform_particle = uniform_particles[uniform_particle_id];
	UniformParticle prev_uniform_particle = uniform_particles[uniform_particle.prev_particle_handle];

	Segment segment = segments[uniform_particle.segment_handle];
	Segment prev_segment = segments[prev_uniform_particle.segment_handle];

	vec3 start_position = prev_uniform_particle.position_t.xyz;
	vec3 end_position = uniform_particle.position_t.xyz;
	
	if(segment.group_index != prev_segment.group_index){
		start_position = end_position - rotate_vec3(segment.q, vec3(0, 0, -1)) * segment.rest_length * 0.2f;
	}
	
	vec3 center_position = (start_position + end_position) * 0.5f;
	
	vec3 front = normalize(end_position - start_position);
	vec4 uniform_particle_rotation = quatLookAt(front, vec3(front.y, front.z, front.x));


	float radius = segment.radius * 2.f * thickness_multiplier;
	vec3 uniform_particle_scale = vec3(radius, radius, distance(start_position, end_position));

	mat4 instance_matrix = translate(center_position) * mat4_cast(uniform_particle_rotation) * scale(uniform_particle_scale);
	
	mat4 transform = EE_DIRECTIONAL_LIGHTS[EE_CAMERA_INDEX].light_space_matrix[EE_INSTANCE_INDEX] * instance_matrix;
	
	[[unroll]]
	for (uint i = 0; i < uint(SMALL_SEGMENT_VERTEX_ITERATIONS); ++i)
	{
		uint vertex_index = laneID + i * WORKGROUP_SIZE;
		if (vertex_index > SMALL_SEGMENT_VERTICES_SIZE) break;
		vec3 vertex_position = positions[vertex_index];

		gl_MeshVerticesEXT[vertex_index].gl_Position = transform * vec4(vertex_position, 1.0f);
	}

	[[unroll]]
	for (uint i = 0; i < uint(SMALL_SEGMENT_PRIMITIVE_ITERATIONS); ++i)
	{
		uint triangle_index = laneID + i * WORKGROUP_SIZE;
		if(triangle_index <= SMALL_SEGMENT_TRIANGLE_SIZE){
			gl_PrimitiveTriangleIndicesEXT[triangle_index] = triangles[triangle_index];
		}
	}
}