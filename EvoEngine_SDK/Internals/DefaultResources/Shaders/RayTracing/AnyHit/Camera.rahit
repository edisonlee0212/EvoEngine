#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_ray_tracing : require

#include "CameraRayTracingPayload.glsl"
#include "RayTracingBasic.glsl"
#include "Random.glsl"
#include "GltfRasterMaterial.glsl"
#include "CameraRayGeometry.glsl"

layout(location = 0) rayPayloadInEXT CameraRayTracingPayload hit_value;

hitAttributeEXT vec2 attribs;

const uint EE_CAMERA_RAY_PAYLOAD_SHADOW = 1u;
const float EE_CAMERA_MIN_SHADOW_TRANSMISSION = 0.01f;

vec3 EE_CAMERA_SAFE_NORMALIZE(const vec3 value, const vec3 fallback) {
  const float length_squared = dot(value, value);
  return length_squared > 0.00000001f ? value * inversesqrt(length_squared) : fallback;
}

vec3 EE_CAMERA_WORLD_NORMAL(const vec3 object_normal, const vec3 fallback) {
  return EE_CAMERA_SCALE_INDEPENDENT_NORMALIZE(vec3(object_normal * gl_WorldToObjectEXT), fallback);
}

vec3 EE_CAMERA_SHADOW_TRANSMISSION(const uint material_index, const vec2 tex_coord_0, const vec2 tex_coord_1,
                                   const vec2 tex_coord_2, const vec2 tex_coord_3,
                                   const vec3 vertex_color, const vec3 world_geometric_normal) {
  bool is_inside = hit_value.shadow_is_inside != 0u;
  const float cos_theta = abs(dot(normalize(gl_WorldRayDirectionEXT),
                                  EE_CAMERA_SAFE_NORMALIZE(world_geometric_normal, -gl_WorldRayDirectionEXT)));
  const float segment_length = abs(gl_HitTEXT - hit_value.shadow_previous_hit_t);
  const vec3 transmission = EE_GLTF_RASTER_SHADOW_TRANSMISSION_LOD0(
      material_index, tex_coord_0, tex_coord_1, tex_coord_2, tex_coord_3, vertex_color, cos_theta,
      segment_length, is_inside, EE_CAMERA_MIN_SHADOW_TRANSMISSION);
  hit_value.shadow_is_inside = is_inside ? 1u : 0u;
  return max(transmission, vec3(0.0f));
}

void main() {
  const int instance_index = int(gl_InstanceCustomIndexEXT);
  const Instance instance = EE_INSTANCES[instance_index];
  const uint material_index = uint(instance.material_index);
  const int triangle_offset = instance.triangle_offset + gl_PrimitiveID;

  const Vertex v0 = EE_VERTICES[EE_INDICES[triangle_offset * 3]];
  const Vertex v1 = EE_VERTICES[EE_INDICES[triangle_offset * 3 + 1]];
  const Vertex v2 = EE_VERTICES[EE_INDICES[triangle_offset * 3 + 2]];
  const vec3 barycentrics = vec3(1.0f - attribs.x - attribs.y, attribs.x, attribs.y);
  const vec2 tex_coord_0 = v0.tex_coord * barycentrics.x + v1.tex_coord * barycentrics.y +
                           v2.tex_coord * barycentrics.z;
  const vec2 tex_coord_1 = v0.tex_coord_1 * barycentrics.x + v1.tex_coord_1 * barycentrics.y +
                           v2.tex_coord_1 * barycentrics.z;
  const vec2 tex_coord_2 = v0.tex_coord_2 * barycentrics.x + v1.tex_coord_2 * barycentrics.y +
                           v2.tex_coord_2 * barycentrics.z;
  const vec2 tex_coord_3 = v0.tex_coord_3 * barycentrics.x + v1.tex_coord_3 * barycentrics.y +
                           v2.tex_coord_3 * barycentrics.z;
  const vec4 vertex_color = v0.color * barycentrics.x + v1.color * barycentrics.y + v2.color * barycentrics.z;

  const float opacity = EE_GLTF_RASTER_OPACITY_LOD0(
      material_index, tex_coord_0, tex_coord_1, tex_coord_2, tex_coord_3, vertex_color.a);
  if (EE_PCG_RANDOM(hit_value.seed) > opacity) {
    ignoreIntersectionEXT;
  }
  if (hit_value.type != EE_CAMERA_RAY_PAYLOAD_SHADOW) {
    return;
  }

  const vec3 object_shading_normal = EE_CAMERA_SCALE_INDEPENDENT_NORMALIZE(
      v0.normal * barycentrics.x + v1.normal * barycentrics.y + v2.normal * barycentrics.z,
      vec3(0.0f, 1.0f, 0.0f));
  const vec3 object_geometric_normal =
      EE_CAMERA_GEOMETRIC_NORMAL(v1.position - v0.position, v2.position - v0.position, object_shading_normal);
  const vec3 world_shading_normal = EE_CAMERA_WORLD_NORMAL(object_shading_normal, -gl_WorldRayDirectionEXT);
  const vec3 world_geometric_normal = EE_CAMERA_WORLD_NORMAL(object_geometric_normal, world_shading_normal);
  const vec3 transmission =
      EE_CAMERA_SHADOW_TRANSMISSION(material_index, tex_coord_0, tex_coord_1, tex_coord_2, tex_coord_3,
                                    vertex_color.rgb, world_geometric_normal);
  hit_value.shadow_previous_hit_t = gl_HitTEXT;
  hit_value.shadow_transmission *= transmission;

  if (max(max(hit_value.shadow_transmission.x, hit_value.shadow_transmission.y), hit_value.shadow_transmission.z) <=
      EE_CAMERA_MIN_SHADOW_TRANSMISSION) {
    hit_value.shadow_transmission = vec3(0.0f);
    terminateRayEXT;
  }
  ignoreIntersectionEXT;
}
