#extension GL_ARB_shading_language_include : enable
#extension GL_EXT_ray_tracing : require

#include "CameraRayTracingPayload.glsl"
#include "RayTracingBasic.glsl"
#include "Random.glsl"
#include "GltfRasterMaterial.glsl"

layout(location = 0) rayPayloadInEXT CameraRayTracingPayload hit_value;

hitAttributeEXT vec2 attribs;

layout(push_constant) uniform EE_CAMERA_CONSTANTS {
  uint EE_CAMERA_INDEX;
  uint EE_FRAME_ID;
  uint EE_TOTAL_SAMPLES;
  uint EE_FRAME_SAMPLE_SIZE;
};

const uint EE_CAMERA_RAY_PAYLOAD_SHADOW = 1u;
const float EE_CAMERA_MIN_SHADOW_TRANSMISSION = 0.01f;

vec3 EE_CAMERA_SAFE_NORMALIZE(const vec3 value, const vec3 fallback) {
  const float length_squared = dot(value, value);
  return length_squared > 0.00000001f ? value * inversesqrt(length_squared) : fallback;
}

float EE_CAMERA_TEXEL_DENSITY(const mat4 model, const Vertex v0, const Vertex v1, const Vertex v2) {
  const vec3 world_edge_1 = vec3(model * vec4(v1.position - v0.position, 0.0f));
  const vec3 world_edge_2 = vec3(model * vec4(v2.position - v0.position, 0.0f));
  const float world_area = length(cross(world_edge_1, world_edge_2));
  const vec2 uv_edge_1 = v1.tex_coord - v0.tex_coord;
  const vec2 uv_edge_2 = v2.tex_coord - v0.tex_coord;
  const float uv_area = abs(uv_edge_1.x * uv_edge_2.y - uv_edge_1.y * uv_edge_2.x);
  return sqrt(max(uv_area, 1e-20f) / max(world_area, 1e-20f));
}

float EE_CAMERA_WORLD_FOOTPRINT(const float hit_t, const vec3 geometric_normal, const vec3 ray_direction) {
  const Camera camera = EE_CAMERAS[EE_CAMERA_INDEX];
  const float pixel_angle = 2.0f * abs(camera.inverse_projection[1][1]) / max(camera.resolution_y, 1.0f);
  return hit_t * pixel_angle / max(abs(dot(geometric_normal, -ray_direction)), 1e-3f);
}

float EE_CAMERA_TEXTURE_GRAD(const float hit_t, const vec3 geometric_normal, const vec3 ray_direction,
                             const mat4 model, const Vertex v0, const Vertex v1, const Vertex v2) {
  return EE_CAMERA_WORLD_FOOTPRINT(hit_t, geometric_normal, ray_direction) *
         EE_CAMERA_TEXEL_DENSITY(model, v0, v1, v2);
}

vec3 EE_CAMERA_WORLD_NORMAL(const vec3 object_normal, const vec3 fallback) {
  return EE_CAMERA_SAFE_NORMALIZE(vec3(object_normal * gl_WorldToObjectEXT), fallback);
}

vec3 EE_CAMERA_SHADOW_TRANSMISSION(const uint material_index, const vec2 tex_coord,
                                   const vec3 world_geometric_normal) {
  bool is_inside = hit_value.shadow_is_inside != 0u;
  const float cos_theta = abs(dot(normalize(gl_WorldRayDirectionEXT),
                                  EE_CAMERA_SAFE_NORMALIZE(world_geometric_normal, -gl_WorldRayDirectionEXT)));
  const float segment_length = abs(gl_HitTEXT - hit_value.shadow_previous_hit_t);
  const vec3 transmission = EE_GLTF_RASTER_SHADOW_TRANSMISSION_LOD0(
      material_index, tex_coord, tex_coord, cos_theta, segment_length, is_inside, EE_CAMERA_MIN_SHADOW_TRANSMISSION);
  hit_value.shadow_is_inside = is_inside ? 1u : 0u;
  return max(transmission, vec3(0.0f));
}

void main() {
  const int instance_index = int(gl_InstanceCustomIndexEXT);
  const Instance instance = EE_INSTANCES[instance_index];
  const uint material_index = uint(instance.material_index);
  hit_value.material_index = material_index;
  const int triangle_offset = instance.triangle_offset + gl_PrimitiveID;

  const Vertex v0 = EE_VERTICES[EE_INDICES[triangle_offset * 3]];
  const Vertex v1 = EE_VERTICES[EE_INDICES[triangle_offset * 3 + 1]];
  const Vertex v2 = EE_VERTICES[EE_INDICES[triangle_offset * 3 + 2]];
  const vec3 barycentrics = vec3(1.0f - attribs.x - attribs.y, attribs.x, attribs.y);
  const vec2 tex_coord = v0.tex_coord * barycentrics.x + v1.tex_coord * barycentrics.y +
                         v2.tex_coord * barycentrics.z;
  const vec4 vertex_color = v0.color * barycentrics.x + v1.color * barycentrics.y + v2.color * barycentrics.z;

  const vec3 object_geometric_normal = EE_CAMERA_SAFE_NORMALIZE(cross(v1.position - v0.position,
                                                                      v2.position - v0.position),
                                                                vec3(0.0f, 1.0f, 0.0f));
  const vec3 world_geometric_normal = EE_CAMERA_WORLD_NORMAL(object_geometric_normal, -gl_WorldRayDirectionEXT);
  const float opacity = EE_GLTF_RASTER_OPACITY_LOD0(material_index, tex_coord, tex_coord, vertex_color.a);
  if (EE_RANDOM(hit_value.seed) > opacity) {
    ignoreIntersectionEXT;
  }
  if (hit_value.type != EE_CAMERA_RAY_PAYLOAD_SHADOW) {
    return;
  }

  const vec3 transmission = EE_CAMERA_SHADOW_TRANSMISSION(material_index, tex_coord, world_geometric_normal);
  hit_value.shadow_previous_hit_t = gl_HitTEXT;
  hit_value.shadow_transmission *= transmission;
  hit_value.hit_count = 1u;

  if (max(max(hit_value.shadow_transmission.x, hit_value.shadow_transmission.y), hit_value.shadow_transmission.z) <=
      EE_CAMERA_MIN_SHADOW_TRANSMISSION) {
    hit_value.shadow_transmission = vec3(0.0f);
    terminateRayEXT;
  }
  ignoreIntersectionEXT;
}
