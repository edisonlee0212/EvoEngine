#extension GL_ARB_shading_language_include : enable

#include "PerFrame.glsl"
#include "VolumetricClouds.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 0) uniform sampler2D inDepth;
layout(set = 1, binding = 1, rgba32f) uniform image2D inOutColor;
layout(set = 1, binding = 4) uniform sampler2D inCloudAccumulation;
layout(set = 1, binding = 5) uniform sampler2D inCloudTransmittance;
layout(set = 1, binding = 10) uniform sampler2D inPreviousCloudAccumulation;
layout(set = 1, binding = 11) uniform sampler2D inPreviousCloudTransmittance;
layout(set = 1, binding = 12, rgba16f) uniform image2D outCloudAccumulationHistory;
layout(set = 1, binding = 13, r16f) uniform image2D outCloudTransmittanceHistory;

layout(push_constant) uniform EE_VOLUMETRIC_CLOUD_CONSTANTS {
  vec4 altitudeCoverageDensity;
  vec4 windTime;
  vec4 lightingPhaseMaxDistance;
  vec4 noiseExtinctionMarchDistance;
  vec4 atmosphereCloudTypeCurl;
  vec4 marchControl;
  ivec4 cameraFrameSteps;
  ivec4 flags;
};

VolumetricCloudSettingsGpu EE_BUILD_VOLUMETRIC_CLOUD_SETTINGS() {
  VolumetricCloudSettingsGpu settings;
  settings.enabled = flags.x;
  settings.coverage = altitudeCoverageDensity.z;
  settings.density = altitudeCoverageDensity.w;
  settings.bottom_altitude = altitudeCoverageDensity.x;
  settings.top_altitude = altitudeCoverageDensity.y;
  settings.wind_direction = windTime.xy;
  settings.wind_speed = windTime.z;
  settings.primary_step_count = cameraFrameSteps.z;
  settings.light_step_count = cameraFrameSteps.w;
  settings.lighting_intensity = lightingPhaseMaxDistance.x;
  settings.ambient_lighting_strength = lightingPhaseMaxDistance.y;
  settings.phase_anisotropy = lightingPhaseMaxDistance.z;
  settings.base_noise_scale = noiseExtinctionMarchDistance.x;
  settings.detail_noise_scale = noiseExtinctionMarchDistance.y;
  settings.extinction_scale = noiseExtinctionMarchDistance.z;
  settings.max_march_distance = noiseExtinctionMarchDistance.w;
  settings.use_spherical_atmosphere = atmosphereCloudTypeCurl.x > 0.5f ? 1 : 0;
  settings.atmosphere_radius = atmosphereCloudTypeCurl.y;
  settings.cloud_type = atmosphereCloudTypeCurl.z;
  settings.curl_strength = atmosphereCloudTypeCurl.w;
  settings.coarse_step_fraction = marchControl.x;
  settings.fine_step_scale = marchControl.y;
  settings.empty_step_fallback_count = int(round(marchControl.z));
  settings.enable_cloud_shadows = (flags.w & 2) != 0 ? 1 : 0;
  settings.cloud_shadow_strength = lightingPhaseMaxDistance.w;
  settings.cloud_shadow_step_count = max(flags.w >> 2, 1);
  settings.debug_mode = flags.y != 0 ? flags.z : 0;
  return settings;
}

vec3 EE_VOLUMETRIC_CLOUD_RAY_DIRECTION(in int camera_index, in vec2 tex_coord) {
  vec3 camera_position = EE_CAMERA_POSITION(camera_index);
  vec3 far_world = EE_DEPTH_TO_WORLD_POS(camera_index, tex_coord, 1.0f);
  return normalize(far_world - camera_position);
}

float EE_VOLUMETRIC_CLOUD_SCENE_DISTANCE(in int camera_index, in vec2 tex_coord, in vec3 ray_origin,
                                         in vec3 ray_direction, in float max_distance) {
  if ((flags.w & 1) != 0) {
    float hit_distance = texture(inDepth, tex_coord).r;
    float camera_far = EE_CAMERA_FAR(camera_index);
    if (hit_distance >= camera_far * 0.999f) {
      return max_distance;
    }
    return clamp(hit_distance, 0.0f, max_distance);
  }
  float ndc_depth = texture(inDepth, tex_coord).r;
  if (ndc_depth >= 0.999999f) {
    return max_distance;
  }
  vec3 world_position = EE_DEPTH_TO_WORLD_POS(camera_index, tex_coord, ndc_depth);
  return clamp(dot(world_position - ray_origin, ray_direction), 0.0f, max_distance);
}

ivec2 EE_VOLUMETRIC_CLOUD_DEPTH_AWARE_TEXEL(in int camera_index, in vec2 tex_coord, in vec3 ray_origin,
                                            in vec3 ray_direction, in float max_distance) {
  ivec2 cloud_resolution = textureSize(inCloudAccumulation, 0);
  vec2 cloud_pixel = tex_coord * vec2(cloud_resolution) - vec2(0.5f);
  ivec2 base_pixel = ivec2(floor(cloud_pixel));
  float target_distance =
      EE_VOLUMETRIC_CLOUD_SCENE_DISTANCE(camera_index, tex_coord, ray_origin, ray_direction, max_distance);

  ivec2 best_pixel = clamp(base_pixel, ivec2(0), cloud_resolution - ivec2(1));
  float best_error = 3.402823466e+38f;
  for (int y = 0; y <= 1; ++y) {
    for (int x = 0; x <= 1; ++x) {
      ivec2 candidate = clamp(base_pixel + ivec2(x, y), ivec2(0), cloud_resolution - ivec2(1));
      vec2 candidate_tex_coord = (vec2(candidate) + vec2(0.5f)) / vec2(cloud_resolution);
      vec3 candidate_ray_direction = EE_VOLUMETRIC_CLOUD_RAY_DIRECTION(camera_index, candidate_tex_coord);
      float candidate_distance = EE_VOLUMETRIC_CLOUD_SCENE_DISTANCE(camera_index, candidate_tex_coord, ray_origin,
                                                                    candidate_ray_direction, max_distance);
      float candidate_error = abs(candidate_distance - target_distance);
      if (candidate_error < best_error) {
        best_error = candidate_error;
        best_pixel = candidate;
      }
    }
  }
  return best_pixel;
}

void EE_VOLUMETRIC_CLOUD_SUN_LIGHT(out vec3 sun_direction, out vec3 sun_radiance, out vec3 ambient_radiance) {
  ambient_radiance = max(EE_ENVIRONMENT.background_color.rgb, vec3(0.0f)) *
                     max(EE_ENVIRONMENT.diffuse_sky_intensity, 0.0f) *
                     max(EE_RENDER_INFO.indirect_lighting_intensity, 0.0f);
  sun_direction = normalize(vec3(0.35f, 1.0f, 0.2f));
  sun_radiance = vec3(1.0f);
  if (EE_RENDER_INFO.directional_light_size > 0) {
    DirectionalLight light = EE_DIRECTIONAL_LIGHTS[0];
    sun_direction = normalize(-light.direction);
    sun_radiance = max(light.diffuse.rgb, vec3(0.0f));
  }
}

vec2 EE_VOLUMETRIC_CLOUD_PREVIOUS_TEX_COORD(in int camera_index, in vec3 world_position, out int valid) {
  vec4 previous_clip = EE_CAMERAS[camera_index].previous_projection_view * vec4(world_position, 1.0f);
  valid = 0;
  if (previous_clip.w <= 0.0001f) {
    return vec2(0.0f);
  }
  vec3 previous_ndc = previous_clip.xyz / previous_clip.w;
  vec2 previous_tex_coord = previous_ndc.xy * 0.5f + vec2(0.5f);
  if (previous_tex_coord.x >= 0.0f && previous_tex_coord.x <= 1.0f && previous_tex_coord.y >= 0.0f &&
      previous_tex_coord.y <= 1.0f && previous_ndc.z >= -0.001f && previous_ndc.z <= 1.001f) {
    valid = 1;
  }
  return previous_tex_coord;
}

void EE_VOLUMETRIC_CLOUD_APPLY_TEMPORAL_HISTORY(in int camera_index, in vec3 ray_origin, in vec3 ray_direction,
                                                in float max_distance, inout vec4 cloud_accumulation,
                                                inout float cloud_transmittance) {
  float history_weight = clamp(marchControl.w, 0.0f, 0.98f);
  if (history_weight <= 0.0f || cloud_accumulation.a <= 0.0f || cloud_transmittance >= 0.999f) {
    return;
  }

  vec3 reprojection_position = ray_origin + ray_direction * clamp(cloud_accumulation.a, 0.0f, max_distance);
  int valid;
  vec2 previous_tex_coord = EE_VOLUMETRIC_CLOUD_PREVIOUS_TEX_COORD(camera_index, reprojection_position, valid);
  if (valid == 0) {
    return;
  }

  vec4 previous_accumulation = texture(inPreviousCloudAccumulation, previous_tex_coord);
  float previous_transmittance = texture(inPreviousCloudTransmittance, previous_tex_coord).r;
  float distance_error = abs(previous_accumulation.a - cloud_accumulation.a);
  float max_distance_error = max(25.0f, cloud_accumulation.a * 0.25f);
  if (previous_accumulation.a <= 0.0f || distance_error > max_distance_error ||
      abs(previous_transmittance - cloud_transmittance) > 0.35f) {
    return;
  }

  cloud_accumulation.rgb = mix(cloud_accumulation.rgb, previous_accumulation.rgb, history_weight);
  cloud_transmittance = mix(cloud_transmittance, previous_transmittance, history_weight);
  cloud_accumulation.a = mix(cloud_accumulation.a, previous_accumulation.a, min(history_weight, 0.5f));
}

vec4 EE_VOLUMETRIC_CLOUD_COMPOSITE_DEBUG(in vec3 scene_color, in vec3 cloud_radiance, in float transmittance,
                                         in float march_distance, in float max_distance) {
  int debug_mode = flags.y != 0 ? flags.z : 0;
  if (debug_mode == 1) {
    return vec4(cloud_radiance, 1.0f);
  }
  if (debug_mode == 2) {
    return vec4(vec3(transmittance), 1.0f);
  }
  if (debug_mode == 3) {
    return vec4(vec3(EE_VOLUMETRIC_CLOUD_Saturate(march_distance / max(max_distance, 1.0f))), 1.0f);
  }
  if (debug_mode == 4 || debug_mode == 5 || debug_mode == 6) {
    return vec4(cloud_radiance, 1.0f);
  }
  return vec4(cloud_radiance + scene_color * transmittance, 1.0f);
}

void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  ivec2 resolution = imageSize(inOutColor);
  if (pixel.x >= resolution.x || pixel.y >= resolution.y) {
    return;
  }

  vec2 tex_coord = (vec2(pixel) + vec2(0.5f)) / vec2(resolution);
  int camera_index = cameraFrameSteps.x;
  vec3 ray_origin = EE_CAMERA_POSITION(camera_index);
  vec3 ray_direction = EE_VOLUMETRIC_CLOUD_RAY_DIRECTION(camera_index, tex_coord);
  float max_distance = max(noiseExtinctionMarchDistance.w, 0.0f);
  ivec2 cloud_pixel =
      EE_VOLUMETRIC_CLOUD_DEPTH_AWARE_TEXEL(camera_index, tex_coord, ray_origin, ray_direction, max_distance);

  vec4 scene_color = imageLoad(inOutColor, pixel);
  vec4 cloud_accumulation = texelFetch(inCloudAccumulation, cloud_pixel, 0);
  float cloud_transmittance = texelFetch(inCloudTransmittance, cloud_pixel, 0).r;
  VolumetricCloudSettingsGpu cloud_settings = EE_BUILD_VOLUMETRIC_CLOUD_SETTINGS();
  float scene_distance =
      EE_VOLUMETRIC_CLOUD_SCENE_DISTANCE(camera_index, tex_coord, ray_origin, ray_direction, max_distance);
  vec3 shadowed_scene_color = scene_color.rgb;
  if (scene_distance < max_distance * 0.999f && scene_distance > 0.0f) {
    vec3 sun_direction;
    vec3 sun_radiance;
    vec3 ambient_radiance;
    EE_VOLUMETRIC_CLOUD_SUN_LIGHT(sun_direction, sun_radiance, ambient_radiance);
    vec3 surface_position = ray_origin + ray_direction * scene_distance;
    float cloud_shadow = EE_VOLUMETRIC_CLOUD_SurfaceShadowTransmittance(
        cloud_settings, surface_position, ray_origin, sun_direction, windTime.w);
    shadowed_scene_color *= mix(1.0f, cloud_shadow, clamp(cloud_settings.cloud_shadow_strength, 0.0f, 1.0f));
  }
  EE_VOLUMETRIC_CLOUD_APPLY_TEMPORAL_HISTORY(camera_index, ray_origin, ray_direction, max_distance,
                                             cloud_accumulation, cloud_transmittance);
  imageStore(outCloudAccumulationHistory, pixel, cloud_accumulation);
  imageStore(outCloudTransmittanceHistory, pixel, vec4(cloud_transmittance));
  vec4 output_color = EE_VOLUMETRIC_CLOUD_COMPOSITE_DEBUG(shadowed_scene_color, cloud_accumulation.rgb,
                                                          cloud_transmittance, cloud_accumulation.a, max_distance);
  output_color.a = scene_color.a;
  imageStore(inOutColor, pixel, output_color);
}
