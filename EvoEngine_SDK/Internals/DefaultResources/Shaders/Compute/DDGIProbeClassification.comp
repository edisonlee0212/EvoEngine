#extension GL_ARB_shading_language_include : enable
#include "PointCloudRayTracingPayload.glsl"
#include "DDGI.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

struct DdgiProbeRaySample {
  vec3 direction;
  float padding0;
  vec3 start;

  uint hit_count;
  uint64_t handle;
  uint64_t padding1;

  HitInfo hit_info;
};

layout(set = 0, binding = 0) readonly buffer EE_DDGI_PROBE_RAY_SAMPLE_BLOCK {
  DdgiProbeRaySample EE_DDGI_PROBE_RAY_SAMPLES[];
};
layout(set = 0, binding = 1) buffer EE_DDGI_PROBE_STATE_BLOCK {
  vec4 EE_DDGI_PROBE_STATE[];
};
layout(set = 0, binding = 2) readonly buffer EE_DDGI_PROBE_UPDATE_INDEX_BLOCK {
  uint EE_DDGI_PROBE_UPDATE_INDICES[];
};

layout(push_constant) uniform EE_DDGI_PROBE_CLASSIFICATION_CONSTANTS {
  uvec4 probe_count_ray_count_and_flags;
  uvec4 probe_counts;
  vec4 classification_parameters;
  ivec4 probe_scroll_offset;
  vec4 probe_step_x;
  vec4 probe_step_y;
  vec4 probe_step_z;
};

bool EE_DDGI_RAY_BACKFACE_HIT(const DdgiProbeRaySample ray_sample) {
  return ray_sample.hit_count != 0u && ray_sample.hit_info.color.a < 0.0f;
}

float EE_DDGI_RAY_HIT_DISTANCE(const DdgiProbeRaySample ray_sample) {
  return length(ray_sample.hit_info.position - ray_sample.start);
}

void main() {
  const uint probe_index = gl_GlobalInvocationID.x;
  const uint dispatch_probe_count = max(probe_count_ray_count_and_flags.x, 1u);
  const uint ray_count = max(probe_count_ray_count_and_flags.y, 1u);
  const uint total_probe_count = max(probe_count_ray_count_and_flags.z, 1u);
  const bool reset_classification = probe_count_ray_count_and_flags.w != 0u;
  if (probe_index >= dispatch_probe_count) {
    return;
  }

  if (reset_classification) {
    if (probe_index < total_probe_count) {
      EE_DDGI_PROBE_STATE[probe_index].w = 0.0f;
    }
    return;
  }

  const uint global_probe_index = EE_DDGI_PROBE_UPDATE_INDICES[probe_index];
  if (global_probe_index >= total_probe_count) {
    return;
  }

  const uvec3 total_probe_counts = max(probe_counts.xyz, uvec3(1u));
  const uint probes_per_layer = total_probe_counts.x * total_probe_counts.y;
  const uvec3 logical_probe_grid =
      uvec3(global_probe_index % total_probe_counts.x, (global_probe_index / total_probe_counts.x) % total_probe_counts.y,
            global_probe_index / probes_per_layer);
  const uint physical_probe_index =
      EE_DDGI_SCROLL_PROBE_INDEX(logical_probe_grid, probe_scroll_offset.xyz, total_probe_counts);
  const uint fixed_ray_count = EE_DDGI_FIXED_RAY_COUNT(ray_count, true);
  if (fixed_ray_count == 0u) {
    EE_DDGI_PROBE_STATE[physical_probe_index].w = 0.0f;
    return;
  }

  const uint ray_offset = probe_index * ray_count;
  float backface_count = 0.0f;
  for (uint ray_index = 0u; ray_index < fixed_ray_count; ++ray_index) {
    const DdgiProbeRaySample ray_sample = EE_DDGI_PROBE_RAY_SAMPLES[ray_offset + ray_index];
    if (EE_DDGI_RAY_BACKFACE_HIT(ray_sample)) {
      backface_count += 1.0f;
    }
  }

  const float fixed_ray_backface_threshold = clamp(classification_parameters.x, 0.0f, 1.0f);
  if (backface_count / float(fixed_ray_count) > fixed_ray_backface_threshold) {
    EE_DDGI_PROBE_STATE[physical_probe_index].w = 1.0f;
    return;
  }

  for (uint ray_index = 0u; ray_index < fixed_ray_count; ++ray_index) {
    const DdgiProbeRaySample ray_sample = EE_DDGI_PROBE_RAY_SAMPLES[ray_offset + ray_index];
    if (EE_DDGI_RAY_BACKFACE_HIT(ray_sample) || ray_sample.hit_count == 0u ||
        EE_DDGI_IS_INACTIVE_PROBE_RAY(ray_sample.hit_count, ray_sample.hit_info.color.a)) {
      continue;
    }
    const float hit_distance = EE_DDGI_RAY_HIT_DISTANCE(ray_sample);
    const float voxel_plane_distance =
        EE_DDGI_VOXEL_PLANE_DISTANCE(ray_sample.direction, probe_step_x.xyz, probe_step_y.xyz, probe_step_z.xyz);
    if (hit_distance <= voxel_plane_distance) {
      EE_DDGI_PROBE_STATE[physical_probe_index].w = 0.0f;
      return;
    }
  }
  EE_DDGI_PROBE_STATE[physical_probe_index].w = 1.0f;
}
