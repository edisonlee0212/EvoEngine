#extension GL_ARB_shading_language_include : enable
#include "DDGI.glsl"
#include "DDGIProbeRayData.glsl"

#ifndef EE_DDGI_PROBE_UPDATE_MODE
#define EE_DDGI_PROBE_UPDATE_MODE 0
#endif

#ifndef EE_DDGI_PROBE_USE_SHARED_RAYS
#define EE_DDGI_PROBE_USE_SHARED_RAYS 0
#endif

#define EE_DDGI_PROBE_UPDATE_SERIAL 0
#define EE_DDGI_PROBE_UPDATE_IRRADIANCE 1
#define EE_DDGI_PROBE_UPDATE_VISIBILITY 2
#define EE_DDGI_PROBE_UPDATE_GROUP_SIZE 64u
#define EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT 256u

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 1, binding = 0) readonly buffer EE_DDGI_PROBE_RAY_DATA_BLOCK {
  DdgiProbeRayData EE_DDGI_PROBE_RAY_DATA[];
};

layout(set = 1, binding = 1, rgba16f) coherent uniform image2D EE_DDGI_IRRADIANCE_ATLAS;
layout(set = 1, binding = 2, rg16f) coherent uniform image2D EE_DDGI_VISIBILITY_ATLAS;
layout(set = 1, binding = 3) writeonly buffer EE_DDGI_PROBE_METADATA_BLOCK {
  vec4 EE_DDGI_PROBE_METADATA[];
};
layout(set = 1, binding = 4) readonly buffer EE_DDGI_PROBE_STATE_BLOCK {
  vec4 EE_DDGI_PROBE_STATE[];
};
layout(set = 1, binding = 5, r16f) writeonly uniform image2D EE_DDGI_PROBE_VARIABILITY_ATLAS;

#if EE_DDGI_PROBE_USE_SHARED_RAYS
shared vec4 EE_DDGI_SHARED_PROBE_RAY_DATA[EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT];
shared vec4 EE_DDGI_SHARED_PROBE_RAY_DIRECTIONS[EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT];
#endif

layout(push_constant) uniform EE_DDGI_PROBE_UPDATE_CONSTANTS {
  uvec4 probe_count_ray_count_and_tile_sizes;
  uvec4 atlas_columns_fixed_ray_count_and_update_mode;
  uvec4 probe_counts_and_rotation;
  vec4 update_parameters;
  vec4 blend_parameters;
  ivec4 probe_scroll_offset;
  ivec4 probe_scroll_delta;
  vec4 probe_step_x;
  vec4 probe_step_y;
  vec4 probe_step_z;
};

vec4 EE_DDGI_PROBE_RAY_ROTATION() {
  return vec4(probe_step_x.w, probe_step_y.w, probe_step_z.w, uintBitsToFloat(probe_counts_and_rotation.w));
}

float EE_DDGI_DIRECTIONAL_WEIGHT(const vec3 ray_direction, const vec3 texel_direction) {
  return max(dot(normalize(ray_direction), texel_direction), 0.0f);
}

uvec2 EE_DDGI_BORDER_COPY_TEXEL(const uvec2 tile_origin, const uint tile_size, const uvec2 border_texel) {
  const uint tile_stride = EE_DDGI_ATLAS_TILE_STRIDE(tile_size);
  uvec2 copy_texel = tile_origin;
  const bool is_corner = (border_texel.x == 0u || border_texel.x == tile_stride - 1u) &&
                         (border_texel.y == 0u || border_texel.y == tile_stride - 1u);
  const bool is_row = border_texel.x > 0u && border_texel.x < tile_stride - 1u;
  if (is_corner) {
    copy_texel += uvec2(border_texel.x > 0u ? 1u : tile_size, border_texel.y > 0u ? 1u : tile_size);
  } else if (is_row) {
    copy_texel += uvec2((tile_stride - 1u) - border_texel.x,
                        border_texel.y > 0u ? border_texel.y - 1u : border_texel.y + 1u);
  } else {
    copy_texel += uvec2(border_texel.x > 0u ? border_texel.x - 1u : border_texel.x + 1u,
                        (tile_stride - 1u) - border_texel.y);
  }
  return copy_texel;
}

float EE_DDGI_MAX_COMPONENT(const vec3 value) {
  return max(value.x, max(value.y, value.z));
}

float EE_DDGI_LUMINANCE(const vec3 value) {
  return dot(value, vec3(0.2126f, 0.7152f, 0.0722f));
}

struct EeDdgiIrradianceAccumulator {
  vec3 irradiance;
  float weight_sum;
  uint backface_count;
  bool valid;
};

void EE_DDGI_INITIALIZE_IRRADIANCE_ACCUMULATOR(out EeDdgiIrradianceAccumulator accumulator) {
  accumulator.irradiance = vec3(0.0f);
  accumulator.weight_sum = 0.0f;
  accumulator.backface_count = 0u;
  accumulator.valid = true;
}

void EE_DDGI_ACCUMULATE_IRRADIANCE(inout EeDdgiIrradianceAccumulator accumulator,
                                    const DdgiProbeRayData ray_data, const vec3 ray_direction,
                                    const vec3 texel_direction, const uint max_backface_count) {
  if (!accumulator.valid) {
    return;
  }
  if (EE_DDGI_PROBE_RAY_BACKFACE_HIT(ray_data)) {
    accumulator.backface_count += 1u;
    if (accumulator.backface_count >= max_backface_count) {
      accumulator.valid = false;
    }
    return;
  }
  const float weight = EE_DDGI_DIRECTIONAL_WEIGHT(ray_direction, texel_direction);
  if (weight <= 0.0f) {
    return;
  }
  accumulator.weight_sum += weight;
  accumulator.irradiance += EE_DDGI_PROBE_RAY_RADIANCE(ray_data) * weight;
}

vec4 EE_DDGI_FINALIZE_IRRADIANCE(const EeDdgiIrradianceAccumulator accumulator,
                                  const uint blend_ray_count) {
  if (!accumulator.valid) {
    return vec4(0.0f);
  }
  const float epsilon = max(float(blend_ray_count), 1.0f) * 1e-9f;
  vec3 irradiance = accumulator.irradiance * (1.0f / (2.0f * max(accumulator.weight_sum, epsilon)));
  const float irradiance_gamma = max(update_parameters.z, 1.0f);
  irradiance = pow(min(max(irradiance, vec3(0.0f)), vec3(64.0f)), vec3(1.0f / irradiance_gamma));
  return vec4(irradiance, 1.0f);
}

vec4 EE_DDGI_DIRECTIONAL_IRRADIANCE(const uint ray_offset, const uint first_blend_ray_index, const uint ray_count,
                                     const vec3 texel_direction) {
  const uint blend_ray_count = ray_count > first_blend_ray_index ? ray_count - first_blend_ray_index : 0u;
  const uint max_backface_count =
      max(1u, uint(float(blend_ray_count) * clamp(blend_parameters.x, 0.0f, 1.0f)));
  EeDdgiIrradianceAccumulator accumulator;
  EE_DDGI_INITIALIZE_IRRADIANCE_ACCUMULATOR(accumulator);
  for (uint ray_index = first_blend_ray_index; ray_index < ray_count; ++ray_index) {
    const DdgiProbeRayData ray_data = EE_DDGI_PROBE_RAY_DATA[ray_offset + ray_index];
    const vec3 ray_direction =
        EE_DDGI_ROTATED_PROBE_RAY_DIRECTION(ray_index, ray_count, first_blend_ray_index,
                                            EE_DDGI_PROBE_RAY_ROTATION());
    EE_DDGI_ACCUMULATE_IRRADIANCE(accumulator, ray_data, ray_direction, texel_direction, max_backface_count);
    if (!accumulator.valid) {
      break;
    }
  }
  return EE_DDGI_FINALIZE_IRRADIANCE(accumulator, blend_ray_count);
}

vec4 EE_DDGI_BLEND_IRRADIANCE_HISTORY(const vec4 current_irradiance, const vec4 history_irradiance,
                                      const float history_weight) {
  if (current_irradiance.a <= 0.0f) {
    return history_irradiance;
  }

  float hysteresis = clamp(history_weight, 0.0f, 1.0f);
  if (dot(history_irradiance.rgb, history_irradiance.rgb) == 0.0f) {
    hysteresis = 0.0f;
  }

  vec3 delta = current_irradiance.rgb - history_irradiance.rgb;
  if (EE_DDGI_MAX_COMPONENT(history_irradiance.rgb - current_irradiance.rgb) > blend_parameters.w) {
    hysteresis = max(0.0f, hysteresis - 0.75f);
  }
  if (EE_DDGI_LUMINANCE(delta) > blend_parameters.z) {
    delta *= 0.25f;
  }

  const float min_darkening_step = 1.0f / 1024.0f;
  vec3 lerp_delta = (1.0f - hysteresis) * delta;
  if (EE_DDGI_MAX_COMPONENT(current_irradiance.rgb) < EE_DDGI_MAX_COMPONENT(history_irradiance.rgb)) {
    lerp_delta = min(max(vec3(min_darkening_step), abs(lerp_delta)), abs(delta)) * sign(lerp_delta);
  }
  return vec4(history_irradiance.rgb + lerp_delta, current_irradiance.a);
}

float EE_DDGI_PROBE_MAX_VISIBILITY_DISTANCE() {
  return max(length(vec3(length(probe_step_x.xyz), length(probe_step_y.xyz), length(probe_step_z.xyz))) * 1.5f,
             0.001f);
}

struct EeDdgiVisibilityAccumulator {
  float weight_sum;
  float first_moment;
  float second_moment;
};

void EE_DDGI_INITIALIZE_VISIBILITY_ACCUMULATOR(out EeDdgiVisibilityAccumulator accumulator) {
  accumulator.weight_sum = 0.0f;
  accumulator.first_moment = 0.0f;
  accumulator.second_moment = 0.0f;
}

void EE_DDGI_ACCUMULATE_VISIBILITY(inout EeDdgiVisibilityAccumulator accumulator,
                                   const DdgiProbeRayData ray_data, const vec3 ray_direction,
                                   const vec3 texel_direction, const float max_visibility_distance) {
  const float weight =
      pow(EE_DDGI_DIRECTIONAL_WEIGHT(ray_direction, texel_direction), max(blend_parameters.y, 0.0f));
  if (weight <= 0.0f) {
    return;
  }
  const float distance = min(abs(EE_DDGI_PROBE_RAY_SIGNED_DISTANCE(ray_data)), max_visibility_distance);
  accumulator.weight_sum += weight;
  accumulator.first_moment += distance * weight;
  accumulator.second_moment += distance * distance * weight;
}

vec2 EE_DDGI_FINALIZE_VISIBILITY(const EeDdgiVisibilityAccumulator accumulator,
                                  const float max_visibility_distance) {
  if (accumulator.weight_sum <= 0.0f) {
    return vec2(max_visibility_distance * 0.5f, max_visibility_distance * max_visibility_distance * 0.5f);
  }
  return vec2(accumulator.first_moment, accumulator.second_moment) * (1.0f / (2.0f * accumulator.weight_sum));
}

vec2 EE_DDGI_DIRECTIONAL_VISIBILITY_MOMENTS(const uint ray_offset, const uint first_blend_ray_index,
                                            const uint ray_count, const vec3 texel_direction) {
  const float max_visibility_distance = EE_DDGI_PROBE_MAX_VISIBILITY_DISTANCE();
  EeDdgiVisibilityAccumulator accumulator;
  EE_DDGI_INITIALIZE_VISIBILITY_ACCUMULATOR(accumulator);
  for (uint ray_index = first_blend_ray_index; ray_index < ray_count; ++ray_index) {
    const DdgiProbeRayData ray_data = EE_DDGI_PROBE_RAY_DATA[ray_offset + ray_index];
    const vec3 ray_direction =
        EE_DDGI_ROTATED_PROBE_RAY_DIRECTION(ray_index, ray_count, first_blend_ray_index,
                                            EE_DDGI_PROBE_RAY_ROTATION());
    EE_DDGI_ACCUMULATE_VISIBILITY(accumulator, ray_data, ray_direction, texel_direction, max_visibility_distance);
  }
  return EE_DDGI_FINALIZE_VISIBILITY(accumulator, max_visibility_distance);
}

void EE_DDGI_COPY_IRRADIANCE_BORDER_TEXELS(const uvec2 tile_origin, const uint tile_size) {
  const uint tile_stride = EE_DDGI_ATLAS_TILE_STRIDE(tile_size);
  for (uint y = 0u; y < tile_stride; ++y) {
    for (uint x = 0u; x < tile_stride; ++x) {
      if (x > 0u && x < tile_stride - 1u && y > 0u && y < tile_stride - 1u) {
        continue;
      }
      const ivec2 border_texel = ivec2(tile_origin + uvec2(x, y));
      const ivec2 copy_texel = ivec2(EE_DDGI_BORDER_COPY_TEXEL(tile_origin, tile_size, uvec2(x, y)));
      imageStore(EE_DDGI_IRRADIANCE_ATLAS, border_texel, imageLoad(EE_DDGI_IRRADIANCE_ATLAS, copy_texel));
    }
  }
}

void EE_DDGI_COPY_VISIBILITY_BORDER_TEXELS(const uvec2 tile_origin, const uint tile_size) {
  const uint tile_stride = EE_DDGI_ATLAS_TILE_STRIDE(tile_size);
  for (uint y = 0u; y < tile_stride; ++y) {
    for (uint x = 0u; x < tile_stride; ++x) {
      if (x > 0u && x < tile_stride - 1u && y > 0u && y < tile_stride - 1u) {
        continue;
      }
      const ivec2 border_texel = ivec2(tile_origin + uvec2(x, y));
      const ivec2 copy_texel = ivec2(EE_DDGI_BORDER_COPY_TEXEL(tile_origin, tile_size, uvec2(x, y)));
      imageStore(EE_DDGI_VISIBILITY_ATLAS, border_texel, imageLoad(EE_DDGI_VISIBILITY_ATLAS, copy_texel));
    }
  }
}

void EE_DDGI_WRITE_PROBE_METADATA(const uint ray_offset, const uint physical_probe_index,
                                  const uint ray_count, const float max_ray_distance,
                                  const float relocation_distance, const vec3 relocation_offset,
                                  const float previous_inactive) {
  vec3 irradiance = vec3(0.0f);
  float hit_count = 0.0f;
  float frontface_hit_count = 0.0f;
  float backface_hit_count = 0.0f;
  float average_distance = 0.0f;
  for (uint ray_index = 0u; ray_index < ray_count; ++ray_index) {
    const DdgiProbeRayData ray_data = EE_DDGI_PROBE_RAY_DATA[ray_offset + ray_index];
    if (EE_DDGI_PROBE_RAY_INACTIVE(ray_data) || EE_DDGI_PROBE_RAY_MISS(ray_data)) {
      continue;
    }
    hit_count += 1.0f;
    const bool backface_hit = EE_DDGI_PROBE_RAY_BACKFACE_HIT(ray_data);
    const float hit_distance = abs(EE_DDGI_PROBE_RAY_SIGNED_DISTANCE(ray_data));
    if (backface_hit) {
      backface_hit_count += 1.0f;
    } else {
      frontface_hit_count += 1.0f;
      irradiance += EE_DDGI_PROBE_RAY_RADIANCE(ray_data);
    }
    average_distance += hit_distance;
  }
  if (frontface_hit_count > 0.0f) {
    irradiance /= frontface_hit_count;
  }
  average_distance = hit_count > 0.0f ? average_distance / hit_count : max_ray_distance;
  irradiance = pow(min(max(irradiance, vec3(0.0f)), vec3(64.0f)),
                   vec3(1.0f / max(update_parameters.z, 1.0f)));
  if (previous_inactive > 0.5f) {
    irradiance = vec3(0.0f);
  }
  const uint metadata_offset = physical_probe_index * 3u;
  EE_DDGI_PROBE_METADATA[metadata_offset] = vec4(irradiance, hit_count / float(ray_count));
  EE_DDGI_PROBE_METADATA[metadata_offset + 1u] =
      vec4(clamp(average_distance / max_ray_distance, 0.0f, 1.0f), backface_hit_count / float(ray_count),
           relocation_distance > 0.0f ? clamp(length(relocation_offset) / relocation_distance, 0.0f, 1.0f) : 0.0f,
           1.0f - previous_inactive);
  EE_DDGI_PROBE_METADATA[metadata_offset + 2u] = vec4(relocation_offset, 1.0f - previous_inactive);
}

#if EE_DDGI_PROBE_UPDATE_MODE == EE_DDGI_PROBE_UPDATE_SERIAL
void main() {
  const uint group_index = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  const uint probe_index = group_index * EE_DDGI_PROBE_UPDATE_GROUP_SIZE + gl_LocalInvocationIndex;
  const uint probe_count = max(probe_count_ray_count_and_tile_sizes.x, 1u);
  if (probe_index >= probe_count) {
    return;
  }
  const uvec3 total_probe_counts = max(probe_counts_and_rotation.xyz, uvec3(1u));
  const uint probes_per_layer = total_probe_counts.x * total_probe_counts.y;
  const uvec3 logical_probe_grid =
      uvec3(probe_index % total_probe_counts.x, (probe_index / total_probe_counts.x) % total_probe_counts.y,
            probe_index / probes_per_layer);
  const uvec3 physical_probe_grid =
      EE_DDGI_SCROLL_PROBE_GRID(logical_probe_grid, probe_scroll_offset.xyz, total_probe_counts);
  const uint physical_probe_index = EE_DDGI_PROBE_INDEX(physical_probe_grid, total_probe_counts);
  const uint ray_count = max(probe_count_ray_count_and_tile_sizes.y, 1u);
  const uint irradiance_tile_size = max(probe_count_ray_count_and_tile_sizes.z, 1u);
  const uint visibility_tile_size = max(probe_count_ray_count_and_tile_sizes.w, 1u);
  const float max_ray_distance = max(update_parameters.x, 0.001f);
  const float relocation_distance = max(update_parameters.w, 0.0f);
  const uint fixed_ray_count = min(atlas_columns_fixed_ray_count_and_update_mode.z, ray_count);
  const uint first_blend_ray_index = fixed_ray_count;
  const uint irradiance_columns = max(atlas_columns_fixed_ray_count_and_update_mode.x, 1u);
  const uint visibility_columns = max(atlas_columns_fixed_ray_count_and_update_mode.y, 1u);
  const uvec2 irradiance_tile_origin = uvec2(physical_probe_index % irradiance_columns,
                                             physical_probe_index / irradiance_columns) *
                                       EE_DDGI_ATLAS_TILE_STRIDE(irradiance_tile_size);
  const uvec2 variability_tile_origin = uvec2(physical_probe_index % irradiance_columns,
                                              physical_probe_index / irradiance_columns) *
                                        irradiance_tile_size;
  const uvec2 visibility_tile_origin = uvec2(physical_probe_index % visibility_columns,
                                             physical_probe_index / visibility_columns) *
                                       EE_DDGI_ATLAS_TILE_STRIDE(visibility_tile_size);
  const uint ray_offset = probe_index * ray_count;
  const bool update_irradiance = atlas_columns_fixed_ray_count_and_update_mode.w == 1u;
  const bool update_visibility = atlas_columns_fixed_ray_count_and_update_mode.w == 2u;
  const vec4 previous_state = EE_DDGI_PROBE_STATE[physical_probe_index];
  const float previous_inactive = clamp(previous_state.w, 0.0f, 1.0f);
  const vec3 relocation_offset = previous_state.xyz;
  const vec2 visibility_auxiliary =
      vec2(relocation_distance > 0.0f ? clamp(length(relocation_offset) / relocation_distance, 0.0f, 1.0f) : 0.0f,
           1.0f - previous_inactive);

  const bool blend_previous_probe_state = previous_inactive <= 0.5f;
  const bool newly_exposed_probe =
      EE_DDGI_PROBE_IS_NEWLY_EXPOSED(logical_probe_grid, probe_scroll_delta.xyz, total_probe_counts);
  const float history_weight =
      blend_previous_probe_state && !newly_exposed_probe ? clamp(update_parameters.y, 0.0f, 1.0f) : 0.0f;
  if (update_irradiance) {
    EE_DDGI_WRITE_PROBE_METADATA(ray_offset, physical_probe_index, ray_count, max_ray_distance,
                                 relocation_distance, relocation_offset, previous_inactive);
  }

  if (blend_previous_probe_state) {
    if (update_irradiance) {
      for (uint y = 0u; y < irradiance_tile_size; ++y) {
        for (uint x = 0u; x < irradiance_tile_size; ++x) {
          const vec3 texel_direction = EE_DDGI_OCTAHEDRAL_DIRECTION(uvec2(x, y), irradiance_tile_size);
          vec4 directional_irradiance =
              EE_DDGI_DIRECTIONAL_IRRADIANCE(ray_offset, first_blend_ray_index, ray_count, texel_direction);
          const ivec2 atlas_texel = ivec2(irradiance_tile_origin + uvec2(1u + x, 1u + y));
          const ivec2 variability_texel = ivec2(variability_tile_origin + uvec2(x, y));
          vec4 history_irradiance = imageLoad(EE_DDGI_IRRADIANCE_ATLAS, atlas_texel);
          if (directional_irradiance.a <= 0.0f) {
            continue;
          }
          const vec3 irradiance_sample = directional_irradiance.rgb;
          directional_irradiance =
              EE_DDGI_BLEND_IRRADIANCE_HISTORY(directional_irradiance, history_irradiance, history_weight);
          const vec3 irradiance_sigma2 =
              (irradiance_sample - history_irradiance.rgb) * (irradiance_sample - directional_irradiance.rgb);
          const float luminance_sigma2 = EE_DDGI_LUMINANCE(irradiance_sigma2);
          const float mean_luminance = EE_DDGI_LUMINANCE(directional_irradiance.rgb);
          const float coefficient_of_variation =
              mean_luminance <= (1.0f / 1024.0f) ? 0.0f : sqrt(max(luminance_sigma2, 0.0f)) / mean_luminance;
          imageStore(EE_DDGI_IRRADIANCE_ATLAS, atlas_texel, directional_irradiance);
          imageStore(EE_DDGI_PROBE_VARIABILITY_ATLAS, variability_texel,
                     vec4(coefficient_of_variation, 0.0f, 0.0f, 0.0f));
        }
      }
      memoryBarrierImage();
      EE_DDGI_COPY_IRRADIANCE_BORDER_TEXELS(irradiance_tile_origin, irradiance_tile_size);
    }

    if (update_visibility) {
      for (uint y = 0u; y < visibility_tile_size; ++y) {
        for (uint x = 0u; x < visibility_tile_size; ++x) {
          const vec3 texel_direction = EE_DDGI_OCTAHEDRAL_DIRECTION(uvec2(x, y), visibility_tile_size);
          const vec2 directional_visibility =
              EE_DDGI_DIRECTIONAL_VISIBILITY_MOMENTS(ray_offset, first_blend_ray_index, ray_count, texel_direction);
          const ivec2 atlas_texel = ivec2(visibility_tile_origin + uvec2(1u + x, 1u + y));
          vec2 history_visibility = imageLoad(EE_DDGI_VISIBILITY_ATLAS, atlas_texel).rg;
          const vec2 visibility_moments = mix(directional_visibility, history_visibility, history_weight);
          imageStore(EE_DDGI_VISIBILITY_ATLAS, atlas_texel, vec4(visibility_moments, visibility_auxiliary));
        }
      }
      memoryBarrierImage();
      EE_DDGI_COPY_VISIBILITY_BORDER_TEXELS(visibility_tile_origin, visibility_tile_size);
    }
  } else if (update_irradiance) {
    for (uint y = 0u; y < irradiance_tile_size; ++y) {
      for (uint x = 0u; x < irradiance_tile_size; ++x) {
        imageStore(EE_DDGI_PROBE_VARIABILITY_ATLAS, ivec2(variability_tile_origin + uvec2(x, y)), vec4(0.0f));
      }
    }
  }
}
#else
uvec2 EE_DDGI_PARALLEL_BORDER_TEXEL(const uint tile_size, const uint border_index) {
  const uint tile_stride = EE_DDGI_ATLAS_TILE_STRIDE(tile_size);
  if (border_index < tile_stride) {
    return uvec2(border_index, 0u);
  }
  if (border_index < 2u * tile_stride) {
    return uvec2(border_index - tile_stride, tile_stride - 1u);
  }
  const uint column_index = border_index - 2u * tile_stride;
  if (column_index < tile_size) {
    return uvec2(0u, column_index + 1u);
  }
  return uvec2(tile_stride - 1u, column_index - tile_size + 1u);
}

void EE_DDGI_COPY_IRRADIANCE_BORDER_TEXELS_PARALLEL(const uvec2 tile_origin, const uint tile_size,
                                                     const uint lane_index) {
  const uint border_texel_count = 4u * tile_size + 4u;
  for (uint border_index = lane_index; border_index < border_texel_count;
       border_index += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
    const uvec2 border_texel = EE_DDGI_PARALLEL_BORDER_TEXEL(tile_size, border_index);
    const ivec2 destination = ivec2(tile_origin + border_texel);
    const ivec2 source = ivec2(EE_DDGI_BORDER_COPY_TEXEL(tile_origin, tile_size, border_texel));
    imageStore(EE_DDGI_IRRADIANCE_ATLAS, destination, imageLoad(EE_DDGI_IRRADIANCE_ATLAS, source));
  }
}

void EE_DDGI_COPY_VISIBILITY_BORDER_TEXELS_PARALLEL(const uvec2 tile_origin, const uint tile_size,
                                                     const uint lane_index) {
  const uint border_texel_count = 4u * tile_size + 4u;
  for (uint border_index = lane_index; border_index < border_texel_count;
       border_index += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
    const uvec2 border_texel = EE_DDGI_PARALLEL_BORDER_TEXEL(tile_size, border_index);
    const ivec2 destination = ivec2(tile_origin + border_texel);
    const ivec2 source = ivec2(EE_DDGI_BORDER_COPY_TEXEL(tile_origin, tile_size, border_texel));
    imageStore(EE_DDGI_VISIBILITY_ATLAS, destination, imageLoad(EE_DDGI_VISIBILITY_ATLAS, source));
  }
}

void EE_DDGI_STORE_IRRADIANCE_TEXEL(const uvec2 tile_origin, const uvec2 variability_origin,
                                     const uint tile_size, const uint texel_index,
                                     vec4 directional_irradiance, const float history_weight) {
  if (directional_irradiance.a <= 0.0f) {
    return;
  }
  const uvec2 texel = uvec2(texel_index % tile_size, texel_index / tile_size);
  const ivec2 atlas_texel = ivec2(tile_origin + uvec2(1u) + texel);
  const ivec2 variability_texel = ivec2(variability_origin + texel);
  const vec4 history_irradiance = imageLoad(EE_DDGI_IRRADIANCE_ATLAS, atlas_texel);
  const vec3 irradiance_sample = directional_irradiance.rgb;
  directional_irradiance =
      EE_DDGI_BLEND_IRRADIANCE_HISTORY(directional_irradiance, history_irradiance, history_weight);
  const vec3 irradiance_sigma2 =
      (irradiance_sample - history_irradiance.rgb) * (irradiance_sample - directional_irradiance.rgb);
  const float luminance_sigma2 = EE_DDGI_LUMINANCE(irradiance_sigma2);
  const float mean_luminance = EE_DDGI_LUMINANCE(directional_irradiance.rgb);
  const float coefficient_of_variation =
      mean_luminance <= (1.0f / 1024.0f) ? 0.0f : sqrt(max(luminance_sigma2, 0.0f)) / mean_luminance;
  imageStore(EE_DDGI_IRRADIANCE_ATLAS, atlas_texel, directional_irradiance);
  imageStore(EE_DDGI_PROBE_VARIABILITY_ATLAS, variability_texel,
             vec4(coefficient_of_variation, 0.0f, 0.0f, 0.0f));
}

void EE_DDGI_STORE_VISIBILITY_TEXEL(const uvec2 tile_origin, const uint tile_size, const uint texel_index,
                                    const vec2 directional_visibility, const float history_weight,
                                    const vec2 visibility_auxiliary) {
  const uvec2 texel = uvec2(texel_index % tile_size, texel_index / tile_size);
  const ivec2 atlas_texel = ivec2(tile_origin + uvec2(1u) + texel);
  const vec2 history_visibility = imageLoad(EE_DDGI_VISIBILITY_ATLAS, atlas_texel).rg;
  const vec2 visibility_moments = mix(directional_visibility, history_visibility, history_weight);
  imageStore(EE_DDGI_VISIBILITY_ATLAS, atlas_texel, vec4(visibility_moments, visibility_auxiliary));
}

void EE_DDGI_UPDATE_IRRADIANCE_DIRECT(const uint ray_offset, const uint first_blend_ray_index,
                                      const uint ray_count, const uvec2 tile_origin,
                                      const uvec2 variability_origin, const uint tile_size,
                                      const float history_weight, const uint lane_index) {
  const uint texel_count = tile_size * tile_size;
  for (uint texel_index = lane_index; texel_index < texel_count;
       texel_index += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
    const uvec2 texel = uvec2(texel_index % tile_size, texel_index / tile_size);
    const vec3 texel_direction = EE_DDGI_OCTAHEDRAL_DIRECTION(texel, tile_size);
    const vec4 directional_irradiance =
        EE_DDGI_DIRECTIONAL_IRRADIANCE(ray_offset, first_blend_ray_index, ray_count, texel_direction);
    EE_DDGI_STORE_IRRADIANCE_TEXEL(tile_origin, variability_origin, tile_size, texel_index,
                                   directional_irradiance, history_weight);
  }
}

void EE_DDGI_UPDATE_VISIBILITY_DIRECT(const uint ray_offset, const uint first_blend_ray_index,
                                      const uint ray_count, const uvec2 tile_origin, const uint tile_size,
                                      const float history_weight, const vec2 visibility_auxiliary,
                                      const uint lane_index) {
  const uint texel_count = tile_size * tile_size;
  for (uint texel_index = lane_index; texel_index < texel_count;
       texel_index += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
    const uvec2 texel = uvec2(texel_index % tile_size, texel_index / tile_size);
    const vec3 texel_direction = EE_DDGI_OCTAHEDRAL_DIRECTION(texel, tile_size);
    const vec2 directional_visibility =
        EE_DDGI_DIRECTIONAL_VISIBILITY_MOMENTS(ray_offset, first_blend_ray_index, ray_count, texel_direction);
    EE_DDGI_STORE_VISIBILITY_TEXEL(tile_origin, tile_size, texel_index, directional_visibility,
                                   history_weight, visibility_auxiliary);
  }
}

#if EE_DDGI_PROBE_USE_SHARED_RAYS
void EE_DDGI_CACHE_RAY_CHUNK(const uint ray_offset, const uint chunk_base, const uint chunk_count,
                             const uint ray_count, const uint first_blend_ray_index, const uint lane_index) {
  for (uint chunk_index = lane_index; chunk_index < chunk_count;
       chunk_index += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
    const uint ray_index = chunk_base + chunk_index;
    EE_DDGI_SHARED_PROBE_RAY_DATA[chunk_index] =
        EE_DDGI_PROBE_RAY_DATA[ray_offset + ray_index].radiance_and_signed_distance;
    EE_DDGI_SHARED_PROBE_RAY_DIRECTIONS[chunk_index] =
        vec4(EE_DDGI_ROTATED_PROBE_RAY_DIRECTION(ray_index, ray_count, first_blend_ray_index,
                                                 EE_DDGI_PROBE_RAY_ROTATION()),
             0.0f);
  }
}

void EE_DDGI_UPDATE_IRRADIANCE_SHARED(const uint ray_offset, const uint first_blend_ray_index,
                                      const uint ray_count, const uvec2 tile_origin,
                                      const uvec2 variability_origin, const uint tile_size,
                                      const float history_weight, const uint lane_index) {
  const uint texel_count = tile_size * tile_size;
  const uint blend_ray_count = ray_count > first_blend_ray_index ? ray_count - first_blend_ray_index : 0u;
  const uint max_backface_count =
      max(1u, uint(float(blend_ray_count) * clamp(blend_parameters.x, 0.0f, 1.0f)));
  for (uint batch_base = 0u; batch_base < texel_count;
       batch_base += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
    const uint texel_index = batch_base + lane_index;
    const bool active_texel = texel_index < texel_count;
    const uvec2 texel = uvec2(texel_index % tile_size, texel_index / tile_size);
    const vec3 texel_direction = EE_DDGI_OCTAHEDRAL_DIRECTION(texel, tile_size);
    EeDdgiIrradianceAccumulator accumulator;
    EE_DDGI_INITIALIZE_IRRADIANCE_ACCUMULATOR(accumulator);
    for (uint chunk_base = first_blend_ray_index; chunk_base < ray_count;
         chunk_base += EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT) {
      const uint chunk_count = min(EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT, ray_count - chunk_base);
      EE_DDGI_CACHE_RAY_CHUNK(ray_offset, chunk_base, chunk_count, ray_count, first_blend_ray_index,
                              lane_index);
      barrier();
      if (active_texel) {
        for (uint chunk_index = 0u; chunk_index < chunk_count; ++chunk_index) {
          DdgiProbeRayData ray_data;
          ray_data.radiance_and_signed_distance = EE_DDGI_SHARED_PROBE_RAY_DATA[chunk_index];
          EE_DDGI_ACCUMULATE_IRRADIANCE(accumulator, ray_data,
                                        EE_DDGI_SHARED_PROBE_RAY_DIRECTIONS[chunk_index].xyz,
                                        texel_direction, max_backface_count);
        }
      }
      barrier();
    }
    if (active_texel) {
      EE_DDGI_STORE_IRRADIANCE_TEXEL(tile_origin, variability_origin, tile_size, texel_index,
                                     EE_DDGI_FINALIZE_IRRADIANCE(accumulator, blend_ray_count),
                                     history_weight);
    }
  }
}

void EE_DDGI_UPDATE_VISIBILITY_SHARED(const uint ray_offset, const uint first_blend_ray_index,
                                      const uint ray_count, const uvec2 tile_origin, const uint tile_size,
                                      const float history_weight, const vec2 visibility_auxiliary,
                                      const uint lane_index) {
  const uint texels_per_lane = 4u;
  const uint texel_count = tile_size * tile_size;
  const float max_visibility_distance = EE_DDGI_PROBE_MAX_VISIBILITY_DISTANCE();
  for (uint batch_base = 0u; batch_base < texel_count;
       batch_base += EE_DDGI_PROBE_UPDATE_GROUP_SIZE * texels_per_lane) {
    uint texel_indices[4];
    bool active_texels[4];
    vec3 texel_directions[4];
    EeDdgiVisibilityAccumulator accumulators[4];
    for (uint texel_slot = 0u; texel_slot < texels_per_lane; ++texel_slot) {
      texel_indices[texel_slot] =
          batch_base + lane_index + texel_slot * EE_DDGI_PROBE_UPDATE_GROUP_SIZE;
      active_texels[texel_slot] = texel_indices[texel_slot] < texel_count;
      const uvec2 texel =
          uvec2(texel_indices[texel_slot] % tile_size, texel_indices[texel_slot] / tile_size);
      texel_directions[texel_slot] = EE_DDGI_OCTAHEDRAL_DIRECTION(texel, tile_size);
      EE_DDGI_INITIALIZE_VISIBILITY_ACCUMULATOR(accumulators[texel_slot]);
    }
    for (uint chunk_base = first_blend_ray_index; chunk_base < ray_count;
         chunk_base += EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT) {
      const uint chunk_count = min(EE_DDGI_PROBE_UPDATE_SHARED_RAY_COUNT, ray_count - chunk_base);
      EE_DDGI_CACHE_RAY_CHUNK(ray_offset, chunk_base, chunk_count, ray_count, first_blend_ray_index,
                              lane_index);
      barrier();
      for (uint chunk_index = 0u; chunk_index < chunk_count; ++chunk_index) {
        DdgiProbeRayData ray_data;
        ray_data.radiance_and_signed_distance = EE_DDGI_SHARED_PROBE_RAY_DATA[chunk_index];
        for (uint texel_slot = 0u; texel_slot < texels_per_lane; ++texel_slot) {
          if (active_texels[texel_slot]) {
            EE_DDGI_ACCUMULATE_VISIBILITY(accumulators[texel_slot], ray_data,
                                          EE_DDGI_SHARED_PROBE_RAY_DIRECTIONS[chunk_index].xyz,
                                          texel_directions[texel_slot], max_visibility_distance);
          }
        }
      }
      barrier();
    }
    for (uint texel_slot = 0u; texel_slot < texels_per_lane; ++texel_slot) {
      if (active_texels[texel_slot]) {
        EE_DDGI_STORE_VISIBILITY_TEXEL(
            tile_origin, tile_size, texel_indices[texel_slot],
            EE_DDGI_FINALIZE_VISIBILITY(accumulators[texel_slot], max_visibility_distance),
            history_weight, visibility_auxiliary);
      }
    }
  }
}
#endif

void main() {
  const uint lane_index = gl_LocalInvocationIndex;
  const uint probe_index = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
  const uint probe_count = max(probe_count_ray_count_and_tile_sizes.x, 1u);
  if (probe_index >= probe_count) {
    return;
  }
  const uvec3 total_probe_counts = max(probe_counts_and_rotation.xyz, uvec3(1u));
  const uint probes_per_layer = total_probe_counts.x * total_probe_counts.y;
  const uvec3 logical_probe_grid =
      uvec3(probe_index % total_probe_counts.x, (probe_index / total_probe_counts.x) % total_probe_counts.y,
            probe_index / probes_per_layer);
  const uvec3 physical_probe_grid =
      EE_DDGI_SCROLL_PROBE_GRID(logical_probe_grid, probe_scroll_offset.xyz, total_probe_counts);
  const uint physical_probe_index = EE_DDGI_PROBE_INDEX(physical_probe_grid, total_probe_counts);
  const uint ray_count = max(probe_count_ray_count_and_tile_sizes.y, 1u);
  const uint fixed_ray_count = min(atlas_columns_fixed_ray_count_and_update_mode.z, ray_count);
  const uint first_blend_ray_index = fixed_ray_count;
  const uint ray_offset = probe_index * ray_count;
  const vec4 previous_state = EE_DDGI_PROBE_STATE[physical_probe_index];
  const float previous_inactive = clamp(previous_state.w, 0.0f, 1.0f);
  const vec3 relocation_offset = previous_state.xyz;
  const float relocation_distance = max(update_parameters.w, 0.0f);
  const vec2 visibility_auxiliary =
      vec2(relocation_distance > 0.0f ? clamp(length(relocation_offset) / relocation_distance, 0.0f, 1.0f) : 0.0f,
           1.0f - previous_inactive);
  const bool blend_previous_probe_state = previous_inactive <= 0.5f;
  const bool newly_exposed_probe =
      EE_DDGI_PROBE_IS_NEWLY_EXPOSED(logical_probe_grid, probe_scroll_delta.xyz, total_probe_counts);
  const float history_weight =
      blend_previous_probe_state && !newly_exposed_probe ? clamp(update_parameters.y, 0.0f, 1.0f) : 0.0f;

#if EE_DDGI_PROBE_UPDATE_MODE == EE_DDGI_PROBE_UPDATE_IRRADIANCE
  const uint tile_size = max(probe_count_ray_count_and_tile_sizes.z, 1u);
  const uint atlas_columns = max(atlas_columns_fixed_ray_count_and_update_mode.x, 1u);
  const uvec2 tile_origin =
      uvec2(physical_probe_index % atlas_columns, physical_probe_index / atlas_columns) *
      EE_DDGI_ATLAS_TILE_STRIDE(tile_size);
  const uvec2 variability_origin =
      uvec2(physical_probe_index % atlas_columns, physical_probe_index / atlas_columns) * tile_size;
  if (lane_index == 0u) {
    EE_DDGI_WRITE_PROBE_METADATA(ray_offset, physical_probe_index, ray_count,
                                 max(update_parameters.x, 0.001f), relocation_distance,
                                 relocation_offset, previous_inactive);
  }
  if (blend_previous_probe_state) {
#if EE_DDGI_PROBE_USE_SHARED_RAYS
    EE_DDGI_UPDATE_IRRADIANCE_SHARED(ray_offset, first_blend_ray_index, ray_count, tile_origin,
                                     variability_origin, tile_size, history_weight, lane_index);
#else
    EE_DDGI_UPDATE_IRRADIANCE_DIRECT(ray_offset, first_blend_ray_index, ray_count, tile_origin,
                                     variability_origin, tile_size, history_weight, lane_index);
#endif
    groupMemoryBarrier();
    barrier();
    EE_DDGI_COPY_IRRADIANCE_BORDER_TEXELS_PARALLEL(tile_origin, tile_size, lane_index);
  } else {
    const uint texel_count = tile_size * tile_size;
    for (uint texel_index = lane_index; texel_index < texel_count;
         texel_index += EE_DDGI_PROBE_UPDATE_GROUP_SIZE) {
      const uvec2 texel = uvec2(texel_index % tile_size, texel_index / tile_size);
      imageStore(EE_DDGI_PROBE_VARIABILITY_ATLAS, ivec2(variability_origin + texel), vec4(0.0f));
    }
  }
#elif EE_DDGI_PROBE_UPDATE_MODE == EE_DDGI_PROBE_UPDATE_VISIBILITY
  const uint tile_size = max(probe_count_ray_count_and_tile_sizes.w, 1u);
  const uint atlas_columns = max(atlas_columns_fixed_ray_count_and_update_mode.y, 1u);
  const uvec2 tile_origin =
      uvec2(physical_probe_index % atlas_columns, physical_probe_index / atlas_columns) *
      EE_DDGI_ATLAS_TILE_STRIDE(tile_size);
  if (blend_previous_probe_state) {
#if EE_DDGI_PROBE_USE_SHARED_RAYS
    EE_DDGI_UPDATE_VISIBILITY_SHARED(ray_offset, first_blend_ray_index, ray_count, tile_origin, tile_size,
                                     history_weight, visibility_auxiliary, lane_index);
#else
    EE_DDGI_UPDATE_VISIBILITY_DIRECT(ray_offset, first_blend_ray_index, ray_count, tile_origin, tile_size,
                                     history_weight, visibility_auxiliary, lane_index);
#endif
    groupMemoryBarrier();
    barrier();
    EE_DDGI_COPY_VISIBILITY_BORDER_TEXELS_PARALLEL(tile_origin, tile_size, lane_index);
  }
#endif
}
#endif
