#extension GL_ARB_shading_language_include : enable

#include "PerFrame.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 1, binding = 17) uniform sampler2D inDepth;
layout(set = 1, binding = 21) uniform sampler2D inNormalRoughness;
layout(set = 2, binding = 0) uniform sampler2D currentColor;
layout(set = 2, binding = 1) uniform sampler2D historyColor;
layout(set = 2, binding = 2, rgba32f) uniform writeonly image2D outColor;
layout(set = 2, binding = 3, rgba32f) uniform writeonly image2D outHistory;

layout(push_constant) uniform EE_TAA_CONSTANTS {
  int EE_CAMERA_INDEX;
  int historyValid;
  float feedback;
  float clampStrength;
  float sharpen;
};

vec3 FetchCurrent(ivec2 texel, ivec2 maxTexel) {
  return texelFetch(currentColor, clamp(texel, ivec2(0), maxTexel), 0).rgb;
}

void NeighborhoodStats(ivec2 texel, ivec2 maxTexel, out vec3 minColor, out vec3 maxColor, out vec3 averageColor) {
  minColor = vec3(1e20f);
  maxColor = vec3(-1e20f);
  averageColor = vec3(0.0f);
  for (int y = -1; y <= 1; ++y) {
    for (int x = -1; x <= 1; ++x) {
      vec3 color = FetchCurrent(texel + ivec2(x, y), maxTexel);
      minColor = min(minColor, color);
      maxColor = max(maxColor, color);
      averageColor += color;
    }
  }
  averageColor /= 9.0f;
}

bool ReprojectHistory(vec2 texCoord, float ndcDepth, out vec2 previousTexCoord) {
  if (ndcDepth == 1.0f) {
    return false;
  }
  vec3 worldPos = EE_DEPTH_TO_WORLD_POS(EE_CAMERA_INDEX, texCoord, ndcDepth);
  vec4 previousClip = EE_CAMERAS[EE_CAMERA_INDEX].previous_projection_view * vec4(worldPos, 1.0f);
  if (previousClip.w <= 0.0001f) {
    return false;
  }
  vec3 previousNdc = previousClip.xyz / previousClip.w;
  previousTexCoord = previousNdc.xy * 0.5f + vec2(0.5f);
  return previousTexCoord.x >= 0.0f && previousTexCoord.x <= 1.0f && previousTexCoord.y >= 0.0f &&
         previousTexCoord.y <= 1.0f && previousNdc.z >= -0.001f && previousNdc.z <= 1.001f;
}

void main() {
  uvec2 pixel = gl_GlobalInvocationID.xy;
  uvec2 resolution = uvec2(imageSize(outColor));
  if (pixel.x >= resolution.x || pixel.y >= resolution.y) {
    return;
  }

  ivec2 texel = ivec2(pixel);
  ivec2 maxTexel = ivec2(resolution) - ivec2(1);
  vec2 texCoord = (vec2(pixel) + vec2(0.5f)) / vec2(resolution);
  vec3 current = texelFetch(currentColor, texel, 0).rgb;
  vec3 minColor;
  vec3 maxColor;
  vec3 averageColor;
  NeighborhoodStats(texel, maxTexel, minColor, maxColor, averageColor);

  vec3 result = current;
  vec2 previousTexCoord;
  float ndcDepth = texture(inDepth, texCoord).x;
  if (historyValid != 0 && ReprojectHistory(texCoord, ndcDepth, previousTexCoord)) {
    vec3 history = texture(historyColor, previousTexCoord).rgb;
    vec3 center = (minColor + maxColor) * 0.5f;
    vec3 extent = (maxColor - minColor) * 0.5f * max(clampStrength, 0.0f);
    history = clamp(history, center - extent, center + extent);
    result = mix(current, history, clamp(feedback, 0.0f, 0.98f));
  }

  result += (current - averageColor) * max(sharpen, 0.0f);
  vec4 outputColor = vec4(max(result, vec3(0.0f)), 1.0f);
  imageStore(outColor, texel, outputColor);
  imageStore(outHistory, texel, outputColor);
}
