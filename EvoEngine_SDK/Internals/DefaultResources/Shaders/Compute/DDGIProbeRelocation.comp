#extension GL_ARB_shading_language_include : enable
#include "DDGI.glsl"
#include "DDGIProbeRayData.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer EE_DDGI_PROBE_RAY_DATA_BLOCK {
  DdgiProbeRayData EE_DDGI_PROBE_RAY_DATA[];
};
layout(set = 0, binding = 1) buffer EE_DDGI_PROBE_STATE_BLOCK {
  vec4 EE_DDGI_PROBE_STATE[];
};
layout(push_constant) uniform EE_DDGI_PROBE_RELOCATION_CONSTANTS {
  uvec4 probe_count_ray_count_and_flags;
  uvec4 probe_counts;
  vec4 relocation_parameters;
  ivec4 probe_scroll_offset;
  vec4 probe_step_x;
  vec4 probe_step_y;
  vec4 probe_step_z;
};

void main() {
  const uint probe_index = gl_GlobalInvocationID.x;
  const uint dispatch_probe_count = max(probe_count_ray_count_and_flags.x, 1u);
  const uint ray_count = max(probe_count_ray_count_and_flags.y, 1u);
  const bool reset_offsets = probe_count_ray_count_and_flags.w != 0u;
  if (probe_index >= dispatch_probe_count) {
    return;
  }

  if (reset_offsets) {
    EE_DDGI_PROBE_STATE[probe_index].xyz = vec3(0.0f);
    return;
  }

  const uvec3 total_probe_counts = max(probe_counts.xyz, uvec3(1u));
  const uint probes_per_layer = total_probe_counts.x * total_probe_counts.y;
  const uvec3 logical_probe_grid =
      uvec3(probe_index % total_probe_counts.x, (probe_index / total_probe_counts.x) % total_probe_counts.y,
            probe_index / probes_per_layer);
  const uint physical_probe_index =
      EE_DDGI_SCROLL_PROBE_INDEX(logical_probe_grid, probe_scroll_offset.xyz, total_probe_counts);
  const float relocation_distance = max(relocation_parameters.x, 0.0f);
  const float fixed_ray_backface_threshold = clamp(relocation_parameters.y, 0.0f, 1.0f);
  if (relocation_distance <= 0.0f) {
    EE_DDGI_PROBE_STATE[physical_probe_index].xyz = vec3(0.0f);
    return;
  }

  vec3 relocation_offset = EE_DDGI_PROBE_STATE[physical_probe_index].xyz;
  const uint fixed_ray_count = min(probe_counts.w, ray_count);
  if (fixed_ray_count == 0u) {
    return;
  }

  const uint invalid_ray_index = 0xffffffffu;
  uint closest_backface_ray_index = invalid_ray_index;
  uint closest_frontface_ray_index = invalid_ray_index;
  uint farthest_frontface_ray_index = invalid_ray_index;
  float closest_backface_distance = 1e27f;
  float closest_frontface_distance = 1e27f;
  float farthest_frontface_distance = 0.0f;
  float backface_count = 0.0f;
  const uint ray_offset = probe_index * ray_count;
  for (uint ray_index = 0u; ray_index < fixed_ray_count; ++ray_index) {
    const DdgiProbeRayData ray_data = EE_DDGI_PROBE_RAY_DATA[ray_offset + ray_index];
    if (!EE_DDGI_PROBE_RAY_HIT(ray_data)) {
      continue;
    }

    const float signed_hit_distance = EE_DDGI_PROBE_RAY_SIGNED_DISTANCE(ray_data);
    float hit_distance = abs(signed_hit_distance);
    if (EE_DDGI_PROBE_RAY_BACKFACE_HIT(ray_data)) {
      backface_count += 1.0f;
      hit_distance *= 5.0f;
      if (hit_distance < closest_backface_distance) {
        closest_backface_distance = hit_distance;
        closest_backface_ray_index = ray_index;
      }
    } else {
      if (hit_distance < closest_frontface_distance) {
        closest_frontface_distance = hit_distance;
        closest_frontface_ray_index = ray_index;
      } else if (hit_distance > farthest_frontface_distance) {
        farthest_frontface_distance = hit_distance;
        farthest_frontface_ray_index = ray_index;
      }
    }
  }

  vec3 candidate_offset = vec3(1e27f);
  if (closest_backface_ray_index != invalid_ray_index &&
      backface_count / float(fixed_ray_count) > fixed_ray_backface_threshold) {
    const vec3 closest_backface_direction =
        EE_DDGI_PROBE_RAY_DIRECTION(closest_backface_ray_index, ray_count, fixed_ray_count);
    candidate_offset =
        relocation_offset + closest_backface_direction * (closest_backface_distance + relocation_distance * 0.5f);
  } else if (closest_frontface_ray_index != invalid_ray_index && closest_frontface_distance < relocation_distance &&
             farthest_frontface_ray_index != invalid_ray_index) {
    const vec3 closest_frontface_direction =
        EE_DDGI_PROBE_RAY_DIRECTION(closest_frontface_ray_index, ray_count, fixed_ray_count);
    const vec3 farthest_frontface_direction =
        EE_DDGI_PROBE_RAY_DIRECTION(farthest_frontface_ray_index, ray_count, fixed_ray_count);
    if (dot(closest_frontface_direction, farthest_frontface_direction) <= 0.0f) {
      candidate_offset = relocation_offset + farthest_frontface_direction * min(farthest_frontface_distance, 1.0f);
    }
  } else if (closest_frontface_distance > relocation_distance) {
    const float relocation_offset_length = length(relocation_offset);
    if (relocation_offset_length > 0.0001f) {
      const float move_back_margin = min(closest_frontface_distance - relocation_distance, relocation_offset_length);
      candidate_offset = relocation_offset - relocation_offset / relocation_offset_length * move_back_margin;
    } else {
      candidate_offset = vec3(0.0f);
    }
  }

  if (EE_DDGI_RELOCATION_OFFSET_INSIDE_VOXEL(candidate_offset, probe_step_x.xyz, probe_step_y.xyz, probe_step_z.xyz)) {
    relocation_offset = candidate_offset;
  }
  EE_DDGI_PROBE_STATE[physical_probe_index].xyz = relocation_offset;
}
