#ifndef EE_RAY_TRACING_MATERIAL_SLANGH
#define EE_RAY_TRACING_MATERIAL_SLANGH

#include "GltfRasterMaterial.slangh"

struct EeRayTracingSurfaceAttributes {
  vec3 position;
  vec3 normal;
  vec3 tangent;
  float tangent_handedness;
  vec4 vertex_color;
  GltfTexCoords tex_coords;
};

vec3 EE_RT_SAFE_NORMALIZE(const vec3 value, const vec3 fallback) {
  if (any(isnan(value)) || any(isinf(value))) {
    return fallback;
  }
  const float scale = max(max(abs(value.x), abs(value.y)), abs(value.z));
  if (scale == 0.0f) {
    return fallback;
  }
  const vec3 scaled_value = value / scale;
  return scaled_value * inversesqrt(dot(scaled_value, scaled_value));
}

vec3 EE_RT_GEOMETRIC_NORMAL(const vec3 edge_1, const vec3 edge_2, const vec3 fallback) {
  const vec3 normalized_edge_1 = EE_RT_SAFE_NORMALIZE(edge_1, vec3(0.0f));
  const vec3 normalized_edge_2 = EE_RT_SAFE_NORMALIZE(edge_2, vec3(0.0f));
  return EE_RT_SAFE_NORMALIZE(cross(normalized_edge_1, normalized_edge_2), fallback);
}

EeRayTracingSurfaceAttributes EE_RT_INTERPOLATE_SURFACE_ATTRIBUTES(
    const Vertex v0, const Vertex v1, const Vertex v2, const vec3 barycentrics, const vec4 tex_gradients) {
  EeRayTracingSurfaceAttributes attributes;
  attributes.position = v0.position * barycentrics.x + v1.position * barycentrics.y + v2.position * barycentrics.z;
  attributes.normal = v0.normal * barycentrics.x + v1.normal * barycentrics.y + v2.normal * barycentrics.z;
  attributes.tangent = v0.tangent * barycentrics.x + v1.tangent * barycentrics.y + v2.tangent * barycentrics.z;
  attributes.tangent_handedness = v0.vertex_info3 < 0.0f ? -1.0f : 1.0f;
  attributes.vertex_color = v0.color * barycentrics.x + v1.color * barycentrics.y + v2.color * barycentrics.z;
  attributes.tex_coords = EE_GLTF_MAKE_TEX_COORDS(
      v0.tex_coord * barycentrics.x + v1.tex_coord * barycentrics.y + v2.tex_coord * barycentrics.z,
      v0.tex_coord_1 * barycentrics.x + v1.tex_coord_1 * barycentrics.y + v2.tex_coord_1 * barycentrics.z,
      v0.tex_coord_2 * barycentrics.x + v1.tex_coord_2 * barycentrics.y + v2.tex_coord_2 * barycentrics.z,
      v0.tex_coord_3 * barycentrics.x + v1.tex_coord_3 * barycentrics.y + v2.tex_coord_3 * barycentrics.z,
      tex_gradients);
  return attributes;
}

vec3 EE_RT_WORLD_NORMAL(const mat4 model, const vec3 object_normal, const vec3 fallback) {
  return EE_RT_SAFE_NORMALIZE(transpose(inverse(mat3(model))) * object_normal, fallback);
}

vec3 EE_RT_WORLD_TANGENT(const mat4 model, const vec3 object_tangent, const vec3 world_normal) {
  const vec3 tangent = mat3(model) * object_tangent;
  return EE_RT_SAFE_NORMALIZE(tangent - world_normal * dot(tangent, world_normal),
                              EE_GLTF_FALLBACK_TANGENT(world_normal));
}

float EE_RT_WORLD_TANGENT_HANDEDNESS(const float tangent_handedness, const mat4 model) {
  return tangent_handedness * EE_TRANSFORM_HANDEDNESS(model);
}

vec4 EE_RT_TEXEL_DENSITY(const mat4 model, const Vertex v0, const Vertex v1, const Vertex v2) {
  const vec3 world_edge_1 = vec3(model * vec4(v1.position - v0.position, 0.0f));
  const vec3 world_edge_2 = vec3(model * vec4(v2.position - v0.position, 0.0f));
  const float world_area = length(cross(world_edge_1, world_edge_2));
  const vec2 uv0_edge_1 = v1.tex_coord - v0.tex_coord;
  const vec2 uv0_edge_2 = v2.tex_coord - v0.tex_coord;
  const vec2 uv1_edge_1 = v1.tex_coord_1 - v0.tex_coord_1;
  const vec2 uv1_edge_2 = v2.tex_coord_1 - v0.tex_coord_1;
  const vec2 uv2_edge_1 = v1.tex_coord_2 - v0.tex_coord_2;
  const vec2 uv2_edge_2 = v2.tex_coord_2 - v0.tex_coord_2;
  const vec2 uv3_edge_1 = v1.tex_coord_3 - v0.tex_coord_3;
  const vec2 uv3_edge_2 = v2.tex_coord_3 - v0.tex_coord_3;
  const vec4 uv_area = abs(vec4(uv0_edge_1.x * uv0_edge_2.y - uv0_edge_2.x * uv0_edge_1.y,
                                uv1_edge_1.x * uv1_edge_2.y - uv1_edge_2.x * uv1_edge_1.y,
                                uv2_edge_1.x * uv2_edge_2.y - uv2_edge_2.x * uv2_edge_1.y,
                                uv3_edge_1.x * uv3_edge_2.y - uv3_edge_2.x * uv3_edge_1.y));
  return sqrt(uv_area / max(world_area, 1e-20f));
}

float EE_RT_WORLD_FOOTPRINT(const float ray_cone_width, const float hit_t, const vec3 geometric_normal,
                            const vec3 ray_direction, const float ray_spread_angle) {
  return (ray_cone_width + hit_t * ray_spread_angle) /
         max(abs(dot(geometric_normal, -ray_direction)), 1e-3f);
}

vec4 EE_RT_TEXTURE_GRADIENTS(const float ray_cone_width, const float hit_t, const vec3 geometric_normal,
                             const vec3 ray_direction, const mat4 model, const Vertex v0, const Vertex v1,
                             const Vertex v2, const float ray_spread_angle) {
  return EE_RT_WORLD_FOOTPRINT(ray_cone_width, hit_t, geometric_normal, ray_direction, ray_spread_angle) *
         EE_RT_TEXEL_DENSITY(model, v0, v1, v2);
}

float EE_RT_SPHERICAL_RAY_SPREAD(const uint ray_count) {
  return sqrt(4.0f * 3.14159265359f / float(max(ray_count, 1u)));
}

vec3 EE_RT_SAFE_OFFSET_RAY(const vec3 world_position, const vec3 offset_direction) {
  const ivec3 scale_int = ivec3(256.0f * offset_direction);
  const vec3 offset_position = vec3(
      intBitsToFloat(floatBitsToInt(world_position.x) + (world_position.x < 0.0f ? -scale_int.x : scale_int.x)),
      intBitsToFloat(floatBitsToInt(world_position.y) + (world_position.y < 0.0f ? -scale_int.y : scale_int.y)),
      intBitsToFloat(floatBitsToInt(world_position.z) + (world_position.z < 0.0f ? -scale_int.z : scale_int.z)));
  const float origin = 1.0f / 32.0f;
  const float float_scale = 1.0f / 65536.0f;
  return vec3(abs(world_position.x) < origin ? world_position.x + float_scale * offset_direction.x
                                             : offset_position.x,
              abs(world_position.y) < origin ? world_position.y + float_scale * offset_direction.y
                                             : offset_position.y,
              abs(world_position.z) < origin ? world_position.z + float_scale * offset_direction.z
                                             : offset_position.z);
}

vec3 EE_RT_OFFSET_RAY_ORIGIN(const vec3 world_position, const vec3 geometric_normal, const vec3 direction) {
  const vec3 offset_direction = dot(direction, geometric_normal) >= 0.0f ? geometric_normal : -geometric_normal;
  return EE_RT_SAFE_OFFSET_RAY(world_position, offset_direction);
}

vec3 EE_RT_COATED_EMISSION_VALUE(const vec3 emissive, const float clearcoat,
                                 vec3 world_clearcoat_normal, const vec3 world_geometric_normal,
                                 const vec3 outgoing_direction) {
  const float coat = clamp(clearcoat, 0.0f, 1.0f);
  if (coat <= 0.0f) {
    return emissive;
  }
  if (dot(world_clearcoat_normal, world_geometric_normal) < 0.0f) {
    world_clearcoat_normal = world_geometric_normal;
  }
  const vec3 incident_direction =
      -EE_RT_SAFE_NORMALIZE(outgoing_direction, world_geometric_normal);
  if (dot(reflect(incident_direction, world_clearcoat_normal), world_geometric_normal) < 0.0f) {
    world_clearcoat_normal = world_geometric_normal;
  }
  const float cosine = clamp(abs(dot(EE_RT_SAFE_NORMALIZE(outgoing_direction, world_clearcoat_normal),
                                     world_clearcoat_normal)),
                             0.0f, 1.0f);
  const float fresnel = 0.04f + 0.96f * pow(max(1.0f - cosine, 0.0f), 5.0f);
  return emissive * max(1.0f - coat * fresnel, 0.0f);
}

vec3 EE_RT_COATED_EMISSION(const uint material_index, const GltfRasterMaterial surface,
                           const GltfTexCoords tex_coords, const vec3 world_base_normal,
                           const vec3 world_tangent, const float world_tangent_handedness,
                           const float facing_sign, const vec3 world_geometric_normal,
                           const vec3 outgoing_direction) {
  if (clamp(surface.clearcoat, 0.0f, 1.0f) <= 0.0f) {
    return surface.emissive;
  }
  const vec3 world_clearcoat_normal = facing_sign * EE_EVALUATE_GLTF_RASTER_CLEARCOAT_NORMAL(
      material_index, tex_coords, world_base_normal, world_tangent, world_tangent_handedness);
  return EE_RT_COATED_EMISSION_VALUE(surface.emissive, surface.clearcoat, world_clearcoat_normal,
                                     world_geometric_normal, outgoing_direction);
}

vec3 EE_RT_COATED_EMISSION_LOD0(const uint material_index, const GltfTexCoords tex_coords,
                                const vec3 world_base_normal, const vec3 world_tangent,
                                const float world_tangent_handedness, const float facing_sign,
                                const vec3 world_geometric_normal, const vec3 outgoing_direction) {
  const GltfShadeMaterial material = EE_GLTF_MATERIALS[material_index];
  const vec3 emissive = max(
      material.emissive_factor *
          EE_GLTF_SAMPLE_TEXTURE_SLOT_LOD0(material.emissive_texture, EE_GLTF_RASTER_TEXTURE_EMISSIVE,
                                           tex_coords, vec4(1.0f)).rgb,
      vec3(0.0f));
#if EE_GLTF_USE_CLEARCOAT
  const float clearcoat = material.clearcoat_factor *
                          EE_GLTF_SAMPLE_TEXTURE_SLOT_LOD0(
                              material.clearcoat_texture, EE_GLTF_RASTER_TEXTURE_CLEARCOAT,
                              tex_coords, vec4(1.0f)).r;
  if (clamp(clearcoat, 0.0f, 1.0f) <= 0.0f) {
    return emissive;
  }
  const vec3 world_clearcoat_normal = facing_sign * EE_EVALUATE_GLTF_RASTER_CLEARCOAT_NORMAL(
      material_index, tex_coords, world_base_normal, world_tangent, world_tangent_handedness);
  return EE_RT_COATED_EMISSION_VALUE(emissive, clearcoat, world_clearcoat_normal,
                                     world_geometric_normal, outgoing_direction);
#else
  return emissive;
#endif
}

vec3 EE_RT_COATED_EMISSION_LOD0(const uint material_index, const GltfTexCoords tex_coords,
                                const vec3 world_base_normal, const vec3 world_tangent,
                                const vec3 world_bitangent, const vec3 world_geometric_normal,
                                const vec3 outgoing_direction) {
  const float tangent_handedness =
      dot(cross(world_base_normal, world_tangent), world_bitangent) < 0.0f ? -1.0f : 1.0f;
  return EE_RT_COATED_EMISSION_LOD0(material_index, tex_coords, world_base_normal, world_tangent,
                                    tangent_handedness, 1.0f, world_geometric_normal, outgoing_direction);
}

#endif
