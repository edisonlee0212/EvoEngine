
#extension GL_EXT_control_flow_attributes : require

#include "DDGI.slangh"
#include "VogelDisk.slangh"

layout(set = EE_PER_GROUP_SET, binding = 14) uniform sampler2DArrayShadow EE_DIRECTIONAL_LIGHT_SM;
layout(set = EE_PER_GROUP_SET, binding = 15) uniform sampler2DArray EE_POINT_LIGHT_SM;
layout(set = EE_PER_GROUP_SET, binding = 16) uniform sampler2D EE_SPOT_LIGHT_SM;
layout(set = EE_PER_GROUP_SET, binding = 17) uniform sampler2D EE_DDGI_IRRADIANCE_ATLASES[EE_DDGI_MAX_VOLUME_COUNT];
layout(set = EE_PER_GROUP_SET, binding = 18) uniform sampler2D EE_DDGI_VISIBILITY_ATLASES[EE_DDGI_MAX_VOLUME_COUNT];
layout(set = EE_PER_GROUP_SET, binding = 19) readonly buffer EE_DDGI_PROBE_STATE_BLOCK {
  vec4 states[];
}
EE_DDGI_PROBE_STATE_BLOCKS[EE_DDGI_MAX_VOLUME_COUNT];

#define EE_DDGI_MULTI_VOLUME_GATHER
#include "DDGIGather.slangh"

#ifdef EE_RASTER_FIXED_LIGHTING_TEXTURES
layout(set = EE_RASTER_FIXED_LIGHTING_TEXTURE_SET, binding = 0) uniform sampler2D EE_RASTER_BRDF_LUT;
layout(set = EE_RASTER_FIXED_LIGHTING_TEXTURE_SET, binding = 1) uniform samplerCube EE_RASTER_SKYBOX;
layout(set = EE_RASTER_FIXED_LIGHTING_TEXTURE_SET, binding = 2) uniform samplerCube EE_RASTER_IRRADIANCE_MAP;
layout(set = EE_RASTER_FIXED_LIGHTING_TEXTURE_SET, binding = 3) uniform samplerCube EE_RASTER_PREFILTERED_MAP;
layout(set = EE_RASTER_FIXED_LIGHTING_TEXTURE_SET,
       binding = 5) uniform samplerCube EE_RASTER_REFLECTION_PROBES[EE_REFLECTION_PROBE_MAX_COUNT];
#endif

vec3 EE_SKY_COLOR(vec3 direction) {
  Camera camera = EE_CAMERAS[EE_CAMERA_INDEX];
  if (camera.background_source == 1) {
    return camera.clear_color.xyz * camera.clear_color.w;
  }
#ifdef EE_RASTER_FIXED_LIGHTING_TEXTURES
  return pow(texture(EE_RASTER_SKYBOX, normalize(EE_ENVIRONMENT_LOCAL_DIRECTION(direction))).rgb,
             vec3(1.0f / EE_ENVIRONMENT.gamma)) *
         camera.clear_color.w;
#else
  return pow(texture(EE_CUBEMAPS[camera.skybox_tex_index], normalize(EE_ENVIRONMENT_LOCAL_DIRECTION(direction))).rgb,
             vec3(1.0f / EE_ENVIRONMENT.gamma)) *
         camera.clear_color.w;
#endif
}

const float PI = 3.14159265359;
// ----------------------------------------------------------------------------
float EE_FUNC_DISTRIBUTION_GGX(vec3 N, vec3 H, float roughness) {
  float a = roughness * roughness;
  float a2 = a * a;
  float NdotH = max(dot(N, H), 0.0f);
  float NdotH2 = NdotH * NdotH;

  float nom = a2;
  float denom = (NdotH2 * (a2 - 1.0f) + 1.0f);
  denom = PI * denom * denom;

  return nom / max(denom, 0.001f);  // prevent divide by zero for roughness=0.0f and NdotH=1.0
}
// ----------------------------------------------------------------------------
float EE_FUNC_GEOMETRY_SCHLICK_GGX(float NdotV, float roughness) {
  float r = (roughness + 1.0f);
  float k = (r * r) / 8.0f;

  float nom = NdotV;
  float denom = NdotV * (1.0f - k) + k;

  return nom / denom;
}
// ----------------------------------------------------------------------------
float EE_FUNC_GEOMETRY_SMITH(vec3 N, vec3 V, vec3 L, float roughness) {
  float NdotV = max(dot(N, V), 0.0f);
  float NdotL = max(dot(N, L), 0.0f);
  float ggx2 = EE_FUNC_GEOMETRY_SCHLICK_GGX(NdotV, roughness);
  float ggx1 = EE_FUNC_GEOMETRY_SCHLICK_GGX(NdotL, roughness);

  return ggx1 * ggx2;
}
// ----------------------------------------------------------------------------
vec3 EE_FUNC_FRESNEL_SCHLICK(float cosTheta, vec3 F0, float F90) {
  return F0 + (vec3(F90) - F0) * pow(max(1.0f - clamp(cosTheta, 0.0f, 1.0f), 0.0f), 5.0f);
}

// ----------------------------------------------------------------------------
vec3 EE_FUNC_FRESNEL_SCHLICK_ROUGHNESS(float cosTheta, vec3 F0, float F90, float roughness) {
  return F0 + (max(vec3(F90 * (1.0f - roughness)), F0) - F0) * pow(max(1.0f - clamp(cosTheta, 0.0f, 1.0f), 0.0f), 5.0f);
}

vec3 EE_FUNC_CALCULATE_LIGHTS(in bool calculateShadow, vec3 albedo, float specular, float dist, vec3 normal,
                              vec3 viewDir, vec3 fragPos, float metallic, float roughness, vec3 F0, float F90);
vec3 EE_FUNC_DIRECTIONAL_LIGHT(vec3 albedo, float specular, int i, vec3 normal, vec3 viewDir, float metallic,
                               float roughness, vec3 F0, float F90);
vec3 EE_FUNC_POINT_LIGHT(vec3 albedo, float specular, int i, vec3 normal, vec3 fragPos, vec3 viewDir, float metallic,
                         float roughness, vec3 F0, float F90);
vec3 EE_FUNC_SPOT_LIGHT(vec3 albedo, float specular, int i, vec3 normal, vec3 fragPos, vec3 viewDir, float metallic,
                        float roughness, vec3 F0, float F90);
float EE_FUNC_DIRECTIONAL_LIGHT_SHADOW(int i, int splitIndex, vec3 fragPos, vec3 normal, float cameraFragDistance);
float EE_FUNC_POINT_LIGHT_SHADOW(int i, vec3 fragPos, float cameraFragDistance);
float EE_FUNC_SPOT_LIGHT_SHADOW(int i, vec3 fragPos, float cameraFragDistance);
int EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_INDEX(float dist);
float EE_FUNC_DIRECTIONAL_LIGHT_CASCADE_SHADOW(int lightIndex, float dist, vec3 fragPos, vec3 normal,
                                               float cameraFragDistance);
vec4 EE_FUNC_DIRECTIONAL_SHADOW_DEBUG(float dist, vec3 fragPos);

vec3 EE_FUNC_CALCULATE_DDGI_DIFFUSE(vec3 albedo, vec3 normal, vec3 viewDir, vec3 fragPos) {
  return EE_DDGI_WEIGHTED_DIFFUSE(EE_DDGI_GATHER_IRRADIANCE(normal, viewDir, fragPos), albedo);
}

struct EeEnvironmentalLighting {
  vec3 diffuse;
  vec3 specular;
  vec3 unoccluded_specular;
  vec3 diffuse_weight;
  float specular_visibility;
};

float EE_ROUGH_SPECULAR_VISIBILITY(float materialOcclusion, float screenSpaceVisibility, float roughness,
                                   float normalDotView) {
  const float scalarVisibility = min(clamp(materialOcclusion, 0.0f, 1.0f), clamp(screenSpaceVisibility, 0.0f, 1.0f));
  const float clampedRoughness = clamp(roughness, 0.0f, 1.0f);
  const float lobeWidth = clampedRoughness * clampedRoughness;
  const float scalarOcclusion = 1.0f - scalarVisibility;
  const float grazingOcclusion = 0.04f * tanh(scalarOcclusion / 0.04f);
  const float viewConfidence = smoothstep(0.8f, 1.0f, clamp(normalDotView, 0.0f, 1.0f));
  const float trustedOcclusion = mix(grazingOcclusion, scalarOcclusion, viewConfidence);
  return 1.0f - lobeWidth * trustedOcclusion;
}

int EE_INDIRECT_LIGHTING_DEBUG_VIEW() {
  return int(round(EE_RENDER_INFO.shadow_fade_parameters.y));
}

#ifdef EE_RASTER_FIXED_LIGHTING_TEXTURES
vec3 EE_SAMPLE_REFLECTION_PROBE(int index, vec3 direction, float lod) {
  switch (index) {
    case 0:
      return textureLod(EE_RASTER_REFLECTION_PROBES[0], direction, lod).rgb;
    case 1:
      return textureLod(EE_RASTER_REFLECTION_PROBES[1], direction, lod).rgb;
    case 2:
      return textureLod(EE_RASTER_REFLECTION_PROBES[2], direction, lod).rgb;
    case 3:
      return textureLod(EE_RASTER_REFLECTION_PROBES[3], direction, lod).rgb;
    case 4:
      return textureLod(EE_RASTER_REFLECTION_PROBES[4], direction, lod).rgb;
    case 5:
      return textureLod(EE_RASTER_REFLECTION_PROBES[5], direction, lod).rgb;
    case 6:
      return textureLod(EE_RASTER_REFLECTION_PROBES[6], direction, lod).rgb;
    case 7:
      return textureLod(EE_RASTER_REFLECTION_PROBES[7], direction, lod).rgb;
    case 8:
      return textureLod(EE_RASTER_REFLECTION_PROBES[8], direction, lod).rgb;
    case 9:
      return textureLod(EE_RASTER_REFLECTION_PROBES[9], direction, lod).rgb;
    case 10:
      return textureLod(EE_RASTER_REFLECTION_PROBES[10], direction, lod).rgb;
    case 11:
      return textureLod(EE_RASTER_REFLECTION_PROBES[11], direction, lod).rgb;
    case 12:
      return textureLod(EE_RASTER_REFLECTION_PROBES[12], direction, lod).rgb;
    case 13:
      return textureLod(EE_RASTER_REFLECTION_PROBES[13], direction, lod).rgb;
    case 14:
      return textureLod(EE_RASTER_REFLECTION_PROBES[14], direction, lod).rgb;
    case 15:
      return textureLod(EE_RASTER_REFLECTION_PROBES[15], direction, lod).rgb;
    case 16:
      return textureLod(EE_RASTER_REFLECTION_PROBES[16], direction, lod).rgb;
    case 17:
      return textureLod(EE_RASTER_REFLECTION_PROBES[17], direction, lod).rgb;
    case 18:
      return textureLod(EE_RASTER_REFLECTION_PROBES[18], direction, lod).rgb;
    case 19:
      return textureLod(EE_RASTER_REFLECTION_PROBES[19], direction, lod).rgb;
    case 20:
      return textureLod(EE_RASTER_REFLECTION_PROBES[20], direction, lod).rgb;
    case 21:
      return textureLod(EE_RASTER_REFLECTION_PROBES[21], direction, lod).rgb;
    case 22:
      return textureLod(EE_RASTER_REFLECTION_PROBES[22], direction, lod).rgb;
    case 23:
      return textureLod(EE_RASTER_REFLECTION_PROBES[23], direction, lod).rgb;
    case 24:
      return textureLod(EE_RASTER_REFLECTION_PROBES[24], direction, lod).rgb;
    case 25:
      return textureLod(EE_RASTER_REFLECTION_PROBES[25], direction, lod).rgb;
    case 26:
      return textureLod(EE_RASTER_REFLECTION_PROBES[26], direction, lod).rgb;
    case 27:
      return textureLod(EE_RASTER_REFLECTION_PROBES[27], direction, lod).rgb;
    case 28:
      return textureLod(EE_RASTER_REFLECTION_PROBES[28], direction, lod).rgb;
    case 29:
      return textureLod(EE_RASTER_REFLECTION_PROBES[29], direction, lod).rgb;
    case 30:
      return textureLod(EE_RASTER_REFLECTION_PROBES[30], direction, lod).rgb;
    case 31:
      return textureLod(EE_RASTER_REFLECTION_PROBES[31], direction, lod).rgb;
  }
  return vec3(0.0f);
}

bool EE_REFLECTION_PROBE_INFLUENCE(ReflectionProbeInfo probe, vec3 fragPos, out vec3 localPosition, out float weight) {
  localPosition = (probe.world_to_probe * vec4(fragPos, 1.0f)).xyz;
  float edgeDistance;
  if (int(probe.lighting_parameters.z) == 0) {
    const vec3 edge = probe.shape_parameters.xyz - abs(localPosition);
    edgeDistance = min(edge.x, min(edge.y, edge.z));
  } else {
    edgeDistance = probe.shape_parameters.w - length(localPosition);
  }
  if (edgeDistance < 0.0f) {
    weight = 0.0f;
    return false;
  }
  const float blendDistance = probe.projection_parameters.w;
  weight = blendDistance <= 0.0f ? 1.0f : clamp(edgeDistance / blendDistance, 0.0f, 1.0f);
  return true;
}

vec3 EE_REFLECTION_PROBE_DIRECTION(ReflectionProbeInfo probe, vec3 localPosition, vec3 reflectionDirection) {
  if (int(probe.lighting_parameters.z) != 0 || probe.lighting_parameters.w < 0.5f) {
    return normalize(reflectionDirection);
  }
  const vec3 localDirection = mat3(probe.world_to_probe) * reflectionDirection;
  const vec3 projectionExtents = probe.projection_parameters.xyz;
  if (any(greaterThan(abs(localPosition), projectionExtents))) {
    return normalize(reflectionDirection);
  }
  const vec3 safeDirection = mix(mix(vec3(-1.0e-6f), vec3(1.0e-6f), greaterThanEqual(localDirection, vec3(0.0f))),
                                 localDirection, greaterThan(abs(localDirection), vec3(1.0e-6f)));
  const vec3 t0 = (-projectionExtents - localPosition) / safeDirection;
  const vec3 t1 = (projectionExtents - localPosition) / safeDirection;
  const vec3 farPlane = max(t0, t1);
  const float distance = min(farPlane.x, min(farPlane.y, farPlane.z));
  if (distance <= 0.0f || isnan(distance) || isinf(distance)) {
    return normalize(reflectionDirection);
  }
  const vec3 localHit = localPosition + localDirection * distance;
  return normalize(inverse(mat3(probe.world_to_probe)) * localHit);
}

vec3 EE_SPATIAL_REFLECTION_PREFILTERED(vec3 fragPos, vec3 reflectionDirection, float roughness,
                                       vec3 globalPrefiltered) {
  int primary = -1;
  int secondary = -1;
  vec3 primaryLocal = vec3(0.0f);
  vec3 secondaryLocal = vec3(0.0f);
  float primaryWeight = 0.0f;
  float secondaryRawWeight = 0.0f;
  const int probeCount = min(int(EE_RENDER_INFO.reflection_probe_header.x), int(EE_REFLECTION_PROBE_MAX_COUNT));
  for (int index = 0; index < probeCount; ++index) {
    vec3 localPosition;
    float weight;
    if (EE_REFLECTION_PROBE_INFLUENCE(EE_RENDER_INFO.reflection_probes[index], fragPos, localPosition, weight)) {
      primary = index;
      primaryLocal = localPosition;
      primaryWeight = weight;
      break;
    }
  }
  if (primary < 0) {
    return globalPrefiltered;
  }
  if (primaryWeight < 1.0f) {
    for (int index = primary + 1; index < probeCount; ++index) {
      if (EE_RENDER_INFO.reflection_probes[index].lighting_parameters.y >=
          EE_RENDER_INFO.reflection_probes[primary].lighting_parameters.y) {
        continue;
      }
      vec3 localPosition;
      float weight;
      if (EE_REFLECTION_PROBE_INFLUENCE(EE_RENDER_INFO.reflection_probes[index], fragPos, localPosition, weight)) {
        secondary = index;
        secondaryLocal = localPosition;
        secondaryRawWeight = weight;
        break;
      }
    }
  }
  float globalWeight = (1.0f - primaryWeight) * (1.0f - secondaryRawWeight);
  vec3 result = globalPrefiltered * globalWeight;
  ReflectionProbeInfo primaryProbe = EE_RENDER_INFO.reflection_probes[primary];
  if (primaryProbe.identity_and_flags.y != 0u) {
    const vec3 direction = EE_REFLECTION_PROBE_DIRECTION(primaryProbe, primaryLocal, reflectionDirection);
    result += EE_SAMPLE_REFLECTION_PROBE(primary, direction, roughness * 8.0f) * primaryProbe.lighting_parameters.x *
              primaryWeight;
  } else {
    result += globalPrefiltered * primaryWeight;
  }
  if (secondary >= 0) {
    const float secondaryWeight = (1.0f - primaryWeight) * secondaryRawWeight;
    ReflectionProbeInfo secondaryProbe = EE_RENDER_INFO.reflection_probes[secondary];
    if (secondaryProbe.identity_and_flags.y != 0u) {
      const vec3 direction = EE_REFLECTION_PROBE_DIRECTION(secondaryProbe, secondaryLocal, reflectionDirection);
      result += EE_SAMPLE_REFLECTION_PROBE(secondary, direction, roughness * 8.0f) *
                secondaryProbe.lighting_parameters.x * secondaryWeight;
    } else {
      result += globalPrefiltered * secondaryWeight;
    }
  }
  return result;
}
#endif

EeEnvironmentalLighting EE_FUNC_CALCULATE_ENVIRONMENTAL_COMPONENTS(vec3 albedo, vec3 normal, vec3 viewDir, vec3 fragPos,
                                                                   float metallic, float roughness, vec3 F0, float F90,
                                                                   float materialOcclusion,
                                                                   float screenSpaceVisibility) {
  EeEnvironmentalLighting result;
  const float normalDotView = max(dot(normal, viewDir), 0.0f);
  const vec3 F = EE_FUNC_FRESNEL_SCHLICK_ROUGHNESS(normalDotView, F0, F90, roughness);
  const vec3 R = reflect(-viewDir, normal);
  result.diffuse_weight = (vec3(1.0f) - F) * (1.0f - metallic);

#ifdef EE_RASTER_FIXED_LIGHTING_TEXTURES
  const vec3 irradiance = EE_ENVIRONMENT.background_color.w == 1.0f
                              ? EE_ENVIRONMENT.background_color.xyz
                              : pow(texture(EE_RASTER_IRRADIANCE_MAP, EE_ENVIRONMENT_LOCAL_DIRECTION(normal)).rgb,
                                    vec3(1.0f / EE_ENVIRONMENT.gamma));
#else
  const vec3 irradiance = EE_ENVIRONMENT.background_color.w == 1.0f
                              ? EE_ENVIRONMENT.background_color.xyz
                              : pow(texture(EE_CUBEMAPS[EE_CAMERAS[EE_CAMERA_INDEX].irradiance_map_index],
                                            EE_ENVIRONMENT_LOCAL_DIRECTION(normal))
                                        .rgb,
                                    vec3(1.0f / EE_ENVIRONMENT.gamma));
#endif
  result.diffuse = result.diffuse_weight * irradiance * albedo * EE_ENVIRONMENT.diffuse_fallback_intensity;

#ifdef EE_RASTER_FIXED_LIGHTING_TEXTURES
  const float reflectionLodScale = float(max(textureQueryLevels(EE_RASTER_PREFILTERED_MAP) - 1, 0));
  const vec3 globalPrefiltered = (EE_ENVIRONMENT.background_color.w == 1.0f
                                      ? EE_ENVIRONMENT.background_color.xyz
                                      : pow(textureLod(EE_RASTER_PREFILTERED_MAP, EE_ENVIRONMENT_LOCAL_DIRECTION(R),
                                                       roughness * reflectionLodScale)
                                                .rgb,
                                            vec3(1.0f / EE_ENVIRONMENT.gamma))) *
                                 EE_ENVIRONMENT.specular_fallback_intensity;
  const vec3 prefilteredColor = EE_SPATIAL_REFLECTION_PREFILTERED(fragPos, R, roughness, globalPrefiltered);
  const vec2 brdf = texture(EE_RASTER_BRDF_LUT, vec2(normalDotView, roughness)).rg;
#else
  const int prefilteredMapIndex = EE_CAMERAS[EE_CAMERA_INDEX].prefiltered_map_index;
  const float reflectionLodScale = float(max(textureQueryLevels(EE_CUBEMAPS[prefilteredMapIndex]) - 1, 0));
  const vec3 prefilteredColor = (EE_ENVIRONMENT.background_color.w == 1.0f
                                     ? EE_ENVIRONMENT.background_color.xyz
                                     : pow(textureLod(EE_CUBEMAPS[prefilteredMapIndex],
                                                      EE_ENVIRONMENT_LOCAL_DIRECTION(R), roughness * reflectionLodScale)
                                               .rgb,
                                           vec3(1.0f / EE_ENVIRONMENT.gamma))) *
                                EE_ENVIRONMENT.specular_fallback_intensity;
  const vec2 brdf = texture(EE_TEXTURE_2DS[EE_RENDER_INFO.brdf_lut_map_index], vec2(normalDotView, roughness)).rg;
#endif
  result.unoccluded_specular = prefilteredColor * (F * brdf.x + vec3(F90 * brdf.y));
  const bool gtaoVisibilityAvailable = (EE_CAMERAS[EE_CAMERA_INDEX].raster_lighting_flags & 1u) != 0u;
  result.specular_visibility = EE_ROUGH_SPECULAR_VISIBILITY(
      materialOcclusion, gtaoVisibilityAvailable ? screenSpaceVisibility : 1.0f, roughness, normalDotView);
  result.specular = result.unoccluded_specular * result.specular_visibility;
  return result;
}

vec3 EE_FUNC_CALCULATE_ENVIRONMENTAL_LIGHT(vec3 albedo, vec3 normal, vec3 viewDir, vec3 fragPos, float metallic,
                                           float roughness, vec3 F0, float F90) {
  const EeEnvironmentalLighting environment = EE_FUNC_CALCULATE_ENVIRONMENTAL_COMPONENTS(
      albedo, normal, viewDir, fragPos, metallic, roughness, F0, F90, 1.0f, 1.0f);
  return environment.diffuse * EE_RENDER_INFO.indirect_lighting_intensity + environment.specular;
}

vec3 EE_FUNC_CALCULATE_DDGI_ENVIRONMENTAL_LIGHT(vec3 albedo, vec3 normal, vec3 viewDir, vec3 fragPos, float metallic,
                                                float roughness, vec3 F0, float F90, float materialOcclusion,
                                                float screenSpaceVisibility) {
  const EeEnvironmentalLighting environment = EE_FUNC_CALCULATE_ENVIRONMENTAL_COMPONENTS(
      albedo, normal, viewDir, fragPos, metallic, roughness, F0, F90, materialOcclusion, screenSpaceVisibility);
  const vec3 diffuse_albedo = environment.diffuse_weight * albedo;
  vec3 diffuse = environment.diffuse;
  if (any(greaterThan(diffuse_albedo, vec3(0.0f)))) {
    const EeDdgiGatherResult gather = EE_DDGI_GATHER_IRRADIANCE(normal, viewDir, fragPos);
    const float gather_weight = EE_DDGI_GATHER_WEIGHT(gather);
    if (gather_weight > 0.0f) {
      const vec3 ddgi_diffuse = EE_DDGI_DIFFUSE_RADIANCE(gather, diffuse_albedo);
      if (!any(isnan(ddgi_diffuse)) && !any(isinf(ddgi_diffuse))) {
        diffuse = mix(diffuse, ddgi_diffuse, gather_weight);
      }
    }
  }
  const vec3 diffuseIndirect = diffuse * clamp(materialOcclusion * screenSpaceVisibility, 0.0f, 1.0f) *
                               EE_RENDER_INFO.indirect_lighting_intensity;
  const int debugView = EE_INDIRECT_LIGHTING_DEBUG_VIEW();
  if (debugView == 1)
    return diffuseIndirect;
  if (debugView == 2)
    return environment.unoccluded_specular;
  if (debugView == 3)
    return vec3(environment.specular_visibility);
  if (debugView == 4)
    return environment.specular;
  return diffuseIndirect + environment.specular;
}

vec3 EE_FUNC_CALCULATE_LIGHTS(bool calculateShadow, vec3 albedo, float specular, float dist, vec3 normal, vec3 viewDir,
                              vec3 fragPos, float metallic, float roughness, vec3 F0, float F90) {
  vec3 result = vec3(0.0, 0.0, 0.0f);
  vec3 fragToCamera = fragPos - EE_CAMERA_POSITION(EE_CAMERA_INDEX);
  float cameraFragDistance = length(fragToCamera);
  // phase 1: directional lighting
  for (int i = 0; i < EE_RENDER_INFO.directional_light_size; i++) {
    float shadow = 1.0f;
    int lightIndex = EE_CAMERA_INDEX * MAX_DIRECTIONAL_LIGHT_SIZE + i;
    if (calculateShadow && EE_DIRECTIONAL_LIGHTS[lightIndex].diffuse.w == 1.0f) {
      shadow = EE_FUNC_DIRECTIONAL_LIGHT_CASCADE_SHADOW(lightIndex, dist, fragPos, normal, cameraFragDistance);
    }
    result +=
        EE_FUNC_DIRECTIONAL_LIGHT(albedo, specular, lightIndex, normal, viewDir, metallic, roughness, F0, F90) * shadow;
  }
  // phase 2: point lights
  for (int i = 0; i < EE_RENDER_INFO.point_light_size; i++) {
    float shadow = 1.0f;
    if (calculateShadow && EE_POINT_LIGHTS[i].diffuse.w == 1.0f) {
      shadow = EE_FUNC_POINT_LIGHT_SHADOW(i, fragPos, cameraFragDistance);
    }
    result += EE_FUNC_POINT_LIGHT(albedo, specular, i, normal, fragPos, viewDir, metallic, roughness, F0, F90) * shadow;
  }
  // phase 3: spot light
  for (int i = 0; i < EE_RENDER_INFO.spot_light_size; i++) {
    float shadow = 1.0f;
    if (calculateShadow && EE_SPOT_LIGHTS[i].diffuse.w == 1.0f) {
      shadow = EE_FUNC_SPOT_LIGHT_SHADOW(i, fragPos, cameraFragDistance);
    }
    result += EE_FUNC_SPOT_LIGHT(albedo, specular, i, normal, fragPos, viewDir, metallic, roughness, F0, F90) * shadow;
  }
  return result;
}

// calculates the color when using a directional light.
vec3 EE_FUNC_DIRECTIONAL_LIGHT(vec3 albedo, float specular, int i, vec3 normal, vec3 viewDir, float metallic,
                               float roughness, vec3 F0, float F90) {
  DirectionalLight light = EE_DIRECTIONAL_LIGHTS[i];
  vec3 lightDir = normalize(-light.direction);
  vec3 H = normalize(viewDir + lightDir);
  vec3 radiance = light.diffuse.xyz;
  float normalDF = EE_FUNC_DISTRIBUTION_GGX(normal, H, roughness);
  float G = EE_FUNC_GEOMETRY_SMITH(normal, viewDir, lightDir, roughness);
  vec3 F = EE_FUNC_FRESNEL_SCHLICK(clamp(dot(H, viewDir), 0.0, 1.0f), F0, F90);
  vec3 nominator = normalDF * G * F;
  float denominator = 4 * max(dot(normal, viewDir), 0.0f) * max(dot(normal, lightDir), 0.0f);
  vec3 spec = nominator / max(denominator, 0.001f) * specular;
  vec3 kS = F;
  vec3 kD = vec3(1.0f) - kS;
  kD *= 1.0f - metallic;
  float NdotL = max(dot(normal, lightDir), 0.0f);
  return (kD * albedo / PI + spec) * radiance * NdotL;
}

// calculates the color when using a point light.
vec3 EE_FUNC_POINT_LIGHT(vec3 albedo, float specular, int i, vec3 normal, vec3 fragPos, vec3 viewDir, float metallic,
                         float roughness, vec3 F0, float F90) {
  PointLight light = EE_POINT_LIGHTS[i];
  vec3 lightDir = normalize(light.position - fragPos);
  vec3 H = normalize(viewDir + lightDir);
  float distance = length(light.position - fragPos);
  float attenuation = 1.0f / (light.constant_linear_quadratic_far.x + light.constant_linear_quadratic_far.y * distance +
                              light.constant_linear_quadratic_far.z * (distance * distance));
  vec3 radiance = light.diffuse.xyz * attenuation;
  float normalDF = EE_FUNC_DISTRIBUTION_GGX(normal, H, roughness);
  float G = EE_FUNC_GEOMETRY_SMITH(normal, viewDir, lightDir, roughness);
  vec3 F = EE_FUNC_FRESNEL_SCHLICK(clamp(dot(H, viewDir), 0.0f, 1.0f), F0, F90);
  vec3 nominator = normalDF * G * F;
  float denominator = 4 * max(dot(normal, viewDir), 0.0f) * max(dot(normal, lightDir), 0.0f);
  vec3 spec = nominator / max(denominator, 0.001) * specular;
  vec3 kS = F;
  vec3 kD = vec3(1.0f) - kS;
  kD *= 1.0f - metallic;
  float NdotL = max(dot(normal, lightDir), 0.0f);
  return (kD * albedo / PI + spec) * radiance * NdotL;
}

// calculates the color when using a spot light.
vec3 EE_FUNC_SPOT_LIGHT(vec3 albedo, float specular, int i, vec3 normal, vec3 fragPos, vec3 viewDir, float metallic,
                        float roughness, vec3 F0, float F90) {
  SpotLight light = EE_SPOT_LIGHTS[i];
  vec3 lightDir = normalize(light.position - fragPos);
  vec3 H = normalize(viewDir + lightDir);
  float distance = length(light.position - fragPos);
  float attenuation = 1.0f / (light.constant_linear_quadratic_far.x + light.constant_linear_quadratic_far.y * distance +
                              light.constant_linear_quadratic_far.z * (distance * distance));
  // spotlight intensity
  float theta = dot(lightDir, normalize(-light.direction));
  float epsilon = light.cutoff_outer_inner_size_bias.x - light.cutoff_outer_inner_size_bias.y;
  float intensity = clamp((theta - light.cutoff_outer_inner_size_bias.y) / epsilon, 0.0f, 1.0f);

  vec3 radiance = light.diffuse.xyz * attenuation * intensity;
  float normalDF = EE_FUNC_DISTRIBUTION_GGX(normal, H, roughness);
  float G = EE_FUNC_GEOMETRY_SMITH(normal, viewDir, lightDir, roughness);
  vec3 F = EE_FUNC_FRESNEL_SCHLICK(clamp(dot(H, viewDir), 0.0f, 1.0f), F0, F90);
  vec3 nominator = normalDF * G * F;
  float denominator = 4 * max(dot(normal, viewDir), 0.0f) * max(dot(normal, lightDir), 0.0f);
  vec3 spec = nominator / max(denominator, 0.001f) * specular;
  vec3 kS = F;
  vec3 kD = vec3(1.0f) - kS;
  kD *= 1.0f - metallic;
  float NdotL = max(dot(normal, lightDir), 0.0f);
  return (kD * albedo / PI + spec) * radiance * NdotL;
}

int EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_INDEX(float dist) {
  vec4 splitDistances = EE_CAMERAS[EE_CAMERA_INDEX].shadow_split_distances;
  if (dist < splitDistances.x)
    return 0;
  if (dist < splitDistances.y)
    return 1;
  if (dist < splitDistances.z)
    return 2;
  if (dist < splitDistances.w)
    return 3;
  return -1;
}

float EE_FUNC_DIRECTIONAL_SHADOW_SPLIT_DISTANCE(int splitIndex) {
  return EE_CAMERAS[EE_CAMERA_INDEX].shadow_split_distances[clamp(splitIndex, 0, 3)];
}

float EE_FUNC_DIRECTIONAL_SHADOW_TRANSITION_HALF_WIDTH(int boundaryIndex) {
  float requestedWidth = max(EE_RENDER_INFO.shadow_cascade_transition_width, 0.0f);
  if (requestedWidth <= 0.0f)
    return 0.0f;

  float splitDistance = EE_FUNC_DIRECTIONAL_SHADOW_SPLIT_DISTANCE(boundaryIndex);
  float previousSplit = boundaryIndex == 0 ? 0.0f : EE_FUNC_DIRECTIONAL_SHADOW_SPLIT_DISTANCE(boundaryIndex - 1);
  float nextSplit = EE_FUNC_DIRECTIONAL_SHADOW_SPLIT_DISTANCE(boundaryIndex + 1);
  float availableWidth = max(min(splitDistance - previousSplit, nextSplit - splitDistance), 0.0f);
  return min(requestedWidth, availableWidth) * 0.5f;
}

float EE_FUNC_DIRECTIONAL_SHADOW_DISTANCE_FADE(float dist) {
  float maxShadowDistance = EE_CAMERAS[EE_CAMERA_INDEX].shadow_split_distances.w;
  if (dist >= maxShadowDistance)
    return 0.0f;

  float fadeWidth = max(EE_RENDER_INFO.shadow_fade_parameters.x, 0.0f);
  if (fadeWidth <= 0.0f)
    return 1.0f;
  return clamp((maxShadowDistance - dist) / fadeWidth, 0.0f, 1.0f);
}

float EE_FUNC_DIRECTIONAL_LIGHT_CASCADE_SHADOW(int lightIndex, float dist, vec3 fragPos, vec3 normal,
                                               float cameraFragDistance) {
  int splitIndex = EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_INDEX(dist);
  if (splitIndex < 0)
    return 1.0f;

  float shadow = EE_FUNC_DIRECTIONAL_LIGHT_SHADOW(lightIndex, splitIndex, fragPos, normal, cameraFragDistance);
  for (int boundaryIndex = 0; boundaryIndex < 3; boundaryIndex++) {
    float halfWidth = EE_FUNC_DIRECTIONAL_SHADOW_TRANSITION_HALF_WIDTH(boundaryIndex);
    if (halfWidth <= 0.0f)
      continue;

    float splitDistance = EE_FUNC_DIRECTIONAL_SHADOW_SPLIT_DISTANCE(boundaryIndex);
    if (dist < splitDistance - halfWidth || dist >= splitDistance + halfWidth)
      continue;

    float previousShadow =
        EE_FUNC_DIRECTIONAL_LIGHT_SHADOW(lightIndex, boundaryIndex, fragPos, normal, cameraFragDistance);
    float nextShadow =
        EE_FUNC_DIRECTIONAL_LIGHT_SHADOW(lightIndex, boundaryIndex + 1, fragPos, normal, cameraFragDistance);
    float blend = smoothstep(splitDistance - halfWidth, splitDistance + halfWidth, dist);
    shadow = mix(previousShadow, nextShadow, blend);
    break;
  }

  float distanceFade = EE_FUNC_DIRECTIONAL_SHADOW_DISTANCE_FADE(dist);
  return mix(1.0f, shadow, distanceFade);
}

vec3 EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_COLOR(int cascadeIndex) {
  if (cascadeIndex == 0)
    return vec3(0.08f, 0.55f, 1.0f);
  if (cascadeIndex == 1)
    return vec3(0.0f, 0.95f, 0.35f);
  if (cascadeIndex == 2)
    return vec3(1.0f, 0.85f, 0.05f);
  if (cascadeIndex == 3)
    return vec3(1.0f, 0.18f, 0.16f);
  return vec3(0.02f);
}

vec4 EE_FUNC_DIRECTIONAL_SHADOW_DEBUG(float dist, vec3 fragPos) {
  int mode = EE_RENDER_INFO.shadow_debug_parameters.x;
  if (mode <= 0) {
    return vec4(0.0f);
  }

  int cascadeIndex = EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_INDEX(dist);
  if (mode == 1) {
    vec3 cascadeColor = EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_COLOR(cascadeIndex);
    for (int boundaryIndex = 0; boundaryIndex < 3; boundaryIndex++) {
      float halfWidth = EE_FUNC_DIRECTIONAL_SHADOW_TRANSITION_HALF_WIDTH(boundaryIndex);
      if (halfWidth <= 0.0f)
        continue;

      float splitDistance = EE_FUNC_DIRECTIONAL_SHADOW_SPLIT_DISTANCE(boundaryIndex);
      if (dist < splitDistance - halfWidth || dist >= splitDistance + halfWidth)
        continue;

      float blend = smoothstep(splitDistance - halfWidth, splitDistance + halfWidth, dist);
      cascadeColor = mix(EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_COLOR(boundaryIndex),
                         EE_FUNC_DIRECTIONAL_SHADOW_CASCADE_COLOR(boundaryIndex + 1), blend);
      break;
    }
    cascadeColor = mix(vec3(0.02f), cascadeColor, EE_FUNC_DIRECTIONAL_SHADOW_DISTANCE_FADE(dist));
    return vec4(cascadeColor, 1.0f);
  }

  if (EE_RENDER_INFO.directional_light_size <= 0) {
    return vec4(1.0f, 0.0f, 1.0f, 1.0f);
  }

  int localLightIndex =
      clamp(EE_RENDER_INFO.shadow_debug_parameters.z, 0, max(EE_RENDER_INFO.directional_light_size - 1, 0));
  int lightIndex = EE_CAMERA_INDEX * MAX_DIRECTIONAL_LIGHT_SIZE + localLightIndex;
  DirectionalLight light = EE_DIRECTIONAL_LIGHTS[lightIndex];
  if (light.diffuse.w < 0.5f || light.viewport_x_size <= 0 || light.viewport_y_size <= 0) {
    return vec4(0.25f, 0.0f, 0.25f, 1.0f);
  }

  int splitIndex = clamp(EE_RENDER_INFO.shadow_debug_parameters.y, 0, 3);
  if (cascadeIndex != splitIndex) {
    return vec4(0.02f, 0.02f, 0.02f, 1.0f);
  }

  vec4 fragPosLightSpace = light.light_space_matrix[splitIndex] * vec4(fragPos, 1.0f);
  if (abs(fragPosLightSpace.w) < 0.000001f) {
    return vec4(1.0f, 0.0f, 0.0f, 1.0f);
  }

  vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
  vec2 lightUv = projCoords.xy * 0.5f + 0.5f;
  bool insideLightRect = all(greaterThanEqual(lightUv, vec2(0.0f))) && all(lessThanEqual(lightUv, vec2(1.0f))) &&
                         projCoords.z >= 0.0f && projCoords.z <= 1.0f;
  float insideScale = insideLightRect ? 1.0f : 0.25f;

  if (mode == 2) {
    return vec4(mix(vec3(0.75f, 0.0f, 0.0f), vec3(lightUv, 1.0f), insideScale), 1.0f);
  }
  if (mode == 3) {
    float lightDepth = clamp(projCoords.z, 0.0f, 1.0f);
    vec3 depthColor = vec3(lightDepth);
    if (!insideLightRect) {
      depthColor = mix(vec3(0.75f, 0.0f, 0.0f), depthColor, 0.25f);
    }
    return vec4(depthColor, 1.0f);
  }

  vec2 atlasSize = vec2(textureSize(EE_DIRECTIONAL_LIGHT_SM, 0).xy);
  vec2 viewportOffset = vec2(float(light.viewport_x_offset), float(light.viewport_y_offset));
  vec2 viewportSize = vec2(float(light.viewport_x_size), float(light.viewport_y_size));
  vec2 atlasUv = (lightUv * viewportSize + viewportOffset) / max(atlasSize, vec2(1.0f));
  if (mode == 4) {
    return vec4(mix(vec3(0.75f, 0.0f, 0.0f), vec3(atlasUv, 1.0f), insideScale), 1.0f);
  }

  vec2 worldUnitsPerTexelAxes = 2.0f *
                                vec2(light.light_frustum_width[splitIndex], light.light_frustum_height[splitIndex]) /
                                max(viewportSize, vec2(1.0f));
  float worldUnitsPerTexel = max(worldUnitsPerTexelAxes.x, worldUnitsPerTexelAxes.y);
  float density = clamp(log2(max(worldUnitsPerTexel, 0.001f)) * 0.125f + 0.5f, 0.0f, 1.0f);
  vec3 densityColor = mix(vec3(0.0f, 0.35f, 1.0f), vec3(1.0f, 0.1f, 0.0f), density);
  vec2 texelUv = fract(lightUv * viewportSize);
  float grid = texelUv.x < 0.04f || texelUv.y < 0.04f ? 1.0f : 0.0f;
  return vec4(mix(densityColor, vec3(1.0f), grid * 0.6f) * insideScale, 1.0f);
}

vec2 EE_FUNC_DIRECTIONAL_SHADOW_ATLAS_UV(DirectionalLight light, vec2 lightUv) {
  vec2 atlasSize = max(vec2(textureSize(EE_DIRECTIONAL_LIGHT_SM, 0).xy), vec2(1.0f));
  vec2 viewportSize = max(vec2(float(light.viewport_x_size), float(light.viewport_y_size)), vec2(1.0f));
  vec2 halfTexel = vec2(0.5f) / viewportSize;
  vec2 clampedLightUv = clamp(lightUv, halfTexel, vec2(1.0f) - halfTexel);
  return (vec2(float(light.viewport_x_offset), float(light.viewport_y_offset)) + clampedLightUv * viewportSize) /
         atlasSize;
}

float EE_FUNC_DIRECTIONAL_SHADOW_SAMPLE(DirectionalLight light, int splitIndex, vec2 lightUv, float receiverDepth) {
  vec2 viewportSize = max(vec2(float(light.viewport_x_size), float(light.viewport_y_size)), vec2(1.0f));
  vec2 halfTexel = vec2(0.5f) / viewportSize;
  if (any(lessThan(lightUv, halfTexel)) || any(greaterThan(lightUv, vec2(1.0f) - halfTexel))) {
    return 1.0f;
  }
  return texture(EE_DIRECTIONAL_LIGHT_SM,
                 vec4(EE_FUNC_DIRECTIONAL_SHADOW_ATLAS_UV(light, lightUv), splitIndex, receiverDepth));
}

float EE_FUNC_DIRECTIONAL_SHADOW_COMPARE(float receiverDepth, float closestDepth) {
  if (closestDepth <= 0.0f)
    return 1.0f;
  return receiverDepth < closestDepth ? 1.0f : 0.0f;
}

float EE_FUNC_DIRECTIONAL_SHADOW_HARD(DirectionalLight light, int splitIndex, vec3 projCoords) {
  return EE_FUNC_DIRECTIONAL_SHADOW_SAMPLE(light, splitIndex, projCoords.xy, projCoords.z);
}

float EE_FUNC_DIRECTIONAL_SHADOW_PCF(DirectionalLight light, int splitIndex, vec3 projCoords, vec2 radiusUv,
                                     int sampleAmount, vec3 randomSeed) {
  if (all(lessThanEqual(radiusUv, vec2(0.0f))) || sampleAmount <= 1) {
    return EE_FUNC_DIRECTIONAL_SHADOW_HARD(light, splitIndex, projCoords);
  }

  float shadow = 0.0f;
  for (int sampleIndex = 0; sampleIndex < sampleAmount; sampleIndex++) {
    vec2 texCoord = projCoords.xy + EE_VOGEL_DISK_SAMPLE(sampleIndex, sampleAmount, randomSeed) * radiusUv;
    shadow += EE_FUNC_DIRECTIONAL_SHADOW_SAMPLE(light, splitIndex, texCoord, projCoords.z);
  }
  return shadow / float(sampleAmount);
}

float EE_FUNC_DIRECTIONAL_LIGHT_SHADOW(int i, int splitIndex, vec3 fragPos, vec3 normal, float cameraFragDistance) {
  DirectionalLight light = EE_DIRECTIONAL_LIGHTS[i];
  vec3 lightDir = light.direction;
  float nDotL = max(dot(normal, -lightDir), 0.0f);
  vec2 viewportSize = max(vec2(float(light.viewport_x_size), float(light.viewport_y_size)), vec2(1.0f));
  vec2 halfExtent =
      max(vec2(light.light_frustum_width[splitIndex], light.light_frustum_height[splitIndex]), vec2(0.001f));
  vec2 worldUnitsPerTexel = 2.0f * halfExtent / viewportSize;
  float shadowTexelSize = max(worldUnitsPerTexel.x, worldUnitsPerTexel.y);
  float constantBias = light.reserved_parameters.z;
  float slopeBias = light.reserved_parameters.y * (1.0f - nDotL);
  float lightDepthSpan = max(2.0f * light.light_frustum_distance[splitIndex], 0.001f);
  float bias = (constantBias + slopeBias) * shadowTexelSize / lightDepthSpan;
  float normalOffset = light.reserved_parameters.w * shadowTexelSize;

  fragPos = fragPos + normal * normalOffset;
  vec4 fragPosLightSpace = light.light_space_matrix[splitIndex] * vec4(fragPos, 1.0f);
  vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
  if (projCoords.z < 0.0f || projCoords.z > 1.0f) {
    return 1.0f;
  }
  projCoords.x = projCoords.x * 0.5f + 0.5f;
  projCoords.y = projCoords.y * 0.5f + 0.5f;
  if (projCoords.x < 0.0f || projCoords.x > 1.0f || projCoords.y < 0.0f || projCoords.y > 1.0f) {
    return 1.0f;
  }
  projCoords = vec3(projCoords.xy, projCoords.z - bias);

  vec2 radiusUv = vec2(max(light.reserved_parameters.x, 0.0f)) / (2.0f * halfExtent);
  int sampleAmount = clamp(EE_RENDER_INFO.shadow_debug_parameters.w, 1, 64);
  return EE_FUNC_DIRECTIONAL_SHADOW_PCF(light, splitIndex, projCoords, radiusUv, sampleAmount, fragPos * 3141);
}

vec2 EE_FUNC_SHADOW_ATLAS_UV(vec2 lightUv, int viewportXOffset, int viewportYOffset, int viewportXSize,
                             int viewportYSize, vec2 atlasSize) {
  vec2 viewportSize = max(vec2(float(viewportXSize), float(viewportYSize)), vec2(1.0f));
  vec2 halfTexel = vec2(0.5f) / viewportSize;
  vec2 clampedLightUv = clamp(lightUv, halfTexel, vec2(1.0f) - halfTexel);
  return (vec2(float(viewportXOffset), float(viewportYOffset)) + clampedLightUv * viewportSize) /
         max(atlasSize, vec2(1.0f));
}

float EE_FUNC_SPOT_SHADOW_DEPTH(SpotLight light, vec2 lightUv) {
  return texture(EE_SPOT_LIGHT_SM, EE_FUNC_SHADOW_ATLAS_UV(lightUv, light.viewport_x_offset, light.viewport_y_offset,
                                                           light.viewport_x_size, light.viewport_y_size,
                                                           vec2(textureSize(EE_SPOT_LIGHT_SM, 0))))
      .r;
}

float EE_FUNC_POINT_SHADOW_DEPTH(PointLight light, int slice, vec2 lightUv) {
  return texture(EE_POINT_LIGHT_SM,
                 vec3(EE_FUNC_SHADOW_ATLAS_UV(lightUv, light.viewport_x_offset, light.viewport_y_offset,
                                              light.viewport_x_size, light.viewport_y_size,
                                              vec2(textureSize(EE_POINT_LIGHT_SM, 0).xy)),
                      slice))
      .r;
}

float EE_FUNC_SPOT_LIGHT_SHADOW(int i, vec3 fragPos, float cameraFragDistance) {
  SpotLight light = EE_SPOT_LIGHTS[i];
  vec4 fragPosLightSpace = light.light_space_matrix * vec4(fragPos, 1.0f);
  if (abs(fragPosLightSpace.w) < 0.000001f) {
    return 1.0f;
  }
  vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
  projCoords.z -= light.cutoff_outer_inner_size_bias.w;
  projCoords.x = projCoords.x * 0.5f + 0.5f;
  projCoords.y = projCoords.y * 0.5f + 0.5f;

  if (projCoords.z < 0.0f || projCoords.z > 1.0f || projCoords.x < 0.0f || projCoords.x > 1.0f || projCoords.y < 0.0f ||
      projCoords.y > 1.0f) {
    return 1.0f;
  }

  float radiusUv = max(light.cutoff_outer_inner_size_bias.z * 100.0f, 0.0f) / max(float(light.viewport_x_size), 1.0f);
  int sampleAmount = clamp(EE_RENDER_INFO.shadow_sample_size, 1, 64);
  if (radiusUv <= 0.0f || sampleAmount <= 1) {
    return EE_FUNC_DIRECTIONAL_SHADOW_COMPARE(projCoords.z, EE_FUNC_SPOT_SHADOW_DEPTH(light, projCoords.xy));
  }

  float shadow = 0.0f;
  for (int sampleIndex = 0; sampleIndex < sampleAmount; sampleIndex++) {
    vec2 texCoord = projCoords.xy + EE_VOGEL_DISK_SAMPLE(sampleIndex, sampleAmount, fragPos * 3141) * radiusUv;
    float closestDepth = EE_FUNC_SPOT_SHADOW_DEPTH(light, texCoord);
    shadow += EE_FUNC_DIRECTIONAL_SHADOW_COMPARE(projCoords.z, closestDepth);
  }
  return shadow / float(sampleAmount);
}

float EE_FUNC_POINT_LIGHT_SHADOW(int i, vec3 fragPos, float cameraFragDistance) {
  PointLight light = EE_POINT_LIGHTS[i];
  // get vector between fragment position and light position
  vec3 fragToLight = fragPos - light.position;
  float shadow = 0.0f;
  int slice = 0;
  if (abs(fragToLight.x) >= abs(fragToLight.y) && abs(fragToLight.x) >= abs(fragToLight.z)) {
    if (fragToLight.x > 0) {
      slice = 0;
    } else {
      slice = 1;
    }
  } else if (abs(fragToLight.y) >= abs(fragToLight.z)) {
    if (fragToLight.y > 0) {
      slice = 2;
    } else {
      slice = 3;
    }
  } else {
    if (fragToLight.z > 0) {
      slice = 4;
    } else {
      slice = 5;
    }
  }
  vec4 fragPosLightSpace = light.light_space_matrix[slice] * vec4(fragPos, 1.0f);
  if (abs(fragPosLightSpace.w) < 0.000001f) {
    return 1.0f;
  }
  vec3 projCoords = fragPosLightSpace.xyz / fragPosLightSpace.w;
  projCoords.z -= light.reserved_parameters.x;
  projCoords.x = projCoords.x * 0.5f + 0.5f;
  projCoords.y = projCoords.y * 0.5f + 0.5f;

  if (projCoords.z < 0.0f || projCoords.z > 1.0f || projCoords.x < 0.0f || projCoords.x > 1.0f || projCoords.y < 0.0f ||
      projCoords.y > 1.0f) {
    return 1.0f;
  }

  float radiusUv = max(light.reserved_parameters.y * 100.0f, 0.0f) / max(float(light.viewport_x_size), 1.0f);
  int sampleAmount = clamp(EE_RENDER_INFO.shadow_sample_size, 1, 64);
  if (radiusUv <= 0.0f || sampleAmount <= 1) {
    return EE_FUNC_DIRECTIONAL_SHADOW_COMPARE(projCoords.z, EE_FUNC_POINT_SHADOW_DEPTH(light, slice, projCoords.xy));
  }

  for (int sampleIndex = 0; sampleIndex < sampleAmount; sampleIndex++) {
    vec2 texCoord = projCoords.xy + EE_VOGEL_DISK_SAMPLE(sampleIndex, sampleAmount, fragPos * 3141) * radiusUv;
    float closestDepth = EE_FUNC_POINT_SHADOW_DEPTH(light, slice, texCoord);
    shadow += EE_FUNC_DIRECTIONAL_SHADOW_COMPARE(projCoords.z, closestDepth);
  }
  return shadow / float(sampleAmount);
}
