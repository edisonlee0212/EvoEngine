#ifndef EE_EMISSIVE_TRIANGLE_SAMPLING_SLANGH
#define EE_EMISSIVE_TRIANGLE_SAMPLING_SLANGH

#include "RayTracingMaterial.slangh"

const float EE_EMISSIVE_TRIANGLE_RAY_EPSILON = 1e-3f;
const float EE_EMISSIVE_TRIANGLE_PDF_EPSILON = 1e-6f;

struct EeEmissiveTriangleSample {
  vec3 position;
  float distance;
  vec3 direction;
  float solid_angle_pdf;
  vec3 radiance_over_pdf;
  uint instance_index;
  uint primitive_id;
  uint material_index;
};

uint EE_EMISSIVE_TRIANGLE_COUNT() {
  return EE_RENDER_INFO.emissive_triangle_parameters.x;
}

bool EE_FIND_EMISSIVE_TRIANGLE(const uint instance_index, const uint primitive_id,
                               out EmissiveTriangleInfo result) {
  const uint count = EE_EMISSIVE_TRIANGLE_COUNT();
  if (count == 0u) {
    return false;
  }
  uint low = 0u;
  uint high = count;
  for (int iteration = 0; iteration < 32 && low < high; ++iteration) {
    const uint mid = low + (high - low) / 2u;
    const EmissiveTriangleInfo candidate = EE_EMISSIVE_TRIANGLES[mid];
    if (candidate.instance_index < instance_index ||
        (candidate.instance_index == instance_index && candidate.primitive_id < primitive_id)) {
      low = mid + 1u;
    } else {
      high = mid;
    }
  }
  if (low >= count) {
    return false;
  }
  result = EE_EMISSIVE_TRIANGLES[low];
  return result.instance_index == instance_index && result.primitive_id == primitive_id;
}

EmissiveTriangleInfo EE_SAMPLE_EMISSIVE_TRIANGLE_RECORD(const float sample_value) {
  uint low = 0u;
  uint high = EE_EMISSIVE_TRIANGLE_COUNT() - 1u;
  for (int iteration = 0; iteration < 32 && low < high; ++iteration) {
    const uint mid = low + (high - low) / 2u;
    if (sample_value < EE_EMISSIVE_TRIANGLES[mid].cdf) {
      high = mid;
    } else {
      low = mid + 1u;
    }
  }
  return EE_EMISSIVE_TRIANGLES[low];
}

bool EE_SAMPLE_EMISSIVE_TRIANGLE(const vec3 shading_position, const float record_sample,
                                 const vec2 barycentric_sample, out EeEmissiveTriangleSample result) {
  result.position = shading_position;
  result.distance = 0.0f;
  result.direction = vec3(0.0f, 1.0f, 0.0f);
  result.solid_angle_pdf = 0.0f;
  result.radiance_over_pdf = vec3(0.0f);
  result.instance_index = 0u;
  result.primitive_id = 0u;
  result.material_index = 0u;
  if (EE_EMISSIVE_TRIANGLE_COUNT() == 0u) {
    return false;
  }

  const EmissiveTriangleInfo record = EE_SAMPLE_EMISSIVE_TRIANGLE_RECORD(record_sample);
  const Instance instance = EE_INSTANCES[record.instance_index];
  const int triangle_offset = instance.triangle_offset + int(record.primitive_id);
  const Vertex v0 = EE_VERTICES[EE_INDICES[triangle_offset * 3]];
  const Vertex v1 = EE_VERTICES[EE_INDICES[triangle_offset * 3 + 1]];
  const Vertex v2 = EE_VERTICES[EE_INDICES[triangle_offset * 3 + 2]];
  const float barycentric_sqrt = sqrt(clamp(barycentric_sample.x, 0.0f, 1.0f));
  const float barycentric_y = clamp(barycentric_sample.y, 0.0f, 1.0f);
  const vec3 barycentrics = vec3(1.0f - barycentric_sqrt,
                                 barycentric_sqrt * (1.0f - barycentric_y),
                                 barycentric_sqrt * barycentric_y);
  const vec3 p0 = vec3(instance.model * vec4(v0.position, 1.0f));
  const vec3 p1 = vec3(instance.model * vec4(v1.position, 1.0f));
  const vec3 p2 = vec3(instance.model * vec4(v2.position, 1.0f));
  const vec3 light_position = p0 * barycentrics.x + p1 * barycentrics.y + p2 * barycentrics.z;
  const vec3 to_light = light_position - shading_position;
  const float distance_squared = dot(to_light, to_light);
  if (distance_squared <= EE_EMISSIVE_TRIANGLE_RAY_EPSILON * EE_EMISSIVE_TRIANGLE_RAY_EPSILON) {
    return false;
  }

  const float distance = sqrt(distance_squared);
  const vec3 direction = to_light / distance;
  const vec3 object_shading_normal = EE_RT_SAFE_NORMALIZE(
      v0.normal * barycentrics.x + v1.normal * barycentrics.y + v2.normal * barycentrics.z,
      vec3(0.0f, 1.0f, 0.0f));
  const vec3 object_geometric_normal =
      EE_RT_GEOMETRIC_NORMAL(v1.position - v0.position, v2.position - v0.position, object_shading_normal);
  const vec3 light_geometric_normal =
      EE_RT_WORLD_NORMAL(instance.model, object_geometric_normal, vec3(0.0f, 1.0f, 0.0f));
  const uint material_index = uint(instance.material_index);
  const GltfShadeMaterial material = EE_GLTF_MATERIALS[material_index];
  const float light_cosine = material.double_sided != 0 ? abs(dot(light_geometric_normal, -direction))
                                                         : max(dot(light_geometric_normal, -direction), 0.0f);
  if (light_cosine <= EE_EMISSIVE_TRIANGLE_PDF_EPSILON) {
    return false;
  }

  const float solid_angle_pdf = record.area_pdf * distance_squared / light_cosine;
  if (solid_angle_pdf <= 0.0f || isnan(solid_angle_pdf) || isinf(solid_angle_pdf)) {
    return false;
  }
  const EeRayTracingSurfaceAttributes attributes =
      EE_RT_INTERPOLATE_SURFACE_ATTRIBUTES(v0, v1, v2, barycentrics, vec4(0.0f));
  if (!EE_GLTF_RASTER_ALPHA_MASK_PASSES_LOD0(
          material_index, attributes.tex_coords, attributes.vertex_color.a)) {
    return false;
  }
  const vec3 world_shading_normal =
      EE_RT_WORLD_NORMAL(instance.model, attributes.normal, light_geometric_normal);
  const vec3 world_tangent = EE_RT_WORLD_TANGENT(instance.model, attributes.tangent, world_shading_normal);
  const float tangent_handedness =
      EE_RT_WORLD_TANGENT_HANDEDNESS(attributes.tangent_handedness, instance.model);
  const float facing_sign = dot(light_geometric_normal, -direction) >= 0.0f ? 1.0f : -1.0f;
  const vec3 facing_geometric_normal = facing_sign * light_geometric_normal;
  vec3 facing_shading_normal = facing_sign * world_shading_normal;
  vec3 facing_tangent = facing_sign * world_tangent;
  if (dot(facing_shading_normal, facing_geometric_normal) < 0.0f) {
    facing_shading_normal = -facing_shading_normal;
    facing_tangent = -facing_tangent;
  }
  if (dot(reflect(direction, facing_shading_normal), facing_geometric_normal) < 0.0f) {
    facing_shading_normal = facing_geometric_normal;
    facing_tangent = EE_RT_SAFE_NORMALIZE(
        facing_tangent - facing_shading_normal * dot(facing_tangent, facing_shading_normal),
        EE_GLTF_FALLBACK_TANGENT(facing_shading_normal));
  }
  const vec3 radiance = EE_RT_COATED_EMISSION_LOD0(
      material_index, attributes.tex_coords, facing_sign * facing_shading_normal,
      facing_sign * facing_tangent, tangent_handedness, facing_sign, facing_geometric_normal, -direction);
  if (any(isnan(radiance)) || any(isinf(radiance))) {
    return false;
  }
  const vec3 radiance_over_pdf = max(radiance, vec3(0.0f)) / solid_angle_pdf;
  if (any(isnan(radiance_over_pdf)) || any(isinf(radiance_over_pdf))) {
    return false;
  }

  result.position = light_position;
  result.distance = distance;
  result.direction = direction;
  result.solid_angle_pdf = solid_angle_pdf;
  result.radiance_over_pdf = radiance_over_pdf;
  result.instance_index = record.instance_index;
  result.primitive_id = record.primitive_id;
  result.material_index = material_index;
  return true;
}

float EE_EMISSIVE_TRIANGLE_HIT_PDF(const EmissiveTriangleInfo record, const vec3 previous_position,
                                   const vec3 hit_position, const vec3 hit_geometric_normal) {
  const vec3 to_hit = hit_position - previous_position;
  const float distance_squared = dot(to_hit, to_hit);
  if (distance_squared <= EE_EMISSIVE_TRIANGLE_RAY_EPSILON * EE_EMISSIVE_TRIANGLE_RAY_EPSILON) {
    return 0.0f;
  }
  const float light_cosine = abs(dot(EE_RT_SAFE_NORMALIZE(hit_geometric_normal, vec3(0.0f, 1.0f, 0.0f)),
                                     -to_hit * inversesqrt(distance_squared)));
  if (light_cosine <= EE_EMISSIVE_TRIANGLE_PDF_EPSILON) {
    return 0.0f;
  }
  return record.area_pdf * distance_squared / light_cosine;
}

#endif
