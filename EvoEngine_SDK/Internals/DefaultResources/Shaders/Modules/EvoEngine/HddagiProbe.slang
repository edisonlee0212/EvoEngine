float3 HddagiOctDecode(float2 f) {
  f = f * 2 - 1;
  float3 n = float3(f, 1 - abs(f.x) - abs(f.y));
  float t = saturate(-n.z);
  n.xy += select(n.xy >= 0, float2(-t), float2(t));
  return normalize(n);
}
uint3 HddagiHash(uint3 x) {
  x = ((x >> 16) ^ x) * 0x45d9f3bu;
  x = ((x >> 16) ^ x) * 0x45d9f3bu;
  return (x >> 16) ^ x;
}
uint3 HddagiDecodeFixed(uint packed) {
  uint3 rgb = uint3(packed, packed >> 9, packed >> 18) & 511;
  int shift = int(packed >> 27) - 10;
  return shift >= 0 ? rgb << uint(shift) : rgb >> uint(-shift);
}
