{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "x64-Debug",
      "displayName": "Ninja x64 Debug",
      "description": "Configure EvoEngine with Ninja. Requires a VSCode Visual Studio kit or an activated MSVC developer environment.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/x64-Debug",
      "installDir": "${sourceDir}/out/install/x64-Debug",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64-Release",
      "displayName": "Ninja x64 Release",
      "description": "Configure EvoEngine with Ninja. Requires a VSCode Visual Studio kit or an activated MSVC developer environment.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/x64-Release",
      "installDir": "${sourceDir}/out/install/x64-Release",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MAKE_PROGRAM": "C:/Program Files/Microsoft Visual Studio/18/Community/Common7/IDE/CommonExtensions/Microsoft/CMake/Ninja/ninja.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2026-x64-Debug",
      "displayName": "Visual Studio 2026 x64 Debug",
      "description": "Configure EvoEngine with the Visual Studio generator. This avoids needing Ninja or a preloaded MSVC shell.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/vs2026-x64",
      "installDir": "${sourceDir}/out/install/vs2026-x64",
      "architecture": {
        "value": "x64"
      },
      "toolset": {
        "value": "host=x64"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/vs2026-x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "vs2026-x64-Release",
      "displayName": "Visual Studio 2026 x64 Release",
      "description": "Configure EvoEngine with the Visual Studio generator. This avoids needing Ninja or a preloaded MSVC shell.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/vs2026-x64",
      "installDir": "${sourceDir}/out/install/vs2026-x64",
      "architecture": {
        "value": "x64"
      },
      "toolset": {
        "value": "host=x64"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/vs2026-x64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-Debug",
      "displayName": "Build all Debug targets",
      "configurePreset": "x64-Debug"
    },
    {
      "name": "x64-Release",
      "displayName": "Build all Release targets",
      "configurePreset": "x64-Release"
    },
    {
      "name": "DemoApp-Debug",
      "displayName": "Build DemoApp Debug",
      "configurePreset": "x64-Debug",
      "targets": [
        "DemoApp"
      ]
    },
    {
      "name": "DemoApp-Release",
      "displayName": "Build DemoApp Release",
      "configurePreset": "x64-Release",
      "targets": [
        "DemoApp"
      ]
    },
    {
      "name": "EcoSysLabApp-Debug",
      "displayName": "Build EcoSysLabApp Debug",
      "configurePreset": "x64-Debug",
      "targets": [
        "EcoSysLabApp"
      ]
    },
    {
      "name": "EcoSysLabApp-Release",
      "displayName": "Build EcoSysLabApp Release",
      "configurePreset": "x64-Release",
      "targets": [
        "EcoSysLabApp"
      ]
    },
    {
      "name": "DigitalAgricultureApp-Debug",
      "displayName": "Build DigitalAgricultureApp Debug",
      "configurePreset": "x64-Debug",
      "targets": [
        "DigitalAgricultureApp"
      ]
    },
    {
      "name": "DigitalAgricultureApp-Release",
      "displayName": "Build DigitalAgricultureApp Release",
      "configurePreset": "x64-Release",
      "targets": [
        "DigitalAgricultureApp"
      ]
    },
    {
      "name": "EmptyApp-Debug",
      "displayName": "Build EmptyApp Debug",
      "configurePreset": "x64-Debug",
      "targets": [
        "EmptyApp"
      ]
    },
    {
      "name": "EmptyApp-Release",
      "displayName": "Build EmptyApp Release",
      "configurePreset": "x64-Release",
      "targets": [
        "EmptyApp"
      ]
    },
    {
      "name": "install-x64-Debug",
      "displayName": "Install Debug runtime",
      "configurePreset": "x64-Debug",
      "targets": [
        "install"
      ]
    },
    {
      "name": "install-x64-Release",
      "displayName": "Install Release runtime",
      "configurePreset": "x64-Release",
      "targets": [
        "install"
      ]
    },
    {
      "name": "vs2026-x64-Debug",
      "displayName": "Build all Visual Studio Debug targets",
      "configurePreset": "vs2026-x64-Debug",
      "configuration": "Debug"
    },
    {
      "name": "vs2026-x64-Release",
      "displayName": "Build all Visual Studio Release targets",
      "configurePreset": "vs2026-x64-Release",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "install-vs2026-x64-Debug",
      "displayName": "Install Visual Studio Debug runtime",
      "configurePreset": "vs2026-x64-Debug",
      "configuration": "Debug",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "install-vs2026-x64-Release",
      "displayName": "Install Visual Studio Release runtime",
      "configurePreset": "vs2026-x64-Release",
      "configuration": "RelWithDebInfo",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "EmptyApp-vs2026-x64-Debug",
      "displayName": "Build EmptyApp Visual Studio Debug",
      "configurePreset": "vs2026-x64-Debug",
      "configuration": "Debug",
      "targets": [
        "EmptyApp"
      ]
    },
    {
      "name": "EmptyApp-vs2026-x64-Release",
      "displayName": "Build EmptyApp Visual Studio Release",
      "configurePreset": "vs2026-x64-Release",
      "configuration": "RelWithDebInfo",
      "targets": [
        "EmptyApp"
      ]
    }
  ],
  "workflowPresets": [
    {
      "name": "deploy-x64-Debug",
      "displayName": "Configure, build, and install Debug runtime",
      "steps": [
        {
          "type": "configure",
          "name": "x64-Debug"
        },
        {
          "type": "build",
          "name": "x64-Debug"
        },
        {
          "type": "build",
          "name": "install-x64-Debug"
        }
      ]
    },
    {
      "name": "deploy-x64-Release",
      "displayName": "Configure, build, and install Release runtime",
      "steps": [
        {
          "type": "configure",
          "name": "x64-Release"
        },
        {
          "type": "build",
          "name": "x64-Release"
        },
        {
          "type": "build",
          "name": "install-x64-Release"
        }
      ]
    },
    {
      "name": "deploy-vs2026-x64-Release",
      "displayName": "Configure, build, and install Visual Studio Release runtime",
      "steps": [
        {
          "type": "configure",
          "name": "vs2026-x64-Release"
        },
        {
          "type": "build",
          "name": "vs2026-x64-Release"
        },
        {
          "type": "build",
          "name": "install-vs2026-x64-Release"
        }
      ]
    }
  ]
}
