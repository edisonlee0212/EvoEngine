{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "description": "Configure EvoEngine with the Visual Studio generator. This avoids needing Ninja or a preloaded MSVC shell.",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/vs2026-x64",
      "installDir": "${sourceDir}/out/install/vs2026-x64",
      "architecture": {
        "value": "x64"
      },
      "toolset": {
        "value": "host=x64"
      },
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/vs2026-x64",
        "EVOENGINE_ENABLE_NRD": "ON",
        "EVOENGINE_NRD_SOURCE_DIR": "${sourceDir}/Extern/3rdParty/NRD/NRD",
        "EVOENGINE_ENABLE_BillboardClouds_PACKAGE": "ON",
        "EVOENGINE_ENABLE_MeshRepair_PACKAGE": "ON",
        "EVOENGINE_ENABLE_TextureBaking_PACKAGE": "ON",
        "EVOENGINE_ENABLE_Universe_PACKAGE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "architecture": {
        "value": "x64"
      },
      "displayName": "Zach QSM headless (Windows x64)",
      "binaryDir": "${sourceDir}/out/build-zach-headless",
      "generator": "Visual Studio 18 2026",
      "toolset": {
        "value": "host=x64"
      },
      "installDir": "${sourceDir}/out/install/zach-headless",
      "cacheVariables": {
        "EVOENGINE_WITH_EDITOR": "OFF",
        "EVOENGINE_ENABLE_BillboardClouds_PACKAGE": "ON",
        "BUILD_TESTING": "OFF",
        "EVOENGINE_ENABLE_LSystem_PACKAGE": "OFF",
        "EVOENGINE_ENABLE_Universe_PACKAGE": "OFF",
        "EVOENGINE_ENABLE_PhysXPhysics_SERVICE": "OFF",
        "EVOENGINE_ENABLE_DatasetGeneration_PACKAGE": "OFF",
        "EVOENGINE_ENABLE_MeshRepair_PACKAGE": "OFF",
        "EVOENGINE_ENABLE_DigitalAgriculture_PACKAGE": "OFF",
        "EVOENGINE_INSTALL_PDBS": "OFF",
        "EvoEngine_App-ZachQSMTreeDatasetGenerator": "ON",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/zach-headless",
        "EVOENGINE_ENABLE_NRD": "OFF",
        "EVOENGINE_ENABLE_EcoSysLab_PACKAGE": "ON",
        "EVOENGINE_ENABLE_TextureBaking_PACKAGE": "OFF"
      },
      "name": "zach-headless"
    }
  ],
  "buildPresets": [
    {
      "name": "install-vs2026-x64-Debug",
      "displayName": "x64-Debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "install-vs2026-x64-RelWithDebInfo",
      "displayName": "x64-RelWithDebInfo",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "name": "install-vs2026-x64-Release",
      "displayName": "x64-Release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": [
        "INSTALL"
      ]
    },
    {
      "configuration": "Release",
      "configurePreset": "zach-headless",
      "name": "install-zach-headless-Release",
      "targets": [
        "INSTALL"
      ]
    }
  ]
}
